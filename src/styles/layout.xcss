* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: transparent;
}

.app-shell {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: 222px minmax(0, 1fr);
  background: transparent;
  overflow: hidden;
  transition: grid-template-columns 160ms var(--base-transition);

  &.sidebar-collapsed {
    grid-template-columns: 58px minmax(0, 1fr);
  }

  &.settings-active {
    grid-template-columns: minmax(0, 1fr);
  }

  &.platform-win32, &.platform-darwin {
    background: var(--surface-shell);
  }

  &.platform-linux {
    background: radial-gradient(circle at 56% 92%, var(--glow-pink), transparent 24%),
      linear-gradient(135deg, var(--color-page-start), var(--color-page-end));
  }

  @media (max-width: 700px) {
    grid-template-columns: 58px minmax(0, 1fr);
  }
}
