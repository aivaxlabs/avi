* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: transparent;
}

.app-shell {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: var(--sidebar-width, 222px) 0 minmax(0, 1fr);
  background: transparent;
  overflow: hidden;
  transition: grid-template-columns 160ms var(--base-transition);

  &.sidebar-collapsed {
    grid-template-columns: 58px minmax(0, 1fr);
  }

  &.settings-active {
    grid-template-columns: minmax(0, 1fr);
  }

  &.platform-win32,
  &.platform-darwin {
    background: var(--background-1);
  }

  &.platform-linux {
    background: radial-gradient(circle at 56% 92%, var(--background-4), transparent 24%),
      linear-gradient(135deg, var(--background-1), var(--background-2));
  }

  @media (max-width: 700px) {
    grid-template-columns: 58px minmax(0, 1fr);
  }
}

.panel-resizer {
  position: relative;
  z-index: 70;
  width: 9px;
  height: 100%;
  justify-self: center;
  cursor: col-resize;
  touch-action: none;
  -webkit-app-region: no-drag;

  &::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 4px;
    width: 1px;
    background: transparent;
    transition: background 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition);
  }

  &:hover::before,
  &:focus-visible::before,
  &.dragging::before {
    background: var(--text-3);
    box-shadow: 0 0 0 1px var(--background-3);
  }

  &:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: -3px;
  }
}

body {
  border-top: 1px solid --border-color;
}

body.panel-resizing {
  cursor: col-resize;
  user-select: none;

  .app-shell {
    transition: none;
  }

  * {
    cursor: col-resize !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .panel-resizer::before {
    transition: none;
  }
}