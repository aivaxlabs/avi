* {
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  height: 100%;
  margin: 0;
  overflow: hidden;
  background: transparent;
}

.app-shell {
  width: 100%;
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: var(--sidebar-width, 222px) 0 minmax(0, 1fr);
  background: transparent;
  overflow: hidden;
  transition: grid-template-columns 160ms --base-transition;

  &.sidebar-collapsed {
    grid-template-columns: 58px minmax(0, 1fr);
  }

  &.settings-active {
    grid-template-columns: minmax(0, 1fr);
  }

  &.platform-win32,
  &.platform-darwin {
    background: --background-1;
  }

  :root[data-transparency-mode="transparent"] & {
    background: transparent;
  }

  &.platform-linux {
    background: radial-gradient(circle at 56% 92%, --background-4, transparent 24%),
      linear-gradient(135deg, --background-1, --background-2);
  }

  @media (max-width: 700px) {
    grid-template-columns: 58px minmax(0, 1fr);
  }
}

.panel-resizer {
  position: relative;
  z-index: 70;
  width: 9px;
  height: 100%;
  justify-self: center;
  cursor: col-resize;
  touch-action: none;
  -webkit-app-region: no-drag;

  &::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 4px;
    width: 1px;
    background: transparent;
    transition: background 180ms --base-transition,
      box-shadow 180ms --base-transition;
  }

  &:hover::before,
  &:focus-visible::before,
  &.dragging::before {
    background: --primary-color;
    box-shadow: 0 0 0 2px --primary-color-opaque;
  }

  &:focus-visible {
    outline: 2px solid --primary-color;
    outline-offset: -3px;
  }
}

html[data-transparency-mode="opaque"] {
  body {
    border-top: 1px solid --border-color;
  }
}

html[data-transparency-mode="transparent"] {
  .chat-workspace {
    position: relative;
    border-top-left-radius: 10px;
    filter: drop-shadow(-1px -1px 1px #00000011);
    top: 2px;
    height: calc(100% - 2px);
  }
}

body.panel-resizing {
  cursor: col-resize;
  user-select: none;

  .app-shell {
    transition: none;
  }

  * {
    cursor: col-resize !important;
  }
}

.nav-actions button,
.settings-button,
.dialog-footer button,
.code-block-header button,
.continuations button,
.project-picker,
.model-pill,
.recording-bar button.primary-mini,
.settings-back,
.settings-navigation button,
.settings-inline-back,
.settings-add-provider,
.settings-provider-empty .primary-mini,
.settings-actions .primary-mini,
.models-editor-header button {
  border-radius: 9999px;
  padding: 4px 10px;
}

@media (prefers-reduced-motion: reduce) {
  .panel-resizer::before {
    transition: none;
  }
}