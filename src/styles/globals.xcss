:root {
  color-scheme: light;
  --font-ui: "Segoe UI", system-ui, sans-serif;
  --font-code: ui-monospace, "Cascadia Code", Consolas, monospace;
  --base-transition: cubic-bezier(0.075, 0.82, 0.165, 1);
  --duration-fast: 250ms;
  --duration-medium: 350ms;
  --duration-slow: 400ms;
  --ease-smooth-out: cubic-bezier(0.22, 1, 0.36, 1);
  --distance-base: 8px;
  --scale-large: .96;
  --scale-medium: .97;
  --item-hover: var(--background-3);
  --item-active: var(--background-4);
  --border-color: var(--background-4);
  --link-color: var(--primary-color);
  --git-untracked-status-color: var(--success-color);
  --git-modified-status-color: var(--warn-color);
  --git-conflict-status-color: var(--danger-color);
  font-family: var(--font-ui);
  font-size: 14px;
  color: var(--text-1);
  background: transparent;

  &[data-color-scheme="dark"] {
    color-scheme: dark;
  }
}

::selection {
  background: var(--highlight-color);
}

mark {
  color: inherit;
  background: var(--highlight-color);
}
