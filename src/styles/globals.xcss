@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
  font-family: "Segoe UI", system-ui, sans-serif;
  font-size: 14px;
  color: var(--color-text);
  background: transparent;
  --base-transition: cubic-bezier(0.075, 0.82, 0.165, 1);
  --color-text: #191919;
  --color-on-accent: #f7f7f7;
  --color-text-strong: #0f0f0f;
  --color-primary-fill: #171717;
  --color-primary-text: #f7f7f7;
  --color-primary-hover: #2b2b2b;
  --color-text-heading: #1c1c1c;
  --color-text-primary: #2a2a2a;
  --color-text-continuation: #333333;
  --color-text-secondary: #383838;
  --color-text-tertiary: #404040;
  --color-text-soft: #494949;
  --color-icon: #505050;
  --color-control: #555555;
  --color-control-secondary: #5c5c5c;
  --color-muted: #626262;
  --color-muted-alt: #686868;
  --color-menu-icon: #6b6b6b;
  --color-muted-warm: #6e6e6e;
  --color-muted-strong: #727272;
  --color-muted-icon: #787878;
  --color-muted-light: #898989;
  --color-muted-worked: #8f8f8f;
  --color-placeholder: #969696;
  --color-disabled: #a0a0a0;
  --color-disabled-soft: #adadad;
  --color-disabled-icon: #b8b8b8;
  --color-drop-text: #242424;
  --color-danger: #292929;
  --color-danger-strong: #171717;
  --color-danger-hover: #050505;
  --color-recording: #333333;
  --color-warning: #4a4a4a;
  --color-live: #252525;
  --color-brand-blue: #202020;
  --color-brand-pink: #444444;
  --color-page-start: #fafafa;
  --color-page-end: #f0f0f0;
  --color-code-text: #f5f5f5;
  --color-avatar-fallback: #e5e5e5;
  --color-divider-subtle: #e9e9e9;
  --color-divider: #f0f0f0;
  --surface-clear: rgba(255, 255, 255, 0);
  --surface-shell: rgba(255, 255, 255, 0.02);
  --surface-titlebar: rgba(255, 255, 255, 0.34);
  --surface-hover-strong: rgba(230, 230, 230, 0.55);
  --surface-control: rgba(255, 255, 255, 0.56);
  --surface-chip: rgba(255, 255, 255, 0.64);
  --surface-hover: rgba(240, 240, 240, 0.7);
  --surface-panel-soft: rgba(255, 255, 255, 0.92);
  --surface-sidebar: rgba(255, 255, 255, 0.74);
  --surface-input: rgba(255, 255, 255, 0.78);
  --surface-overlay-card: rgba(255, 255, 255, 0.86);
  --surface-dialog: rgba(255, 255, 255, 0.9);
  --surface-dialog-border: rgba(255, 255, 255, 0.92);
  --surface-popover: rgba(255, 255, 255, 0.94);
  --surface-menu: rgba(255, 255, 255, 0.96);
  --surface-menu-solid: rgba(255, 255, 255, 0.98);
  --surface-solid: rgba(255, 255, 255, 1);
  --surface-neutral-hover: #0000000b;
  --surface-subtle-hover: #00000004;
  --border-subtle-button: #00000014;
  --surface-slate-faint: rgba(248, 248, 248, 0.72);
  --surface-drop: rgba(246, 246, 246, 0.68);
  --surface-muted: rgba(239, 239, 239, 0.68);
  --surface-muted-strong: rgba(235, 235, 235, 0.74);
  --surface-muted-solid: rgba(232, 232, 232, 0.8);
  --surface-user-bubble: rgba(0, 0, 0, 0.04);
  --surface-accent-soft: rgba(0, 0, 0, 0.055);
  --surface-capability: rgba(0, 0, 0, 0.07);
  --surface-danger-soft: rgba(0, 0, 0, 0.09);
  --surface-warning-soft: rgba(0, 0, 0, 0.065);
  --surface-composer-fade: rgba(247, 247, 247, 0.82);
  --surface-composer-fade-end: rgba(247, 247, 247, 0);
  --surface-code-inline: rgba(0, 0, 0, 0.08);
  --surface-code-block: rgba(24, 24, 24, 0.94);
  --surface-code-block-soft: #f5f5f5;
  --surface-code-header: #ececec;
  --scrollbar-thumb: rgba(0, 0, 0, 0.3);
  --scrollbar-thumb-hover: rgba(0, 0, 0, 0.48);
  --color-code-block-text: #303030;
  --color-code-muted: #666666;
  --color-code-token-comment: #7a7a7a;
  --color-code-token-punctuation: #696969;
  --color-code-token-property: #343434;
  --color-code-token-selector: #3d3d3d;
  --color-code-token-operator: #202020;
  --color-code-token-keyword: #292929;
  --color-code-token-function: #383838;
  --color-code-token-string: #494949;
  --color-code-token-number: #252525;
  --color-code-token-class: #404040;
  --composer-input: rgb(247, 247, 247);
  --composer-input-border: rgb(238, 238, 238);
  --surface-backdrop: rgba(0, 0, 0, 0.18);
  --border-hairline: rgba(0, 0, 0, 0.14);
  --border-control: rgba(0, 0, 0, 0.13);
  --border-panel: rgba(0, 0, 0, 0.14);
  --border-panel-strong: rgba(0, 0, 0, 0.3);
  --border-input: rgba(0, 0, 0, 0.2);
  --border-bubble: rgba(0, 0, 0, 0.2);
  --border-drop: rgba(0, 0, 0, 0.3);
  --border-accent: rgba(0, 0, 0, 0.6);
  --shadow-soft: rgba(0, 0, 0, 0.04);
  --shadow-menu: rgba(0, 0, 0, 0.14);
  --shadow-popover: rgba(0, 0, 0, 0.18);
  --shadow-dialog: rgba(0, 0, 0, 0.11);
  --shadow-brand: rgba(0, 0, 0, 0.14);
  --shadow-brand-strong: rgba(0, 0, 0, 0.2);
  --shadow-blue: rgba(0, 0, 0, 0.08);
  --glow-live: rgba(0, 0, 0, 0.14);
  --glow-pink-soft: rgba(0, 0, 0, 0.08);
  --glow-pink: rgba(0, 0, 0, 0.1);

  @media (prefers-color-scheme: dark) {
    color-scheme: dark;
    --color-text: #ededed;
    --color-on-accent: #111111;
    --color-text-strong: #fafafa;
    --color-primary-fill: #f3f3f3;
    --color-primary-text: #111111;
    --color-primary-hover: #d9d9d9;
    --color-text-heading: #f0f0f0;
    --color-text-primary: #dddddd;
    --color-text-continuation: #d3d3d3;
    --color-text-secondary: #cccccc;
    --color-text-tertiary: #c5c5c5;
    --color-text-soft: #bbbbbb;
    --color-icon: #c2c2c2;
    --color-control: #b8b8b8;
    --color-control-secondary: #b0b0b0;
    --color-muted: #a6a6a6;
    --color-muted-alt: #aaaaaa;
    --color-menu-icon: #b2b2b2;
    --color-muted-warm: #a2a2a2;
    --color-muted-strong: #aaaaaa;
    --color-muted-icon: #adadad;
    --color-muted-light: #969696;
    --color-muted-worked: #a8a8a8;
    --color-placeholder: #8c8c8c;
    --color-disabled: #787878;
    --color-disabled-soft: #828282;
    --color-disabled-icon: #737373;
    --color-drop-text: #e5e5e5;
    --color-danger: #f0f0f0;
    --color-danger-strong: #ffffff;
    --color-danger-hover: #ffffff;
    --color-recording: #d8d8d8;
    --color-warning: #c6c6c6;
    --color-live: #e0e0e0;
    --color-brand-blue: #f2f2f2;
    --color-brand-pink: #bcbcbc;
    --color-page-start: #181818;
    --color-page-end: #101010;
    --color-code-text: #f5f5f5;
    --color-avatar-fallback: #2b2b2b;
    --color-divider-subtle: rgba(255, 255, 255, 0.14);
    --color-divider: rgba(255, 255, 255, 0.12);
    --surface-clear: rgba(18, 18, 18, 0);
    --surface-shell: rgba(24, 24, 24, 0.14);
    --surface-titlebar: rgba(24, 24, 24, 0.58);
    --surface-hover-strong: rgba(255, 255, 255, 0.12);
    --surface-control: rgba(38, 38, 38, 0.7);
    --surface-chip: rgba(38, 38, 38, 0.72);
    --surface-hover: rgba(255, 255, 255, 0.14);
    --surface-panel-soft: rgba(24, 24, 24, 0.82);
    --surface-sidebar: rgba(24, 24, 24, 0.78);
    --surface-input: rgba(32, 32, 32, 0.76);
    --surface-overlay-card: rgba(32, 32, 32, 0.9);
    --surface-dialog: rgba(34, 34, 34, 0.96);
    --surface-dialog-border: rgba(255, 255, 255, 0.11);
    --surface-popover: rgba(24, 24, 24, 0.97);
    --surface-menu: rgba(24, 24, 24, 0.98);
    --surface-menu-solid: rgba(24, 24, 24, 0.99);
    --surface-solid: rgba(18, 18, 18, 1);
    --surface-neutral-hover: rgba(255, 255, 255, 0.1);
    --surface-subtle-hover: rgba(255, 255, 255, 0.06);
    --border-subtle-button: rgba(255, 255, 255, 0.1);
    --surface-slate-faint: rgba(32, 32, 32, 0.72);
    --surface-drop: rgba(32, 32, 32, 0.76);
    --surface-muted: rgba(38, 38, 38, 0.74);
    --surface-muted-strong: rgba(38, 38, 38, 0.8);
    --surface-muted-solid: rgba(38, 38, 38, 0.88);
    --surface-user-bubble: rgba(255, 255, 255, 0.09);
    --surface-accent-soft: rgba(255, 255, 255, 0.12);
    --surface-capability: rgba(48, 48, 48, 0.74);
    --surface-danger-soft: rgba(255, 255, 255, 0.14);
    --surface-warning-soft: rgba(255, 255, 255, 0.1);
    --surface-composer-fade: rgba(18, 18, 18, 0.92);
    --surface-composer-fade-end: rgba(18, 18, 18, 0);
    --surface-code-inline: rgba(255, 255, 255, 0.14);
    --surface-code-block: rgba(10, 10, 10, 0.94);
    --surface-code-block-soft: #171717;
    --surface-code-header: #222222;
    --scrollbar-thumb: rgba(255, 255, 255, 0.26);
    --scrollbar-thumb-hover: rgba(255, 255, 255, 0.42);
    --color-code-block-text: #dddddd;
    --color-code-muted: #a0a0a0;
    --color-code-token-comment: #858585;
    --color-code-token-punctuation: #b0b0b0;
    --color-code-token-property: #dedede;
    --color-code-token-selector: #cfcfcf;
    --color-code-token-operator: #f0f0f0;
    --color-code-token-keyword: #c5c5c5;
    --color-code-token-function: #d7d7d7;
    --color-code-token-string: #bdbdbd;
    --color-code-token-number: #e5e5e5;
    --color-code-token-class: #cecece;
    --composer-input: rgba(34, 34, 34, 0.96);
    --composer-input-border: rgba(255, 255, 255, 0.13);
    --surface-backdrop: rgba(0, 0, 0, 0.58);
    --border-hairline: rgba(255, 255, 255, 0.11);
    --border-control: rgba(255, 255, 255, 0.14);
    --border-panel: rgba(255, 255, 255, 0.15);
    --border-panel-strong: rgba(255, 255, 255, 0.25);
    --border-input: rgba(255, 255, 255, 0.23);
    --border-bubble: rgba(255, 255, 255, 0.18);
    --border-drop: rgba(255, 255, 255, 0.28);
    --border-accent: rgba(255, 255, 255, 0.62);
    --shadow-soft: rgba(0, 0, 0, 0.28);
    --shadow-menu: rgba(0, 0, 0, 0.34);
    --shadow-popover: rgba(0, 0, 0, 0.38);
    --shadow-dialog: rgba(0, 0, 0, 0.42);
    --shadow-brand: rgba(0, 0, 0, 0.2);
    --shadow-brand-strong: rgba(0, 0, 0, 0.28);
    --shadow-blue: rgba(0, 0, 0, 0.18);
    --glow-live: rgba(255, 255, 255, 0.14);
    --glow-pink-soft: rgba(255, 255, 255, 0.06);
    --glow-pink: rgba(255, 255, 255, 0.08)
      ;
  }
}
