:root {
  color-scheme: light;
  font-family: "Segoe UI", system-ui, sans-serif;
  font-size: 14px;
  color: var(--text-1);
  background: transparent;
  --base-transition: cubic-bezier(0.075, 0.82, 0.165, 1);
  --text-1: #171717;
  --text-2: #404040;
  --text-3: #686868;
  --text-4: #969696;
  --text-5: #f7f7f7;
  --background-1: #fafafa;
  --background-2: #f5f5f5;
  --background-3: #eeeeee;
  --background-4: #e5e5e5;
  --background-5: #171717;
  --item-hover: var(--background-3);
  --item-active: var(--background-4);
  --border-color: var(--background-4);
  --link-color: #0969da;
  --highlight-color: #fff1a8;
  --git-untracked-status-color: #18794e;
  --git-modified-status-color: #9a6700;
  --git-conflict-status-color: #c43c3c;
  --git-ignored-status-color: #727272;

  @media (prefers-color-scheme: dark) {
    color-scheme: dark;
    --text-1: #f3f3f3;
    --text-2: #c5c5c5;
    --text-3: #a6a6a6;
    --text-4: #787878;
    --text-5: #111111;
    --background-1: #0d0d0d;
    --background-2: #121212;
    --background-3: #191919;
    --background-4: #232323;
    --background-5: #f3f3f3;
    --link-color: #81cfff;
    --highlight-color: #665c00;
    --git-untracked-status-color: #55b985;
    --git-modified-status-color: #d5a64a;
    --git-conflict-status-color: #ef7373;
    --git-ignored-status-color: #787878;
  }
}

::selection {
  background: --highlight-color;
}

mark {
  color: inherit;
  background: --highlight-color;
}