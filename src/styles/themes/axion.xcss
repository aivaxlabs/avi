[data-theme="axion"] {
  --primary-color: #b97900;
  --primary-color-opaque: #b9790022;
  --text-1: #171717;
  --text-2: #404040;
  --text-3: #686868;
  --text-4: #969696;
  --text-5: #f7f7f7;
  --background-0: #ffffff;
  --background-1: #fafafa;
  --background-2: #f5f5f5;
  --background-3: #eeeeee;
  --background-4: #e5e5e5;
  --background-5: #171717;
  --highlight-color: #fff1a8;
  --success-color: #18794e;
  --warn-color: #9a6700;
  --danger-color: #c43c3c;
  --git-ignored-status-color: #727272;
  --prism-comment: #656d76;
  --prism-punctuation: #57606a;
  --prism-property: #953800;
  --prism-selector: #116329;
  --prism-operator: #cf222e;
  --prism-keyword: #cf222e;
  --prism-function: #8250df;
  --prism-string: #0a3069;
  --prism-number: #0550ae;
  --prism-class: #953800;

  &[data-color-scheme="dark"] {
    --primary-color: #f9b635;
    --primary-color-opaque: #f9b63522;
    --text-1: #f3f3f3;
    --text-2: #c5c5c5;
    --text-3: #a6a6a6;
    --text-4: #787878;
    --text-5: #111111;
    --background-0: #000000;
    --background-1: #0d0d0d;
    --background-2: #121212;
    --background-3: #191919;
    --background-4: #232323;
    --background-5: #f3f3f3;
    --highlight-color: #665c00;
    --success-color: #55b985;
    --warn-color: #d5a64a;
    --danger-color: #ef7373;
    --git-ignored-status-color: #787878;
    --prism-comment: #8b949e;
    --prism-punctuation: #c9d1d9;
    --prism-property: #ffa657;
    --prism-selector: #7ee787;
    --prism-operator: #ff7b72;
    --prism-keyword: #ff7b72;
    --prism-function: #d2a8ff;
    --prism-string: #a5d6ff;
    --prism-number: #79c0ff;
    --prism-class: #ffa657;
  }
}