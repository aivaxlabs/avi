[data-theme="solarized"] {
  --primary-color: #268bd2;
  --primary-color-opaque: #268bd222;
  --text-1: #586e75;
  --text-2: #657b83;
  --text-3: #657b83;
  --text-4: #93a1a1;
  --text-5: #fdf6e3;
  --background-0: #fdf6e3;
  --background-1: #fdf6e3;
  --background-2: #eee8d5;
  --background-3: color-mix(in srgb, #eee8d5 90%, #93a1a1);
  --background-4: color-mix(in srgb, #eee8d5 70%, #93a1a1);
  --background-5: #002b36;
  --background-transparent-0: color-mix(in srgb, var(--background-0) 72%, transparent);
  --background-transparent-1: color-mix(in srgb, var(--background-1) 72%, transparent);
  --background-transparent-2: color-mix(in srgb, var(--background-2) 72%, transparent);
  --background-transparent-3: color-mix(in srgb, var(--background-3) 72%, transparent);
  --background-transparent-4: color-mix(in srgb, var(--background-4) 72%, transparent);
  --background-transparent-5: color-mix(in srgb, var(--background-5) 72%, transparent);
  --highlight-color: #eee8d5;
  --success-color: #859900;
  --warn-color: #cb4b16;
  --danger-color: #dc322f;
  --git-ignored-status-color: #93a1a1;
  --diff-removed-bg: color-mix(in srgb, #dc322f 12%, #fdf6e3);
  --diff-added-bg: color-mix(in srgb, #859900 12%, #fdf6e3);
  --diff-relative-margin-bg: #eee8d5;
  --prism-comment: #93a1a1;
  --prism-punctuation: #657b83;
  --prism-property: #d33682;
  --prism-selector: #b58900;
  --prism-operator: #859900;
  --prism-keyword: #859900;
  --prism-function: #268bd2;
  --prism-string: #2aa198;
  --prism-number: #2aa198;
  --prism-class: #b58900;

  &[data-color-scheme="dark"] {
    --primary-color: #268bd2;
    --primary-color-opaque: #268bd233;
    --text-1: #93a1a1;
    --text-2: #839496;
    --text-3: #839496;
    --text-4: #586e75;
    --text-5: #002b36;
    --background-0: #002b36;
    --background-1: #002b36;
    --background-2: #073642;
    --background-3: color-mix(in srgb, #073642 85%, #586e75);
    --background-4: color-mix(in srgb, #073642 70%, #586e75);
    --background-5: #fdf6e3;
    --highlight-color: #073642;
    --success-color: #859900;
    --warn-color: #cb4b16;
    --danger-color: #dc322f;
    --git-ignored-status-color: #586e75;
    --diff-removed-bg: color-mix(in srgb, #dc322f 18%, #002b36);
    --diff-added-bg: color-mix(in srgb, #859900 18%, #002b36);
    --diff-relative-margin-bg: #073642;
    --prism-comment: #586e75;
    --prism-punctuation: #839496;
    --prism-property: #d33682;
    --prism-selector: #b58900;
    --prism-operator: #859900;
    --prism-keyword: #859900;
    --prism-function: #268bd2;
    --prism-string: #2aa198;
    --prism-number: #2aa198;
    --prism-class: #b58900;
  }
}
