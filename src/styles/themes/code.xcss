[data-theme="code"] {
  --font-code: "Cascadia Code", Consolas, "Courier New", monospace;
  --primary-color: #0069cc;
  --primary-color-opaque: #0069cc1f;
  --link-color: #0069cc;
  --text-1: #202020;
  --text-2: #3f3f3f;
  --text-3: #606060;
  --text-4: #8e8e90;
  --text-5: #ffffff;
  --background-0: #ffffff;
  --background-1: #fafafd;
  --background-2: #f7f7fa;
  --background-3: #eeeef0;
  --background-4: #e2e2e5;
  --background-5: #0069cc;
  --background-transparent-0: color-mix(in srgb, var(--background-0) 72%, transparent);
  --background-transparent-1: color-mix(in srgb, var(--background-1) 72%, transparent);
  --background-transparent-2: color-mix(in srgb, var(--background-2) 72%, transparent);
  --background-transparent-3: color-mix(in srgb, var(--background-3) 72%, transparent);
  --background-transparent-4: color-mix(in srgb, var(--background-4) 72%, transparent);
  --background-transparent-5: color-mix(in srgb, var(--background-5) 72%, transparent);
  --highlight-color: #cce1f5;
  --success-color: #388a34;
  --warn-color: #895503;
  --danger-color: #ad0707;
  --git-ignored-status-color: #8e8e90;
  --git-untracked-status-color: #587c0c;
  --git-modified-status-color: #667309;
  --diff-removed-bg: #ad070726;
  --diff-added-bg: #587c0c26;
  --diff-relative-margin-bg: #0000000d;
  --prism-comment: #6e7781;
  --prism-punctuation: #1f2328;
  --prism-property: #0550ae;
  --prism-selector: #116329;
  --prism-operator: #cf222e;
  --prism-keyword: #cf222e;
  --prism-function: #8250df;
  --prism-string: #0a3069;
  --prism-number: #0550ae;
  --prism-class: #953800;
  --border-color: #e4e5e6;
  --item-hover: #0000000f;
  --item-active: #00000017;
  --code-focus-border: #0069cc;
  --code-surface: #ffffff;
  --code-overlay: #fafafd;
  --code-overlay-shadow: 0 4px 14px rgb(0 0 0 / 10%), 0 0 1px rgb(0 0 0 / 10%);
  --code-input-border: #d8d8d8;
  --code-surface-gap: 6px;
  --code-radius-small: 4px;
  --code-radius: 6px;
  --code-radius-large: 8px;

  &[data-color-scheme="dark"] {
    --primary-color: #3994bc;
    --primary-color-opaque: #3994bc29;
    --link-color: #48a0c7;
    --text-1: #cccccc;
    --text-2: #bfbfbf;
    --text-3: #8c8c8c;
    --text-4: #6b6b6b;
    --text-5: #ffffff;
    --background-0: #0d0e0f;
    --background-1: #121314;
    --background-2: #202122;
    --background-3: #242526;
    --background-4: #313233;
    --background-5: #297aa0;
    --highlight-color: #276782;
    --success-color: #73c991;
    --warn-color: #e5ba7d;
    --danger-color: #f48771;
    --git-ignored-status-color: #8c8c8c;
    --git-untracked-status-color: #73c991;
    --git-modified-status-color: #e5ba7d;
    --diff-removed-bg: #c93c3726;
    --diff-added-bg: #347d3926;
    --diff-relative-margin-bg: #ffffff12;
    --prism-comment: #8b949e;
    --prism-punctuation: #c9d1d9;
    --prism-property: #79c0ff;
    --prism-selector: #7ee787;
    --prism-operator: #ff7b72;
    --prism-keyword: #ff7b72;
    --prism-function: #d2a8ff;
    --prism-string: #a5d6ff;
    --prism-number: #79c0ff;
    --prism-class: #ffa657;
    --border-color: #2a2b2c;
    --item-hover: #ffffff12;
    --item-active: #ffffff1f;
    --code-focus-border: #3994bcb3;
    --code-surface: #191a1b;
    --code-overlay: #202122;
    --code-overlay-shadow: 0 6px 18px rgb(0 0 0 / 40%), 0 0 1px rgb(0 0 0 / 60%);
    --code-input-border: #333536;
  }

  button,
  .nav-actions button,
  .settings-button,
  .dialog-footer button,
  .code-block-header button,
  .continuations button,
  .project-picker,
  .model-pill,
  .recording-bar button.primary-mini,
  .settings-back,
  .settings-navigation button,
  .settings-inline-back,
  .settings-add-provider,
  .settings-provider-empty .primary-mini,
  .settings-actions .primary-mini,
  .icon-button,
  .round-button,
  .recent-filter-button,
  .user-message-action,
  .favorite-button,
  .sidebar-toggle,
  .attachment-chip button {
    border-radius: var(--code-radius);
  }



  button:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible,
  [tabindex]:focus-visible {
    outline-color: var(--code-focus-border);
  }

  input:not([type="checkbox"]):not([type="radio"]),
  textarea,
  select {
    padding: 6px 8px;
  }

  .sidebar {
    .sidebar-titlebar {
      height: 35px;
      padding: 4px 8px 4px 12px;
    }

    .nav-actions {
      gap: 0;
      padding: 4px;
    }

    .nav-actions button,
    .settings-button,
    .conversation-main {
      min-height: 24px;
      padding: 3px 6px;
      border-radius: var(--code-radius-small);
    }

    .recent-label {
      margin: 8px 8px 4px;
      padding: 8px 4px 0;
    }

    .conversation-list {
      gap: 0;
      padding: 2px 4px 6px;
    }

    .conversation-group {
      gap: 0;

      + .conversation-group {
        margin-top: 12px;
      }
    }

    .conversation-group-header {
      margin: 3px 4px 2px 8px;
    }

    .conversation-group-actions > button,
    .conversation-item {
      border-radius: var(--code-radius-small);
    }

    .conversation-main {
      padding-left: 16px;
    }
  }

  .app-composer {
    border-left-color: transparent;
  }

  .home-composer .chat-view-slot,
  .orchestration-container {
    padding: var(--code-surface-gap) var(--code-surface-gap) var(--code-surface-gap) 0;
  }

  .home-composer .chat-view-slot > .chat-area,
  .orchestration-container > * {
    background: var(--code-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--code-radius-large);
  }

  .sidebar {
    border-right-color: transparent;
  }

  .chat-workspace.with-auxiliary-panel .auxiliary-panel {
    margin: var(--code-surface-gap) var(--code-surface-gap) var(--code-surface-gap) 0;
    height: calc(100% - 2 * var(--code-surface-gap));
    background: var(--code-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--code-radius-large);
  }

  .settings-page .settings-main {
    margin: var(--code-surface-gap) var(--code-surface-gap) var(--code-surface-gap) 0;
    background: var(--code-surface);
    border: 1px solid var(--border-color);
    border-radius: var(--code-radius-large);
  }

  .chat-area {
    .chat-scroll {
      padding: 16px 6px calc(var(--composer-clearance, 176px) + 32px) 16px;
    }

    .file-drop-overlay {
      padding: 20px;

      div {
        gap: 6px;
        padding: 12px 16px;
        border-radius: var(--code-radius);
        box-shadow: none;
      }
    }

    .copilot-orb,
    .brand-mark {
      border-radius: var(--code-radius);
      box-shadow: none;
    }
  }

  .messages-column {
    gap: 18px;
    padding-bottom: 4px;
  }

  .assistant-row + .assistant-row {
    padding-top: 12px;
    border-top-width: 1px;
  }

  .user-bubble {
    padding: 8px 12px;
    background: color-mix(in srgb, var(--primary-color) 7%, var(--code-surface));
    border-color: transparent;
    border-radius: var(--code-radius-large);
  }

  &[data-color-scheme="dark"] .user-bubble {
    background: #ffffff13;
  }

  .composer-wrap {
    padding: 10px 24px 16px;

    .composer-wrap-strip {
      border-radius: var(--code-radius) var(--code-radius) 0 0;
    }

    .composer {
      padding: 8px 6px 6px;
      background: var(--background-2);
      border-color: var(--code-input-border);
      border-radius: var(--code-radius-large);
      outline-width: 0;

      &:focus-within {
        background: var(--background-2);
        border-color: var(--code-focus-border);
        outline-width: 0;
      }
    }

    .send-button {
      color: var(--text-5);
      background: var(--primary-color);
      border-color: transparent;

      &:hover {
        background: color-mix(in srgb, var(--primary-color) 92%, #000000);
      }
    }

    .composer-main {
      column-gap: 5px;
      row-gap: 6px;
    }

    .composer textarea {
      min-height: 42px;
      padding: 3px 5px 2px;
    }

    .round-button,
    .model-pill,
    .permission-mode-trigger,
    .model-input-trigger {
      height: 30px;
    }

    .round-button {
      width: 30px;
      flex-basis: 30px;
    }

    .model-pill,
    .permission-mode-trigger,
    .work-mode-chip,
    .message-delivery-indicator,
    .model-input-trigger,
    .model-menu-model,
    .queued-messages li,
    .queued-message-grip,
    .goal-strip-actions button {
      border-radius: var(--code-radius);
    }

    .work-mode-chip {
      height: 28px;
      padding: 0 7px 0 6px;
    }

    .message-delivery-indicator {
      height: 24px;
      padding: 0 6px;
    }

    .pending-messages-title > span:last-child {
      border-radius: var(--code-radius);
    }

    .queued-messages {
      padding: 4px;
    }
  }

  .project-picker-row {
    padding-top: 0;
    gap: 8px;

    > * {
      padding: 0 4px;
      border-radius: var(--code-radius);
    }

    .project-picker {
      padding: 3px 6px;
      border-radius: var(--code-radius);
    }

    .project-picker-menu {
      padding: 4px;
      background: var(--code-overlay);
      border-radius: var(--code-radius-large);
      box-shadow: var(--code-overlay-shadow);
    }

    .project-picker-list button,
    .project-picker-action {
      min-height: 26px;
      padding: 4px 6px;
      border-radius: var(--code-radius-small);
    }
  }

  .dropdown-menu,
  .command-picker {
    padding: 4px;
    gap: 1px;
    background: var(--code-overlay);
    border-color: var(--border-color);
    border-radius: var(--code-radius-large);
    box-shadow: var(--code-overlay-shadow);
  }

  .dropdown-menu .dropdown-menu-item,
  .command-picker .command-picker-list button {
    padding: 4px 10px;
    border: 1px solid transparent;
    border-radius: var(--code-radius);

    &:hover,
    &:focus-visible,
    &.active {
      background: var(--primary-color-opaque);
      border-color: var(--primary-color);
      outline: none;
    }
  }

  .dropdown-menu .dropdown-menu-divider {
    margin: 3px 6px;
    background: var(--border-color);
  }

  .command-picker {
    bottom: calc(100% + 4px);

    .command-picker-header {
      min-height: 26px;
      padding: 0 6px;
    }

    .command-picker-icon {
      border-radius: var(--code-radius-small);
    }
  }

  .model-dialog,
  .search-dialog,
  .mcp-dialog,
  .goal-dialog {
    padding: 12px;
    background: var(--code-overlay);
    border: 1px solid var(--border-color);
    border-radius: var(--code-radius-large);
    box-shadow: var(--code-overlay-shadow);
  }

  .search-dialog {
    padding: 0;
  }

  .dialog-search,
  .search-dialog .dialog-search kbd,
  .goal-dialog > textarea,
  .mcp-dialog .mcp-dialog-icon,
  .mcp-dialog li,
  .mcp-status-list article,
  .mcp-status-list .mcp-status-server-icon,
  .mcp-progress {
    border-radius: var(--code-radius);
  }

  .dialog-search {
    margin-bottom: 10px;
    padding: 6px 8px;
  }

  .dialog-footer {
    margin-top: 8px;
  }

  .question-card-header,
  .question-card-field {
    padding: 10px 12px;
  }

  .question-card-options {
    gap: 4px;
  }

  .question-card-option,
  .question-card-custom-input,
  .question-card-field textarea,
  .question-card-footer button {
    border-radius: var(--code-radius-small);
  }

  .question-card-option {
    padding: 6px 8px;

    &:focus-within,
    &:has(input:checked) {
      border-color: var(--code-focus-border);
      box-shadow: inset 2px 0 var(--code-focus-border);
    }
  }

  .question-card-field textarea:focus-visible,
  .question-card-custom-input:focus-visible {
    border-color: var(--code-focus-border);
    box-shadow: 0 0 0 1px var(--code-focus-border);
  }

  .question-card-footer {
    gap: 8px;
    padding: 8px 10px;
  }

  .approval-card-header,
  .approval-card-call {
    padding: 10px 12px;
  }

  .approval-card-footer {
    gap: 8px;
    padding: 8px 10px;
  }

  .approval-card-input pre,
  .approval-card-footer button {
    border-radius: var(--code-radius-small);
  }

  .approval-card:focus-visible {
    box-shadow: 0 0 0 1px var(--code-focus-border);
  }

  .code-block,
  .subagent-report-card,
  .question-card,
  .approval-card,
  .tool-call,
  .tool-result,
  .cross-thread-message-card,
  .recording-bar,
  .toast,
  .attachment-strip > .attachment-image,
  .user-attachment-image,
  .selected-model-details,
  .orchestration-section,
  .orchestration-range-popover {
    border-radius: var(--code-radius);
  }

  .attachment-list > .attachment-pill,
  .attachment-list > .attachment-chip,
  .attachment-strip > .attachment-pill,
  .attachment-strip > .attachment-chip,
  .attachment-strip > .attachment-image button,
  .section-count,
  .settings-status,
  .mcp-status-list article span.settings-status {
    border-radius: var(--code-radius);
  }

  .code-block {
    margin-bottom: 10px;
    border-radius: var(--code-radius-large);
    box-shadow: none;

    .code-block-header {
      min-height: 30px;
      gap: 8px;
      padding: 0 6px 0 10px;

      button {
        min-height: 24px;
        padding: 0 6px;
        border-radius: var(--code-radius);
      }
    }
  }

  .markdown-body .code-block pre {
    padding: 10px 12px;
  }

  .files-panel {
    .files-explorer {
      grid-template-rows: 40px 34px minmax(0, 1fr);
    }

    .files-explorer-header,
    .files-preview-header {
      gap: 6px;
      padding: 4px 8px;
    }

    .files-explorer-header button,
    .files-preview-back,
    .files-search,
    .files-tree-node,
    .files-search-result {
      border-radius: var(--code-radius-small);
    }

    .files-search {
      margin: 4px 6px;
      padding: 0 5px;
    }

    .files-tree {
      padding: 4px 0 8px;
    }

    .files-tree-node {
      height: 24px;
      padding-right: 5px;

      &.selected {
        box-shadow: inset 2px 0 var(--primary-color);
      }
    }
  }

  .auxiliary-panel-toggle,
  .auxiliary-panel .auxiliary-add-button,
  .auxiliary-panel .auxiliary-tab,
  .auxiliary-panel .auxiliary-tab-close,
  .auxiliary-panel .auxiliary-empty button,
  .auxiliary-panel .auxiliary-toolbar button {
    border-radius: var(--code-radius);
  }

  .auxiliary-panel {
    grid-template-rows: minmax(38px, auto) minmax(0, 1fr);

    .auxiliary-panel-header {
      align-self: start;
      padding: 0 4px;
      min-height: 32px;
    }

    .auxiliary-tabs-row,
    .auxiliary-tabs {
      gap: 2px;
    }

    .auxiliary-tab {

      button {
        height: auto;
        padding: 4px;
      }
    }

    .auxiliary-empty button {
      min-height: 42px;
      padding: 6px 10px;
      border: 1px solid var(--border-color);
    }

    .subagent-list-item {
      min-height: 46px;
      padding: 5px 7px;
      border-radius: var(--code-radius-small);
    }

    .task-list {
      padding: 8px;
    }

    .auxiliary-chat-view {
      .composer-wrap {
        padding: 8px 10px 12px;
      }

      .composer {
        border-radius: var(--code-radius);
      }
    }
  }

  .settings-page {
    .settings-sidebar {
      padding-inline: 2px;
      border-right: 1px solid var(--border-color);
    }

    .settings-back {
      min-height: 30px;
      margin: 6px;
      padding: 0 7px;
    }

    .settings-sidebar-heading {
      padding: 10px 12px;
    }

    .settings-search {
      height: 28px;
      margin: 2px 6px 8px;
      padding: 0 7px;
      border-radius: var(--code-radius);
    }

    .settings-navigation {
      gap: 0;
      padding: 0 6px 10px;

      button {
        padding: 5px 8px;
        border-radius: var(--code-radius-small);

        &:hover {
          background: var(--item-hover);
        }

        &.active {
          background: var(--item-active);
          box-shadow: inset 2px 0 var(--primary-color);
        }
      }
    }

    .settings-page-header {
      padding: 52px 40px 20px;
    }

    .settings-content {
      padding: 4px 40px 36px;
    }

    .settings-section-card,
    .settings-entity-row,
    .settings-provider-card,
    .settings-field input,
    .settings-field select,
    .settings-field textarea,
    .mcp-inspection-section pre {
      border-radius: var(--code-radius);
    }

    .settings-section-card {
      padding: 12px;
    }

    .maintenance-tabs button,
    .semaphore-refresh {
      border-radius: var(--code-radius);
    }

    .maintenance-tabs button[aria-selected="true"] {
      box-shadow: inset 0 -2px var(--primary-color);
    }

    .settings-row-card {
      padding: 0;

      > .settings-field,
      > .settings-toggle-row,
      > .settings-card-row {
        min-height: 58px;
        padding: 12px 14px;
      }
    }
  }

  .model-dialog {

    .model-filter-input,
    .model-provider-tabs,
    .favorite-button,
    .provider-fallback-icon,
    .model-row,
    .selected-model-details {
      border-radius: var(--code-radius);
    }
  }

  .orchestration-page {
    padding: 52px clamp(20px, 4vw, 56px) 36px;

    .orchestration-header,
    .orchestration-tabs {
      margin-bottom: 20px;
    }

    .orchestration-range-trigger,
    .orchestration-refresh,
    .orchestration-range-popover,
    .orchestration-range-fields input,
    .orchestration-range-presets button,
    .orchestration-tabs button,
    .orchestration-kpi .kpi-icon,
    .orchestration-section,
    .orchestration-section-heading .section-icon,
    .task-row {
      border-radius: var(--code-radius);
    }

    .orchestration-tabs button[aria-selected="true"] {
      box-shadow: inset 0 -2px var(--primary-color);
    }

    .orchestration-section {
      border: 1px solid var(--border-color);
    }

    .orchestration-section-heading {
      min-height: 48px;
      padding: 10px 12px;
    }

    .task-list,
    .model-usage-list {
      padding: 4px;
    }

    .task-row {
      padding: 8px;
    }
  }

  .recording-bar {
    margin-bottom: 6px;
    padding: 5px 7px;

    .audio-wave {
      border-radius: var(--code-radius);
    }
  }

  .toast {
    right: 12px;
    bottom: 12px;
    padding: 8px 10px;
  }

  .code-block,
  .files-code,
  .theme-preview-code {
    background: var(--background-2);
    color: var(--text-1);
  }

  .markdown-body :not(pre) > code {
    color: var(--text-1);
    background: var(--background-3);
    border-radius: var(--code-radius-small);
  }

  .primary-mini {
    background: var(--primary-color) !important;
  }
}