[data-theme="code"] {
  --font-code: "Cascadia Code", Consolas, "Courier New", monospace;
  --primary-color: #0078d4;
  --primary-color-opaque: #0078d422;
  --text-1: #3b3b3b;
  --text-2: #575757;
  --text-3: #6e6e6e;
  --text-4: #959595;
  --text-5: #ffffff;
  --background-0: #ffffff;
  --background-1: #f8f8f8;
  --background-2: #f3f3f3;
  --background-3: #e9e9e9;
  --background-4: #dddddd;
  --background-5: #0078d4;
  --highlight-color: #fff3b8;
  --success-color: #16825d;
  --warn-color: #9a6700;
  --danger-color: #c43c3c;
  --git-ignored-status-color: #959595;
  --diff-removed-bg: #5a1d24;
  --diff-added-bg: #173f2a;
  --diff-relative-margin-bg: #ffffff12;
  --prism-comment: #008000;
  --prism-punctuation: #3b3b3b;
  --prism-property: #e50000;
  --prism-selector: #800000;
  --prism-operator: #3b3b3b;
  --prism-keyword: #0000ff;
  --prism-function: #795e26;
  --prism-string: #a31515;
  --prism-number: #098658;
  --prism-class: #267f99;

  &[data-color-scheme="dark"] {
    --primary-color: #0078d4;
    --primary-color-opaque: #0078d42e;
    --text-1: #cccccc;
    --text-2: #b3b3b3;
    --text-3: #8c8c8c;
    --text-4: #6e6e6e;
    --text-5: #ffffff;
    --background-0: #181818;
    --background-1: #1f1f1f;
    --background-2: #252526;
    --background-3: #2a2d2e;
    --background-4: #3c3c3c;
    --background-5: #0078d4;
    --highlight-color: #6b611f;
    --success-color: #4ec994;
    --warn-color: #cca700;
    --danger-color: #f14c4c;
    --git-ignored-status-color: #6e6e6e;
    --diff-removed-bg: #5a1d24;
    --diff-added-bg: #173f2a;
    --diff-relative-margin-bg: #ffffff12;
    --prism-comment: #6a9955;
    --prism-punctuation: #d4d4d4;
    --prism-property: #9cdcfe;
    --prism-selector: #d7ba7d;
    --prism-operator: #d4d4d4;
    --prism-keyword: #569cd6;
    --prism-function: #dcdcaa;
    --prism-string: #ce9178;
    --prism-number: #b5cea8;
    --prism-class: #4ec9b0;
  }

  .code-block,
  .files-code,
  .theme-preview-code {
    background: #1e1e1e;
    color: #d4d4d4;
  }
}
