[data-theme="goblin"] {
  --font-ui: "Segoe UI", system-ui, sans-serif;
  --font-code: "Cascadia Code", Consolas, "Courier New", monospace;
  --primary-color: #0169cc;
  --primary-color-opaque: #0169cc22;
  --text-1: #0d0d0d;
  --text-2: #424242;
  --text-3: #6f6f6f;
  --text-4: #9b9b9b;
  --text-5: #ffffff;
  --background-0: #ffffff;
  --background-1: #ffffff;
  --background-2: #f4f4f4;
  --background-3: #e8e8e8;
  --background-4: #d9d9d9;
  --background-5: #0d0d0d;
  --highlight-color: #e5f3ff;
  --success-color: #16853f;
  --warn-color: #a15c00;
  --danger-color: #d03535;
  --git-ignored-status-color: #9b9b9b;
  --prism-comment: #6f6f6f;
  --prism-punctuation: #424242;
  --prism-property: #0169cc;
  --prism-selector: #16853f;
  --prism-operator: #7c3aed;
  --prism-keyword: #0169cc;
  --prism-function: #6d28d9;
  --prism-string: #087c55;
  --prism-number: #b54708;
  --prism-class: #0169cc;

  &[data-color-scheme="dark"] {
    --primary-color: #0169cc;
    --primary-color-opaque: #0169cc33;
    --text-1: #fcfcfc;
    --text-2: #cdcdcd;
    --text-3: #9b9b9b;
    --text-4: #676767;
    --text-5: #111111;
    --background-0: #0d0d0d;
    --background-1: #111111;
    --background-2: #1f1f1f;
    --background-3: #292929;
    --background-4: #363636;
    --background-5: #fcfcfc;
    --highlight-color: #123a5e;
    --success-color: #57c785;
    --warn-color: #e6ae5c;
    --danger-color: #f06a6a;
    --git-ignored-status-color: #676767;
    --prism-comment: #8b8b8b;
    --prism-punctuation: #cdcdcd;
    --prism-property: #66aaf0;
    --prism-selector: #72d69c;
    --prism-operator: #c9a4f6;
    --prism-keyword: #66aaf0;
    --prism-function: #b99ae8;
    --prism-string: #72d69c;
    --prism-number: #f3a15f;
    --prism-class: #66aaf0;
  }

  .code-block,
  .files-code,
  .theme-preview-code {
    background: #111111;
    color: #fcfcfc;
  }
}
