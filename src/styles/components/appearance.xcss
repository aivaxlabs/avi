.settings-page {
  .settings-appearance {
    display: grid;
    gap: 38px;

    @media (max-width: 700px) {
      gap: 30px;
    }

    .settings-section {
      gap: 12px;
    }
  }

  .appearance-desktop-switch {
    appearance: none;
    position: relative;
    flex: 0 0 auto;
    width: 34px;
    height: 20px;
    margin: 0;
    background: --background-3;
    border: 1px solid --border-color;
    border-radius: 999px;
    cursor: pointer;
    transition: background 140ms --base-transition,
      border-color 140ms --base-transition;

    &::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 14px;
      height: 14px;
      background: --text-3;
      border-radius: 50%;
      box-shadow: 0 1px 2px rgb(0 0 0 / 24%);
      transition: transform 140ms --base-transition,
        background 140ms --base-transition;
    }

    &:checked {
      background: --primary-color;
      border-color: --primary-color;

      &::after {
        background: white;
        transform: translateX(14px);
      }
    }

    &:focus-visible {
      outline: 2px solid --primary-color;
      outline-offset: 2px;
    }
  }

  .appearance-theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(238px, 1fr));
    gap: 16px;
  }

  .appearance-theme-card {
    display: grid;
    gap: 10px;
    padding: 10px;
    text-align: left;
    color: inherit;
    font: inherit;
    background: --background-1;
    border: 1px solid --border-color;
    border-radius: 14px;
    cursor: pointer;
    transition: transform 180ms --base-transition,
      border-color 180ms --base-transition,
      box-shadow 180ms --base-transition;

    &:hover {
      transform: translateY(-2px);
      border-color: --text-4;
      box-shadow: 0 8px 22px rgb(0 0 0 / 10%);
    }

    &:focus-visible {
      outline: 2px solid --primary-color;
      outline-offset: 2px;
    }

    &.selected {
      border-color: --primary-color;
      box-shadow: 0 0 0 1px --primary-color, 0 8px 22px --primary-color-opaque;
    }
  }

  .appearance-theme-meta {
    display: grid;
    gap: 3px;
    padding: 0 2px 2px;
  }

  .appearance-theme-name {
    display: flex;
    align-items: center;
    gap: 6px;
    color: --text-1;
    font-size: 1rem;
    font-weight: 500;

    svg {
      color: --primary-color;
    }
  }

  .appearance-theme-tagline {
    color: --text-3;
    font-size: .9rem;
    line-height: 1.45;
  }

  .theme-preview {
    overflow: hidden;
    font-family: --font-ui;
    color: --text-1;
    background: --background-1;
    border-radius: 8px;
    outline: 1px solid rgb(127 127 127 / 28%);
    transition: outline-color 180ms --base-transition;

    &.active {
      outline-color: transparent;
    }
  }

  .theme-preview-bar {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 22px;
    padding: 0 8px;
    background: --background-2;
    border-bottom: 1px solid --background-4;

    .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;

      &.danger {
        background: --danger-color;
      }

      &.warn {
        background: --warn-color;
      }

      &.success {
        background: --success-color;
      }
    }
  }

  .theme-preview-bar-title {
    margin-left: 3px;
    color: --text-3;
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: 0.4px;
  }

  .theme-preview-body {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    min-height: 122px;
  }

  .theme-preview-sidebar {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 8px 6px;
    background: --background-2;
    border-right: 1px solid --background-4;
  }

  .theme-preview-sidebar-item {
    height: 8px;
    background: --background-3;
    border-radius: 3px;

    &.active {
      background: --primary-color-opaque;
    }
  }

  .theme-preview-chat {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 8px;
    background: --background-0;
  }

  .theme-preview-message {
    display: grid;
    gap: 4px;
    max-width: 86%;
    padding: 6px 8px;
    border-radius: 8px;

    &.assistant {
      background: --background-2;
      border: 1px solid --background-4;
    }

    &.user {
      justify-self: end;
      color: --text-5;
      background: --primary-color;
    }
  }

  .theme-preview-code {
    align-self: start;
    padding: 6px 8px;
    overflow: hidden;
    font-family: --font-code;
    font-size: .9rem;
    line-height: 1.4;
    white-space: nowrap;
    background: --background-2;
    border-radius: 6px;

    .tk-keyword {
      color: --prism-keyword;
    }

    .tk-function {
      color: --prism-function;
    }

    .tk-string {
      color: --prism-string;
    }

    .tk-punctuation {
      color: --prism-punctuation;
    }
  }

  .theme-preview-composer {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding: 5px 8px;
    background: --background-2;
    border: 1px solid --background-4;
    border-radius: 8px;
  }

  .theme-preview-send {
    flex: 0 0 auto;
    width: 14px;
    height: 14px;
    background: --primary-color;
    border-radius: 4px;
  }

  .theme-preview .line {
    height: 5px;
    border-radius: 3px;

    &.strong {
      width: 88%;
      background: --text-2;
    }

    &.soft {
      width: 64%;
      background: --text-3;
    }

    &.on-primary {
      width: 72%;
      background: currentColor;
      opacity: 0.85;
    }

    &.faint {
      width: 46%;
      background: --text-4;
    }
  }

  .appearance-background-card {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(220px, .7fr);
    gap: 20px;
    padding: 12px;

    @media (max-width: 800px) {
      grid-template-columns: 1fr;
    }
  }

  .appearance-background-preview {
    height: 360px;
    min-height: 0;
    border: 1px solid --border-color;
    border-radius: 10px;

    .chat-scroll {
      overflow: hidden;
      padding: 22px 5px 28px 20px;
      scrollbar-gutter: auto;
    }
  }

  .appearance-background-editor {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 6px 4px 4px 0;

    @media (max-width: 800px) {
      padding: 4px;
    }
  }

  .appearance-background-control {
    display: grid;
    gap: 8px;
    padding: 12px 0 16px;
    color: --text-2;
    font-size: .9rem;

    & + & {
      border-top: 1px solid --border-color;
    }

    select {
      width: 100%;
      height: 34px;
      padding: 0 12px;
      color: --text-1;
      background: --background-2;
      border: 1px solid --border-color;
      border-radius: 9px;
      outline: none;
      text-transform: capitalize;

      &:focus-visible {
        border-color: --primary-color;
        box-shadow: 0 0 0 2px --primary-color-opaque;
      }
    }
  }

  .appearance-background-control-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    output {
      color: --text-1;
      font-variant-numeric: tabular-nums;
    }
  }

  .appearance-background-opacity input {
    width: 100%;
    height: 18px;
    margin: 0;
    padding: 0;
    accent-color: --primary-color;
    cursor: pointer;
  }

  .appearance-background-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid --border-color;

    button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      min-height: 32px;
      font-size: .9rem;
      cursor: pointer;

      &:disabled {
        cursor: default;
        opacity: .55;
      }

      svg {
        margin: 0;
      }
    }
  }

  .appearance-background-select {
    flex: 1;
    color: --text-1;
    background: --background-3;
    border: 1px solid --border-color;

    &:hover:not(:disabled) {
      background: --item-hover;
      border-color: --text-4;
    }
  }

  .appearance-background-remove {
    padding: 4px 8px;
    color: --text-3;
    background: transparent;

    &:hover:not(:disabled) {
      color: --danger-color;
      background: --item-hover;
    }
  }

  .appearance-background-error {
    margin: 10px 0 0;
    color: --danger-color;
    font-size: .9rem;
  }
}
