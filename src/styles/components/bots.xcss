.bots-label {
  margin: 0;
  padding-top: 8px;
}

.sidebar-bots {
  flex: 0 0 auto;
  min-height: 0;
  max-height: 220px;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 2px;
  padding: 6px;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  .conversation-main {
    padding: 4px 6px;
    padding-left: 8px;
  }
}

.bot-item.disabled {
  opacity: 0.45;

  .bot-avatar {
    filter: grayscale(1);
  }
}

.sidebar-bots-empty {
  margin: 0;
  padding: 2px 4px 6px;
  color: var(--text-4);
  font-size: 11px;
  line-height: 1.5;
}

.bot-avatar {
  position: relative;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;

  svg {
    display: block;
    border-radius: 50%;
  }

  &.large {
    width: 40px;
    height: 40px;
  }
}

.bot-status-dot {
  flex: 0 0 auto;
  width: 9px;
  height: 9px;
  border: 2px solid var(--background-2);
  border-radius: 999px;

  &.active {
    background: var(--success-color, var(--text-2));
  }

  &.disabled {
    background: var(--text-4);
  }
}

.bot-status-sleep {
  flex: 0 0 auto;
  color: var(--text-4);
}

.bot-queue-badge {
  flex: 0 0 auto;
  min-width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
  padding: 0 4px;
  color: var(--background-1);
  background: var(--text-2);
  border-radius: 999px;
  font-size: 10px;
  font-weight: 600;
}

.agent-thread-icon {
  flex: 0 0 auto;
  color: var(--text-4);
}

.bot-model-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  color: var(--text-3);
  font-size: 12px;
  white-space: nowrap;
}

.bot-queue {
  min-height: 0;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  align-content: start;
  gap: 8px;
  padding: 10px;
}

.bot-log-selector {
  display: block;

  select {
    min-width: 200px;
    padding: 4px 8px !important;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 32px;
    font: inherit;
    font-size: --font-md;

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }
}

.bot-log-tabs {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  padding-bottom: 2px;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 7px;
    font-size: --font-sm;
    font-weight: 500;

    small {
      min-width: 16px;
      padding: 1px 4px;
      color: var(--text-4);
      background: var(--background-3);
      border-radius: 999px;
      font-size: 9px;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);

      small {
        color: var(--text-2);
      }
    }
  }
}

.bot-log-entries {
  min-height: 0;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 8px;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;
}

.bot-queue-empty {
  display: grid;
  justify-items: center;
  gap: 6px;
  padding: 40px 10px;
  color: var(--text-4);
  text-align: center;

  strong {
    color: var(--text-2);
    font-size: --font-md;
  }

  span {
    font-size: --font-sm;
  }
}

.bot-queue-item {
  position: relative;
  display: grid;
  gap: 6px;
  padding: 10px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 8px;

  header {
    min-width: 0;
    display: grid;
    gap: 2px;
    padding-right: 28px;

    strong {
      color: var(--text-1);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    small {
      color: var(--text-4);
      font-size: 11px;
    }
  }

  .bot-log-open {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 6px;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }

  .bot-log-preview {
    position: relative;
    max-height: 108px;
    overflow: hidden;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    mask-image: linear-gradient(to bottom, #000 76px, transparent 108px);

    > :last-child {
      margin-bottom: 0;
    }

    h1,
    h2,
    h3 {
      margin: 8px 0 4px;
      font-size: 1em;
      border: 0;
    }

    p,
    ul,
    ol,
    pre,
    table,
    blockquote {
      margin: 0 0 6px;
    }

    pre {
      padding: 8px;
    }

    th,
    td {
      min-width: 80px;
      padding: 5px 7px;
    }
  }
}

.bot-log-dialog {
  width: min(820px, calc(100vw - 60px));
  max-width: none;
  max-height: min(760px, 88vh);
  margin: auto;
  padding: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);

  &[open] {
    display: grid;
  }

  &::backdrop {
    background: rgb(0 0 0 / 58%);
    backdrop-filter: blur(10px);
  }

  > .dialog-header {
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
    }

    h2 {
      overflow: hidden;
      margin: 0;
      color: var(--text-1);
      font-size: 14px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    p {
      margin: 2px 0 0;
      color: var(--text-4);
      font-size: 11px;
    }
  }

  @media (max-width: 700px) {
    width: 100%;
    height: 100%;
    max-height: none;
    border: 0;
    border-radius: 0;
  }
}

.bot-log-dialog-content {
  min-height: 0;
  overflow: auto;
  padding: 18px;
  color: var(--text-2);
  overflow-wrap: anywhere;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;
}

.bot-queue-actions {
  display: flex;
  gap: 6px;

  button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    font-size: 12px;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--background-2);
    color: var(--text-1);

    &:hover {
      background: var(--item-hover);
    }
  }

  .bot-queue-approve {
    color: var(--success-color, var(--text-2));
  }

  .bot-queue-deny {
    color: var(--danger-color, var(--text-2));
  }
}

.bot-settings-backdrop {
  display: grid;
  place-items: center;
}

.bot-settings-dialog {
  width: min(1200px, calc(100vw - 48px));
  height: min(640px, calc(100vh - 64px));
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  overflow: hidden;
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);

  > .dialog-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
    }

    h2 {
      overflow: hidden;
      margin: 0;
      color: var(--text-1);
      font-size: 14px;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    p {
      margin: 2px 0 0;
      color: var(--text-3);
      font-size: 11px;
    }
  }

  > .dialog-footer {
    min-height: 64px;
    justify-content: flex-end;
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border-color);

    > div {
      display: flex;
      gap: 8px;
    }

    button:disabled {
      opacity: .55;
      cursor: wait;
    }
  }

  @media (max-width: 700px) {
    width: 100%;
    height: 100%;
    max-height: none;
    border: 0;
    border-radius: 0;

    > .dialog-header,
    > .dialog-footer {
      padding-inline: 16px;
    }
  }
}

.bot-settings-header-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--text-2);
  background: var(--background-3);
  border-radius: 8px;
}

.bot-settings-workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 176px minmax(0, 1fr);

  @media (max-width: 700px) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }
}

.bot-settings-tabs {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;

  .bot-settings-tab {
    min-width: 0;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 8px;
    text-align: left;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    > svg {
      justify-self: center;
    }

    > span {
      min-width: 0;
      display: grid;
      gap: 1px;
    }

    strong {
      color: inherit;
      font-size: 12px;
      font-weight: 500;
    }

    small {
      overflow: hidden;
      color: var(--text-4);
      font-size: 10px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);

      small {
        color: var(--text-3);
      }
    }
  }

  @media (max-width: 700px) {
    overflow-x: auto;
    flex-direction: row;
    gap: 2px;
    padding: 8px 12px;
    border-right: 0;
    border-bottom: 1px solid var(--border-color);
    scrollbar-width: none;

    .bot-settings-tab {
      flex: 1 0 auto;
      display: flex;
      justify-content: center;
      padding: 8px 10px;

      small {
        display: none;
      }
    }
  }
}

.bot-settings-body {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  padding: 0 24px;
  outline: 0;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  > .bot-settings-section {
    padding: 24px 0;

    &:not(:first-child) {
      border-top: 1px solid var(--border-color);
    }
  }

  input:not([type="checkbox"]):not([type="radio"]),
  select,
  textarea {
    width: 100%;
    min-width: 0;
    padding: 9px 10px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font: inherit;
    font-size: 13px;
    transition: border-color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    &:hover {
      border-color: var(--text-4);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
      background: var(--background-0);
    }

    &[readonly] {
      color: var(--text-3);
    }
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 36px;
    padding: 8px 11px;
    color: var(--text-2);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 12px;
    cursor: pointer;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition),
      border-color 140ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &:active {
      background: var(--item-active);
    }

    &.danger {
      color: var(--danger-color, var(--text-1));
    }
  }

  @media (max-width: 700px) {
    padding-inline: 20px;
  }
}

.bot-settings-section {
  display: grid;
  gap: 16px;

  > header {
    display: grid;
    gap: 4px;

    h3 {
      margin: 0;
      color: var(--text-1);
      font-size: 15px;
      font-weight: 550;
    }

    p {
      max-width: 520px;
      margin: 0;
      color: var(--text-3);
      font-size: 12px;
      line-height: 1.5;
    }
  }
}

.bot-settings-control {
  min-width: 0;
  display: grid;
  gap: 6px;

  > span:first-child {
    color: var(--text-2);
    font-size: 12px;
    font-weight: 500;
  }

  > small {
    color: var(--text-4);
    font-size: 11px;
    line-height: 1.45;
  }

  &.grow {
    flex: 1;
  }

  textarea {
    min-height: 144px;
    resize: vertical;
    line-height: 1.5;
  }
}

.bot-settings-profile {
  display: flex;
  align-items: center;
  gap: 16px;
}

.bot-settings-avatar {
  flex: 0 0 auto;
  display: grid;
  justify-items: center;
  gap: 8px;

  .bot-avatar.large {
    width: 48px;
    height: 48px;
  }

  button {
    min-height: 28px;
    padding: 4px 8px;
  }
}

.bot-settings-folder {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 8px;
}

.bot-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.bot-settings-mcp {
  > .bot-settings-mcp-empty {
    margin: 0;
    color: var(--text-3);
    font-size: 12px;
  }
}

.bot-settings-mcp-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;

  > .bot-settings-mcp-path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-4);
    font-size: 11px;
  }
}

.bot-settings-dialog .bot-settings-mcp-scope {
  display: block;
  grid-column: auto;
  min-height: 0;
  overflow: visible;
  background: transparent;

  .mcp-scope-heading {
    display: grid;
    gap: 2px;
    padding: 8px 12px 4px;

    strong {
      color: var(--text-2);
      font-size: 12px;
      font-weight: 550;
    }

    small {
      color: var(--text-4);
      font-size: 11px;
    }
  }

  .mcp-server-main {
    width: 100%;
    min-height: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    justify-content: normal;
    padding: 10px 8px 10px 12px;
    background: transparent;
    border: 0;
    text-align: left;
  }

  .mcp-server-actions {
    min-width: max-content;
  }

  .mcp-server-actions > .icon-button {
    width: 28px;
    height: 28px;
    min-height: 28px;
    display: inline-grid;
    place-items: center;
    gap: 0;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 999px;

    > svg {
      flex: none;
      margin: 0;
    }
  }
}

.bot-settings-context-size {
  max-width: 280px;
}

.bot-settings-period {
  max-width: 220px;
}

.bot-settings-number-unit {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  color: var(--text-3);
  font-size: 12px;
}

.bot-settings-choices {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
  padding: 0;
  border: 0;
}

.bot-settings-choice {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 140ms var(--base-transition),
    background 140ms var(--base-transition);

  > input {
    margin-top: 2px;
  }

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: 11px;
    line-height: 1.4;
  }

  &:hover {
    background: var(--item-hover);
  }

  &:focus-within {
    outline: 2px solid var(--text-3);
    outline-offset: 1px;
  }

  &.active {
    border-color: var(--text-3);
    background: var(--item-active);
  }
}

.bot-settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 4px 0;
  cursor: pointer;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: 11px;
    line-height: 1.4;
  }

  > input {
    flex: 0 0 auto;
  }
}

.bot-settings-inline-detail {
  grid-template-columns: minmax(0, 1fr) 88px;
  align-items: center;
  padding: 12px;
  background: var(--background-1);
  border-radius: 8px;

  > input {
    grid-column: 2;
    grid-row: 1;
  }
}

.bot-settings-window {
  display: grid;
  gap: 16px;
  padding: 16px;
  background: var(--background-1);
  border-radius: 10px;

  input:not([type="checkbox"]):not([type="radio"]),
  select,
  textarea,
  button {
    background: var(--background-2);
  }

  > small {
    color: var(--text-4);
    font-size: 11px;
  }
}

.bot-settings-days {
  display: grid;
  grid-template-columns: repeat(7, minmax(40px, 1fr));
  gap: 6px;

  .bot-settings-day {
    min-width: 0;
    min-height: 40px;
    padding: 0 4px;

    &.active {
      color: var(--text-1);
      border-color: var(--text-3);
      background: var(--item-active);
    }
  }
}

.bot-settings-path {
  font-family: var(--font-code) !important;
  font-size: 11px !important;
}

.bot-settings-danger-zone {
  > header h3 {
    color: var(--danger-color, var(--text-1));
  }
}

.bot-settings-danger-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: 11px;
    line-height: 1.4;
  }

  > button {
    flex: 0 0 auto;
  }
}

.bot-settings-error {
  margin: 0;
  padding: 10px 20px;
  color: var(--danger-color, var(--text-1));
  background: var(--background-1);
  border-top: 1px solid var(--border-color);
  font-size: 12px;
}

@media (max-width: 540px) {

  .bot-settings-profile,
  .bot-settings-danger-action {
    align-items: stretch;
    flex-direction: column;
  }

  .bot-settings-avatar {
    justify-items: start;
  }

  .bot-settings-folder,
  .bot-settings-grid,
  .bot-settings-choices {
    grid-template-columns: minmax(0, 1fr);
  }

  .bot-settings-folder input {
    grid-column: 1 / -1;
  }

  .bot-settings-danger-action > button {
    align-self: start;
  }

  .bot-settings-days {
    grid-template-columns: repeat(4, minmax(44px, 1fr));
  }
}