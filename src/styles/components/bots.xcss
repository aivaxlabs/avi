.bot-settings-page {
  .bot-activation-days {
    grid-template-columns: minmax(0, 1fr);

    > small {
      top: 0;
    }

    > .bot-settings-days {
      grid-column: 1;
      grid-row: 3;
      width: 100%;
      max-width: 420px;
      grid-template-columns: repeat(auto-fit, minmax(40px, 1fr));
      margin-top: 6px;
    }
  }

  > [role="tabpanel"][hidden] {
    display: none;
  }

  > .bot-statistics {
    min-width: 0;

    > .token-overview {
      width: 100%;
      margin-inline: 0;
    }

    .token-overview-cost {
      flex-wrap: wrap;

      > small {
        flex-basis: 100%;
      }
    }

    .usage-breakdown-copy > span {
      white-space: normal;
      overflow-wrap: anywhere;
    }

    @media (max-width: 620px) {
      .usage-breakdown-content {
        align-items: flex-start;
        flex-direction: column;
        gap: 8px;
      }

      .usage-breakdown-value {
        justify-items: start;
      }
    }
  }
}

.bots-label {
  margin: 0;
  padding-top: 8px;
}

.bots-label-actions {
  display: flex;
  align-items: center;
  gap: 2px;
}

.bot-snooze-menu {
  width: 190px;
}

.bot-submenu-holder {
  position: relative;

  &::before {
    content: '';
    position: absolute;
    top: 0;
    right: -8px;
    bottom: 0;
    width: 8px;
  }

  > .bot-submenu-trigger {
    width: 100%;

    > span {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      > svg {
        flex: 0 0 auto;
      }
    }
  }

  > .bot-submenu {
    top: -4px;
    left: calc(100% + 6px);
    width: 190px;

    &.flip-left {
      left: auto;
      right: calc(100% + 6px);
      transform-origin: top right;
    }
  }

  > .bot-work-queue-menu {
    width: 220px;
    max-height: min(420px, calc(100vh - 16px));
    overflow-y: auto;
  }
}

.sidebar-bots {
  flex: 0 0 auto;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 2px;
  padding: 6px;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  .conversation-main {
    padding: 4px 6px;
    padding-left: 8px;
  }
}

.bot-item.disabled {
  opacity: 0.45;

  .bot-avatar {
    filter: grayscale(1);
  }
}

.sidebar-bots-empty {
  margin: 0;
  padding: 2px 4px 6px;
  color: var(--text-4);
  font-size: --font-xs;
  line-height: 1.5;
}

.bot-avatar {
  position: relative;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;

  img {
    display: block;
    border-radius: 50%;
  }

  &.large {
    width: 40px;
    height: 40px;
  }
}

.bot-item-indicator {
  grid-column: 2;
  grid-row: 1;
  justify-self: center;
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  pointer-events: none;
  transition: opacity 180ms var(--base-transition);
}

.bot-item:hover .bot-item-indicator,
.bot-item.menu-open .bot-item-indicator,
.bot-item:has(> .icon-button:focus-visible) .bot-item-indicator {
  opacity: 0;
}

.sidebar .bot-item > .icon-button:focus-visible {
  opacity: .4;
  pointer-events: auto;
}

.bot-status-dot {
  width: 5px;
  height: 5px;
  border-radius: 999px;
  outline: 2px solid --background-transparent-4;

  &.active {
    background: var(--success-color, var(--text-2));
  }

  &.disabled {
    background: var(--text-4);
  }
}

.bot-status-sleep {
  color: var(--text-4);
}

.bot-queue-badge {
  min-width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
  align-content: center;
  padding: 0 4px;
  color: var(--text-5);
  background: var(--danger-color);
  border-radius: 999px;
  font-size: --font-xs;
  font-weight: 600;
  line-height: 1;
}

.agent-thread-icon {
  flex: 0 0 auto;
  color: var(--text-4);
}

.bot-model-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  color: var(--text-3);
  font-size: --font-sm;
  white-space: nowrap;
}

.bot-queue {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  align-content: start;
  gap: 16px;
  padding: 18px;
  container-type: inline-size;

  &:has(> .bot-work-view:only-child) {
    grid-template-rows: minmax(0, 1fr);
  }
}

.bot-work-selector {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-3);
  font-size: --font-sm;

  > svg {
    flex-shrink: 0;
  }

  > span {
    font-weight: 500;
  }

  select {
    min-width: 0;
  }
}

.bot-work-tabs {
  display: flex;
  gap: 12px;
  overflow-x: auto;
  padding-bottom: 0;
  border-bottom: 1px solid var(--border-color);
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: 5px 5px 0 0;
    font-size: --font-sm;
    font-weight: 500;

    small {
      min-width: 16px;
      padding: 1px 4px;
      color: var(--text-4);
      background: var(--background-3);
      border-radius: 999px;
      font-size: --font-xs;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);
      border-bottom-color: var(--text-1);

      small {
        color: var(--text-2);
      }
    }
  }
}

.bot-work-view {
  &:has(> .bot-inbox-detail) {
    overflow: hidden;
    grid-template-rows: minmax(0, 1fr);
    align-content: stretch;
  }

  width: 100%;
  min-width: 0;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 18px;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  &::-webkit-scrollbar {
    width: 10px;
  }

  &::-webkit-scrollbar-track {
    background: transparent;
  }

  &::-webkit-scrollbar-thumb {
    min-height: 44px;
    background: var(--text-4);
    background-clip: padding-box;
    border: 3px solid transparent;
    border-radius: 999px;
  }

  &:hover::-webkit-scrollbar-thumb {
    background: var(--text-3);
    background-clip: padding-box;
  }

  &::-webkit-scrollbar-button {
    width: 0;
    height: 0;
    display: none;
  }
}

.bot-queue-empty {
  display: grid;
  justify-items: center;
  gap: 8px;
  padding: 64px 20px;
  color: var(--text-3);

  > svg {
    margin-bottom: 8px;
  }

  > span {
    max-width: 260px;
    line-height: 1.5;
  }

  text-align: center;

  strong {
    color: var(--text-2);
    font-size: --font-md;
  }

  span {
    font-size: --font-sm;
  }
}

.bot-queue {
  .bot-work-warning {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding: 9px 10px;
    color: var(--warn-color);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: --font-sm;
    line-height: 1.45;

    > svg {
      flex: 0 0 auto;
      margin-top: 1px;
    }

    > div {
      min-width: 0;
      overflow-wrap: anywhere;

      > strong {
        color: var(--text-1);
        font-weight: 600;
      }

      p {
        margin: 5px 0;
        color: var(--text-3);
      }

      summary {
        margin-top: 10px;
        cursor: pointer;
        color: var(--text-2);
      }

      details > p {
        font-family: var(--font-code);
        font-size: --font-xs;
      }
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bot-inbox-filters {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    gap: 12px;

    @container (max-width: 360px) {
      grid-template-columns: minmax(0, 1fr);
    }

    > label {
      min-width: 0;
      display: grid;
      gap: 6px;

      > span {
        color: var(--text-3);
        font-size: --font-xs;
        font-weight: 500;
      }

      > input,
      > select {
        width: 100%;
        min-width: 0;
      }
    }
  }

  .bot-inbox-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;

    > li {
      min-width: 0;
      border-bottom: 1px solid var(--border-color);

      & :first-child {
        border-top: 1px solid var(--border-color);
      }

      > button {
        width: 100%;
        min-width: 0;
        min-height: 30px;
        display: grid;
        gap: 7px;
        padding: 15px 10px;
        color: var(--text-1);
        background: transparent;
        border-radius: 0;
        border: 0;
        font: inherit;
        text-align: left;

        &:hover {
          background: var(--item-hover);
        }

        &:focus-visible {
          outline: 2px solid var(--primary-color);
          outline-offset: -2px;
        }

        > strong,
        > .bot-inbox-preview {
          min-width: 0;
          overflow: hidden;
          overflow-wrap: anywhere;
          text-overflow: ellipsis;
        }

        > strong {
          font-weight: 400;
        }

        > .bot-inbox-preview {
          display: -webkit-box;
          color: var(--text-3);
          line-height: 1.4;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 1;
        }

        > .bot-inbox-meta {
          min-width: 0;
          display: flex;
          flex-wrap: wrap;
          justify-content: space-between;
          gap: 2px 8px;
          color: var(--text-3);
          font-size: --font-xs;

          > span,
          > time {
            min-width: 0;
            overflow-wrap: anywhere;
          }
        }

        &.needs-user > strong {
          color: var(--primary-color);
          font-weight: 600;

          & ::before {
            content: '\2022  ';
          }
        }
      }
    }
  }

  .bot-inbox-detail {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;

    > .bot-inbox-composer,
    > .bot-inbox-feedback {
      flex: 0 0 auto;
      width: 100%;
      max-width: 950px;
      align-self: center;
    }
  }

  .bot-inbox-history {
    flex: 1 1 0;
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 950px);
    justify-content: center;
    align-content: start;
    overflow: auto;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--text-4) transparent;

    > header {
      min-width: 0;
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;

      > span {
        min-width: 0;
        min-height: 30px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 7px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: --font-sm;
      }

      > button:first-child {
        margin-right: auto;
      }

      > span {
        color: var(--text-3);
        background: var(--background-2);
        overflow-wrap: anywhere;
        text-transform: capitalize;
      }
    }

    > h2 {
      min-width: 0;
      margin: 10px 0 8px;
      color: var(--text-1);
      font-size: --font-xxl;
      font-weight: 500;
      line-height: 1.3;
      overflow-wrap: anywhere;
    }
  }

  .bot-inbox-messages {
    background-color: --background-0;
    border-radius: 10px;
    border: 1px solid --border-color;
    min-width: 0;
    margin: 0;
    padding: 0;
    margin-right: 5px;
    list-style: none;

    > li {
      min-width: 0;
      border-bottom: 1px solid var(--border-color);
      overflow-wrap: anywhere;

      > header {
        padding: 10px 20px;
        min-width: 0;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 3px 8px;
        margin-bottom: 5px;
        border-bottom: 1px solid --border-color;

        > strong {
          min-width: 0;
          flex: 1 1 100px;
          overflow-wrap: anywhere;
        }

        > .bot-message-response-indicator {
          color: var(--text-3);
          font-size: --font-xs;
        }

        > time {
          flex: 0 1 auto;
          color: var(--text-3);
          font-size: --font-xs;
          overflow-wrap: anywhere;
        }
      }

      > .markdown-body {
        padding: 20px;
        min-width: 0;
        color: inherit;
        overflow-wrap: anywhere;
      }

      > .question-card {
        width: auto;
        margin: 0 20px 20px;
      }

      > .bot-inbox-answers {
        display: grid;
        gap: 10px;
        margin: 0;
        padding: 20px;

        > div {
          min-width: 0;
          display: grid;
          gap: 2px;
        }

        dt {
          color: var(--text-3);
          font-size: --font-sm;
        }

        dd {
          margin: 0;
          color: var(--text-1);
          white-space: pre-wrap;
        }
      }

      & .from-user {
        background: var(--background-2);
      }
    }
  }

  .bot-inbox-composer {
    min-width: 0;
    display: grid;
    gap: 6px;

    > textarea {
      width: 100%;
      min-width: 0;
      min-height: 72px;
      resize: vertical;
      padding: 7px 8px;
      color: var(--text-1);
      background: var(--background-1);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font: inherit;
      line-height: 1.4;
    }

    > footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 6px;
    }
  }

  .bot-inbox-attachments {
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;

    > li {
      position: relative;
      min-width: 0;
      max-width: 180px;
      display: grid;
      align-content: start;
      gap: 3px;
      padding: 5px;
      color: var(--text-2);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-size: --font-xs;

      > img,
      > video {
        display: block;
        max-width: 180px;
        max-height: 180px;
        object-fit: contain;
      }

      > span,
      > small {
        min-width: 0;
        overflow: hidden;
        overflow-wrap: anywhere;
        text-overflow: ellipsis;
      }

      > details {
        min-width: 0;

        > summary {
          min-width: 0;
          overflow: hidden;
          overflow-wrap: anywhere;
          text-overflow: ellipsis;
          cursor: pointer;
        }

        > pre {
          max-width: 100%;
          max-height: 100px;
          margin: 4px 0 0;
          white-space: pre-wrap;
          overflow: hidden;
          overflow-wrap: anywhere;
        }
      }

      > button {
        position: absolute;
        top: 2px;
        right: 2px;
        min-height: 30px;
        display: grid;
        place-items: center;
        padding: 2px;
        color: var(--text-2);
        background: var(--background-1);
        border: 1px solid var(--border-color);
        border-radius: 6px;

        &:hover {
          color: var(--danger-color);
          background: var(--item-hover);
        }

        &:focus-visible {
          outline: 2px solid var(--primary-color);
          outline-offset: 1px;
        }
      }

      &.citation {
        width: 280px;
        max-width: 100%;
        gap: 4px;
        padding: 6px 8px;

        &:has(> button) {
          padding-right: 38px;
        }

        > blockquote,
        > p {
          margin: 0;
          display: -webkit-box;
          -webkit-box-orient: vertical;
          overflow: hidden;
          overflow-wrap: anywhere;
          line-height: 1.45;
        }

        > blockquote {
          -webkit-line-clamp: 2;
          padding-left: 8px;
          color: var(--text-3);
          border-left: 2px solid var(--primary-color);
        }

        > p {
          -webkit-line-clamp: 3;
          color: var(--text-1);
          font-size: --font-sm;
          white-space: pre-wrap;
        }
      }
    }
  }

  .bot-inbox-approval {
    width: 100%;
    flex-shrink: 0;
  }

  .bot-inbox-feedback {
    margin: 0;
    padding: 6px 8px;
    color: var(--text-3);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-size: --font-sm;
    overflow-wrap: anywhere;

    &.error {
      color: var(--danger-color);
      border-color: var(--danger-color);
    }
  }

  .bot-diary-list {
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;

    > li {
      min-width: 0;
      padding: 9px 0;
      border-bottom: 1px solid var(--border-color);
      overflow-wrap: anywhere;

      &:first-child {
        border-top: 1px solid var(--border-color);
      }

      > h3 {
        min-width: 0;
        margin: 0 0 4px;
        color: var(--text-1);
        font-size: --font-md;
        font-weight: 600;
        overflow-wrap: anywhere;
      }

      > .markdown-body {
        min-width: 0;
        color: var(--text-2);
        overflow-wrap: anywhere;
      }

      > small {
        display: block;
        margin-top: 6px;
        padding-top: 5px;
        color: var(--text-3);
        border-top: 1px solid var(--border-color);
        font-size: --font-xs;
        overflow-wrap: anywhere;
        text-transform: capitalize;
      }
    }
  }
}

.bot-settings-backdrop {
  display: grid;
  place-items: center;
}

.bot-settings-dialog {
  width: min(1200px, calc(100vw - 48px));
  height: min(640px, calc(100vh - 64px));
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  overflow: hidden;
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);

  > .dialog-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
    }

    h2 {
      overflow: hidden;
      margin: 0;
      color: var(--text-1);
      font-size: --font-md;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    p {
      margin: 2px 0 0;
      color: var(--text-3);
      font-size: --font-xs;
    }
  }

  > .dialog-footer {
    min-height: 64px;
    justify-content: flex-end;
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border-color);

    > div {
      display: flex;
      gap: 8px;
    }

    button:disabled {
      opacity: .55;
      cursor: wait;
    }
  }

  @media (max-width: 700px) {
    width: 100%;
    height: 100%;
    max-height: none;
    border: 0;
    border-radius: 0;

    > .dialog-header,
    > .dialog-footer {
      padding-inline: 16px;
    }
  }
}

.bot-settings-header-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--text-2);
  background: var(--background-3);
  border-radius: 8px;
}

.bot-settings-workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 176px minmax(0, 1fr);

  @media (max-width: 700px) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }
}

.bot-settings-tabs {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;

  .bot-settings-tab {
    min-width: 0;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 8px;
    text-align: left;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    > svg {
      justify-self: center;
    }

    > span {
      min-width: 0;
      display: grid;
      gap: 1px;
    }

    strong {
      color: inherit;
      font-size: --font-sm;
      font-weight: 500;
    }

    small {
      overflow: hidden;
      color: var(--text-4);
      font-size: --font-xs;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);

      small {
        color: var(--text-3);
      }
    }
  }

  @media (max-width: 700px) {
    overflow-x: auto;
    flex-direction: row;
    gap: 2px;
    padding: 8px 12px;
    border-right: 0;
    border-bottom: 1px solid var(--border-color);
    scrollbar-width: none;

    .bot-settings-tab {
      flex: 1 0 auto;
      display: flex;
      justify-content: center;
      padding: 8px 10px;

      small {
        display: none;
      }
    }
  }
}

.bot-settings-body {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  padding: 0 24px;
  outline: 0;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  > .bot-settings-section {
    padding: 24px 0;

    &:not(:first-child) {
      border-top: 1px solid var(--border-color);
    }
  }

  button:not(.button, .long-text-button) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 36px;
    padding: 8px 11px;
    color: var(--text-2);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: --font-sm;
    cursor: pointer;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition),
      border-color 140ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &:active {
      background: var(--item-active);
    }

    &.danger {
      color: var(--danger-color, var(--text-1));
    }
  }

  @media (max-width: 700px) {
    padding-inline: 20px;
  }
}

.bot-settings-section {
  display: grid;
  gap: 16px;

  > header {
    display: grid;
    gap: 4px;

    h3 {
      margin: 0;
      color: var(--text-1);
      font-size: --font-md;
      font-weight: 550;
    }

    p {
      max-width: 520px;
      margin: 0;
      color: var(--text-3);
      font-size: --font-sm;
      line-height: 1.5;
    }
  }
}

.bot-settings-control {
  min-width: 0;
  display: grid;
  gap: 6px;

  > span:first-child {
    color: var(--text-2);
    font-size: --font-sm;
    font-weight: 500;
  }

  > small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.45;
  }

  &.grow {
    flex: 1;
  }

  > .select,
  > .long-text-button {
    justify-self: start;
  }
}

.bot-settings-work-queue {
  display: grid;
  margin: 0;
  padding: 4px;
  list-style: none;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;
}

.bot-settings-work-queue-item {
  position: relative;
  display: grid;
  grid-template-columns: 22px 18px minmax(0, 1fr) 28px;
  gap: 6px;
  align-items: start;
  padding: 6px;
  border-radius: 8px;
  transition: background 160ms var(--base-transition),
    opacity 160ms var(--base-transition);

  + .bot-settings-work-queue-item {
    border-top: 1px solid var(--border-color);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  &:hover,
  &:focus-within {
    background: var(--item-hover);

    > button.bot-settings-work-queue-grip,
    > button.bot-settings-work-queue-remove {
      opacity: 1;
    }
  }

  &.dragging {
    opacity: .45;
  }

  &.drop-before::before,
  &.drop-after::after {
    content: "";
    position: absolute;
    left: 6px;
    right: 6px;
    height: 2px;
    background: var(--control-accent);
    border-radius: 2px;
    pointer-events: none;
  }

  &.drop-before::before {
    top: -1px;
  }

  &.drop-after::after {
    bottom: -1px;
  }

  > textarea.input:not([readonly]) {
    min-height: --control-height;
    max-height: 240px;
    padding-block: 5px;
    field-sizing: content;
    resize: none;
    line-height: 18px;
  }

  > .bot-settings-work-queue-index {
    height: --control-height;
    display: grid;
    place-items: center;
    color: var(--text-4);
    font-size: --font-xs;
    font-variant-numeric: tabular-nums;
  }

  > button.bot-settings-work-queue-grip,
  > button.bot-settings-work-queue-remove {
    width: 22px;
    height: --control-height;
    min-height: 0;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 6px;
    opacity: .5;

    > svg {
      margin: 0;
    }

    &:hover,
    &:focus-visible {
      color: var(--text-1);
      background: var(--item-active);
      opacity: 1;
    }

    &:focus-visible {
      outline: 2px solid --control-focus-ring;
      outline-offset: 1px;
    }
  }

  > button.bot-settings-work-queue-grip {
    cursor: grab;

    &:active {
      cursor: grabbing;
    }
  }

  > button.bot-settings-work-queue-remove {
    width: 28px;

    &:hover,
    &:focus-visible {
      color: var(--danger-color);
    }
  }
}

.bot-settings-priority-item {
  > .bot-settings-priority-item-content {
    min-width: 0;
    min-height: --control-height;
    display: grid;
    align-content: center;
    gap: 2px;

    > strong {
      overflow: hidden;
      color: var(--text-1);
      font-size: --font-sm;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    > small {
      color: var(--text-3);
      font-size: --font-xs;
    }
  }

  > button:disabled {
    visibility: hidden;
  }
}

.bot-settings-work-queue-empty {
  margin: 0;
  padding: 14px;
  color: var(--text-4);
  background: var(--background-1);
  border: 1px dashed var(--border-color);
  border-radius: 10px;
  font-size: --font-sm;
}

.bot-settings-work-queue-add {
  justify-self: start;
}

.bot-settings-hint {
  color: var(--text-4);
  font-size: --font-xs;
  line-height: 1.45;
}

.bot-settings-profile {
  display: flex;
  align-items: center;
  gap: 16px;
}

.bot-settings-avatar {
  flex: 0 0 auto;
  display: grid;
  justify-items: center;
  gap: 8px;

  .bot-avatar.large {
    width: 48px;
    height: 48px;
  }

  button {
    min-height: 28px;
    padding: 4px 8px;
  }
}

.bot-settings-folder {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 8px;
}

.bot-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.bot-settings-mcp {
  > .bot-settings-mcp-empty {
    margin: 0;
    color: var(--text-3);
    font-size: --font-sm;
  }
}

.bot-settings-mcp-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;

  > .bot-settings-mcp-path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-4);
    font-size: --font-xs;
  }
}

.bot-settings-dialog .bot-settings-mcp-scope {
  display: block;
  grid-column: auto;
  min-height: 0;
  overflow: visible;
  background: transparent;

  .mcp-scope-heading {
    display: grid;
    gap: 2px;
    padding: 8px 12px 4px;

    strong {
      color: var(--text-2);
      font-size: --font-sm;
      font-weight: 550;
    }

    small {
      color: var(--text-4);
      font-size: --font-xs;
    }
  }

  .mcp-server-main {
    width: 100%;
    min-height: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    justify-content: normal;
    padding: 10px 8px 10px 12px;
    background: transparent;
    border: 0;
    text-align: left;
  }

  .mcp-server-actions {
    min-width: max-content;
  }

  .mcp-server-actions > .icon-button {
    width: 28px;
    height: 28px;
    min-height: 28px;
    display: inline-grid;
    place-items: center;
    gap: 0;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 999px;

    > svg {
      flex: none;
      margin: 0;
    }
  }
}

.bot-settings-context-size {
  max-width: 280px;
}

.bot-settings-period {
  max-width: 220px;
}

.bot-settings-number-unit {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  color: var(--text-3);
  font-size: --font-sm;
}

.bot-settings-choices {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
  padding: 0;
  border: 0;
}

.bot-settings-choice {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 140ms var(--base-transition),
    background 140ms var(--base-transition);

  > input {
    margin-top: 2px;
  }

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  &:hover {
    background: var(--item-hover);
  }

  &:focus-within {
    outline: 2px solid var(--text-3);
    outline-offset: 1px;
  }

  &.active {
    border-color: var(--text-3);
    background: var(--item-active);
  }
}

.bot-settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 4px 0;
  cursor: pointer;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  > input {
    flex: 0 0 auto;
  }
}

.bot-settings-inline-detail {
  grid-template-columns: minmax(0, 1fr) 88px;
  align-items: center;
  padding: 12px;
  background: var(--background-1);
  border-radius: 8px;

  > input {
    grid-column: 2;
    grid-row: 1;
  }
}

.bot-settings-window {
  display: grid;
  gap: 16px;
  padding: 16px;
  background: var(--background-1);
  border-radius: 10px;

  button:not(.button, .long-text-button) {
    background: var(--background-2);
  }

  > small {
    color: var(--text-4);
    font-size: --font-xs;
  }
}

.bot-settings-days {
  display: grid;
  grid-template-columns: repeat(7, minmax(40px, 1fr));
  gap: 6px;

  .bot-settings-day {
    min-width: 0;
    min-height: 40px;
    padding: 0 4px;

    &.active {
      color: var(--text-1);
      border-color: var(--text-3);
      background: var(--item-active);
    }
  }
}

.bot-settings-danger-zone {
  > header h3 {
    color: var(--danger-color, var(--text-1));
  }
}

.bot-settings-danger-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  > button {
    flex: 0 0 auto;
  }
}

.bot-settings-error {
  margin: 0;
  padding: 10px 20px;
  color: var(--danger-color, var(--text-1));
  background: var(--background-1);
  border-top: 1px solid var(--border-color);
  font-size: --font-sm;
}

@media (max-width: 540px) {

  .bot-settings-profile,
  .bot-settings-danger-action {
    align-items: stretch;
    flex-direction: column;
  }

  .bot-settings-avatar {
    justify-items: start;
  }

  .bot-settings-folder,
  .bot-settings-grid,
  .bot-settings-choices {
    grid-template-columns: minmax(0, 1fr);
  }

  .bot-settings-folder input {
    grid-column: 1 / -1;
  }

  .bot-settings-danger-action > button {
    align-self: start;
  }

  .bot-settings-days {
    grid-template-columns: repeat(4, minmax(44px, 1fr));
  }
}