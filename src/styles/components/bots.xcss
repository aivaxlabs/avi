.bots-label {
  margin: 0;
  padding-top: 8px;
}

.bots-label-actions {
  display: flex;
  align-items: center;
  gap: 2px;
}

.bot-snooze-menu {
  width: 190px;
}

.sidebar-bots {
  flex: 0 0 auto;
  min-height: 0;
  max-height: 220px;
  overflow: auto;
  display: grid;
  align-content: start;
  gap: 2px;
  padding: 6px;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  .conversation-main {
    padding: 4px 6px;
    padding-left: 8px;
  }
}

.bot-item.disabled {
  opacity: 0.45;

  .bot-avatar {
    filter: grayscale(1);
  }
}

.sidebar-bots-empty {
  margin: 0;
  padding: 2px 4px 6px;
  color: var(--text-4);
  font-size: --font-xs;
  line-height: 1.5;
}

.bot-avatar {
  position: relative;
  width: 22px;
  height: 22px;
  flex: 0 0 auto;

  svg {
    display: block;
    border-radius: 50%;
  }

  &.large {
    width: 40px;
    height: 40px;
  }
}

.bot-item-indicator {
  grid-column: 2;
  grid-row: 1;
  justify-self: center;
  width: 26px;
  height: 26px;
  display: grid;
  place-items: center;
  pointer-events: none;
  transition: opacity 180ms var(--base-transition);
}

.bot-item:hover .bot-item-indicator,
.bot-item.menu-open .bot-item-indicator,
.bot-item:has(> .icon-button:focus-visible) .bot-item-indicator {
  opacity: 0;
}

.sidebar .bot-item > .icon-button:focus-visible {
  opacity: .4;
  pointer-events: auto;
}

.bot-status-dot {
  width: 9px;
  height: 9px;
  border: 2px solid var(--background-2);
  border-radius: 999px;

  &.active {
    background: var(--success-color, var(--text-2));
  }

  &.disabled {
    background: var(--text-4);
  }
}

.bot-status-sleep {
  color: var(--text-4);
}

.bot-queue-badge {
  min-width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
  padding: 0 4px;
  color: var(--text-5);
  background: var(--danger-color);
  border-radius: 999px;
  font-size: --font-xs;
  font-weight: 600;
}

.agent-thread-icon {
  flex: 0 0 auto;
  color: var(--text-4);
}

.bot-model-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 0 8px;
  color: var(--text-3);
  font-size: --font-sm;
  white-space: nowrap;
}

.bot-queue {
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  display: grid;
  grid-template-rows: auto auto minmax(0, 1fr);
  align-content: start;
  gap: 8px;
  padding: 10px;
}

.bot-work-selector {
  min-width: 0;
  display: block;

  select {
    width: min(200px, 100%);
    min-width: 0;
    padding: 4px 8px !important;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 32px;
    font-family: inherit;
    font-size: --font-md;

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }
}

.bot-work-tabs {
  display: flex;
  gap: 4px;
  overflow-x: auto;
  padding-bottom: 2px;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 7px;
    font-size: --font-sm;
    font-weight: 500;

    small {
      min-width: 16px;
      padding: 1px 4px;
      color: var(--text-4);
      background: var(--background-3);
      border-radius: 999px;
      font-size: --font-xs;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);

      small {
        color: var(--text-2);
      }
    }
  }
}

.bot-work-view {
  width: 100%;
  min-width: 0;
  min-height: 0;
  overflow-x: hidden;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 8px;
  scrollbar-gutter: stable;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  &::-webkit-scrollbar {
    width: 10px;
  }

  &::-webkit-scrollbar-track {
    background: transparent;
  }

  &::-webkit-scrollbar-thumb {
    min-height: 44px;
    background: var(--text-4);
    background-clip: padding-box;
    border: 3px solid transparent;
    border-radius: 999px;
  }

  &:hover::-webkit-scrollbar-thumb {
    background: var(--text-3);
    background-clip: padding-box;
  }

  &::-webkit-scrollbar-button {
    width: 0;
    height: 0;
    display: none;
  }
}

.bot-queue-empty {
  display: grid;
  justify-items: center;
  gap: 6px;
  padding: 40px 10px;
  color: var(--text-4);
  text-align: center;

  strong {
    color: var(--text-2);
    font-size: --font-md;
  }

  span {
    font-size: --font-sm;
  }
}

.bot-work-dialog {
  width: min(1100px, calc(100vw - 60px));
  max-width: none;
  max-height: min(760px, 88vh);
  margin: auto;
  padding: 0;
  grid-template-rows: auto minmax(0, 1fr);
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);
  font-size: --font-md;

  &[open] {
    display: grid;
  }

  &::backdrop {
    background: rgb(0 0 0 / 58%);
    backdrop-filter: blur(10px);
  }

  > .dialog-header {
    align-items: center;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;

      > h2 {
        overflow: hidden;
        margin: 0;
        color: var(--text-1);
        font-size: inherit;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      > p {
        margin: 2px 0 0;
        color: var(--text-2);
        font-size: inherit;
      }
    }

    .bot-work-actions-trigger {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 10px;
      font-size: --font-sm;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 6px;

      &:hover {
        background: var(--item-hover);
      }
    }
  }

  > .bot-work-dialog-content {
    min-height: 0;
    overflow: auto;
    display: grid;
    gap: 14px;
    padding: 18px;
    color: var(--text-1);
    overflow-wrap: anywhere;
    scrollbar-width: thin;
    scrollbar-color: var(--text-4) transparent;

    > .bot-work-detail-fields {
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      gap: 14px 8px;
      margin: 0;
      line-height: 1.4;

      > dt {
        min-width: 0;
        color: var(--text-2);
        overflow-wrap: anywhere;
      }

      > dd {
        min-width: 0;
        display: grid;
        gap: 3px;
        margin: 0;
        color: inherit;
        overflow-wrap: anywhere;
      }
    }
  }

  @media (max-width: 700px) {
    width: 100%;
    height: 100%;
    max-height: none;
    border: 0;
    border-radius: 0;
  }
}

.bot-work-status-dialog {
  width: min(420px, calc(100vw - 48px));
  margin: auto;
  padding: 16px;
  color: var(--text-1);
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);

  &::backdrop {
    background: rgb(0 0 0 / .24);
  }

  > .dialog-header {
    align-items: center;
    margin-bottom: 12px;

    > div {
      min-width: 0;

      > h2 {
        overflow: hidden;
        margin: 0;
        font-size: inherit;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      > p {
        overflow: hidden;
        margin: 2px 0 0;
        color: var(--text-2);
        font-size: --font-sm;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }
  }

  > .bot-work-status-options {
    display: grid;
    gap: 6px;

    > .bot-work-status-option {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      padding: 8px 10px;
      text-align: left;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 8px;

      &:hover:not(:disabled) {
        background: var(--item-hover);
      }

      &.current {
        background: var(--item-active);
      }

      &:disabled {
        opacity: .55;
      }

      > .bot-work-state {
        padding: 1px 5px;
        color: var(--text-2);
        background: var(--background-3);
        border-radius: 999px;
        font-weight: 600;
        text-transform: capitalize;

        &.active {
          color: var(--success-color, var(--text-2));
        }

        &.waiting {
          color: var(--warning-color, var(--text-2));
        }
      }

      > small {
        color: var(--text-3);
      }
    }
  }

  > .bot-work-status-error {
    margin: 10px 0 0;
    color: var(--danger-color, var(--text-2));
    font-size: --font-sm;
  }
}

.bot-work-overview,
.bot-all-work {
  min-width: 0;
  display: grid;
  align-content: start;
  gap: 2em;
}

.bot-all-work .bot-work-card + .bot-work-card {
  border-top: 5px solid --border-color;
  padding-top: 1em;
}

.bot-work-section {
  min-width: 0;
  display: grid;
  gap: 8px;

  > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px solid --border-color;
    padding-bottom: .5em;
    gap: 8px;
    color: var(--text-2);

    > div {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    strong {
      font-size: --font-lg;
      font-weight: 600;
    }

    small {
      min-width: 18px;
      padding: 1px 5px;
      color: var(--text-4);
      background: var(--background-3);
      border-radius: 999px;
      font-size: --font-xs;
      text-align: center;
    }
  }
}

.bot-work-section-empty {
  margin: 0;
  color: var(--text-4);
  border-radius: 8px;
  font-size: --font-sm;
}

.bot-work-warning {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  padding: 9px 10px;
  color: var(--warning-color, var(--text-2));
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  font-size: --font-xs;
  line-height: 1.45;

  svg {
    flex: 0 0 auto;
    margin-top: 1px;
  }
}

.bot-work-card {
  position: relative;
  min-width: 0;
  display: grid;
  gap: 6px;
  color: var(--text-1);
  line-height: 1.5;

  &:not(.expanded) {
    font-size: --font-sm;
  }

  &.expanded {
    border: 0;
    opacity: 1;

    > .bot-work-open {
      display: none;
    }

    .markdown-body {
      line-height: 1.6;
    }
  }

  &.needs-attention {
    border-left: 3px solid var(--warn-color, var(--text-2));
    padding-left: .75em;
  }

  &.state-completed:not(.expanded),
  &.state-cancelled:not(.expanded) {
    opacity: .82;
  }

  &.completed,
  &.up-next {
    gap: 4px;
    opacity: 1;
  }

  > header {
    min-width: 0;
    display: grid;
    gap: 2px;
    padding-right: 28px;

    > .bot-work-card-heading {
      min-width: 0;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 5px;
      padding-right: 2px;

      > strong {
        min-width: 0;
        flex: 1 1 160px;
        overflow-wrap: anywhere;
      }

      > .bot-work-state,
      > .bot-work-priority {
        flex: 0 0 auto;
        padding: 1px 5px;
        color: var(--text-2);
        background: var(--background-3);
        border-radius: 999px;
        font-weight: 600;
        text-transform: capitalize;

        &.active {
          color: var(--success-color, var(--text-2));
        }

        &.waiting,
        &.critical,
        &.high {
          color: var(--warning-color, var(--text-2));
        }
      }
    }

    > small {
      color: var(--text-2);
      font-size: inherit;
    }
  }

  > .bot-work-open {
    position: absolute;
    top: 7px;
    right: 7px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-2);
    background: transparent;
    border: 0;
    border-radius: 6px;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }

  > .bot-work-card-body {
    min-width: 0;
    display: grid;
    gap: 6px;

    &.clamped {
      position: relative;
      max-height: 300px;
      overflow: hidden;

      &::after {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        height: 44px;
        background: linear-gradient(to top, var(--background-1) 30%, transparent);
        content: '';
        pointer-events: none;
      }
    }

    > .bot-work-expand {
      position: absolute;
      right: 8px;
      bottom: 8px;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 9px;
      color: var(--text-2);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 6px;

      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .markdown-body {
    font-size: inherit;
    line-height: inherit;

    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    small {
      font-size: inherit;
    }

    code,
    pre {
      font-family: inherit;
      font-size: inherit;
    }

    p,
    ul,
    ol {
      margin: 0 0 6px;
    }
  }

  .bot-markdown-body {
    color: inherit;

    > h2 {
      margin: 1.25em 0 .5em;
      padding-bottom: .25em;
      border-bottom: 2px solid --border-color;
      font-size: inherit;
      font-weight: 600;
    }

    p {
      margin: 0;
    }

    + .bot-work-fields {
      margin-top: 2em;
      padding-top: 1em;
      border-top: 2px solid --border-color;
    }
  }

  .bot-work-fields,
  .bot-approval-details dl {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 4px 8px;
    margin: 0;
    line-height: 1.4;

    dt {
      min-width: 0;
      color: var(--text-2);
      overflow-wrap: anywhere;
    }

    dd {
      min-width: 0;
      margin: 0;
      color: inherit;
      overflow-wrap: anywhere;
    }
  }

  .bot-evidence-list {
    display: grid;
    gap: .5em;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      margin: 0;
    }

    a,
    button {
      padding: 0;
      color: var(--link-color);
      background: none;
      border: 0;
      font: inherit;
      text-align: left;
      text-decoration: none;
      overflow-wrap: anywhere;
      cursor: pointer;

      &:hover {
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 2px;
      }
    }
  }

  .bot-work-notice {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    padding: 8px;
    background: var(--background-2);
    border-radius: 7px;
    line-height: 1.4;
    margin-left: 140px;

    svg {
      flex: 0 0 auto;
      margin-top: 1px;
      color: --warn-color;
    }

    span {
      min-width: 0;
      display: grid;
      gap: 2px;
      overflow-wrap: anywhere;
    }

    strong {
      text-transform: capitalize;
      color: --warn-color;
    }

    &.attention {
      color: var(--warning-color, var(--text-2));
    }

    &.blocker {
      color: var(--danger-color, var(--text-2));
    }
  }

  .bot-work-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;

    code,
    .bot-worker-chip {
      max-width: 100%;
      overflow: hidden;
      padding: 3px 6px;
      color: var(--text-2);
      background: var(--background-3);
      border-radius: 5px;
      font: inherit;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .bot-worker-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;

    > span {
      width: 6px;
      height: 6px;
      background: var(--text-4);
      border-radius: 999px;
    }

    &.running > span {
      background: var(--success-color, var(--text-2));
    }

    &.needs-attention > span,
    &.missing > span {
      background: var(--warning-color, var(--text-2));
    }
  }

  .bot-approval-details {
    display: grid;
    gap: 7px;
    padding-top: 7px;
    border-top: 1px solid var(--border-color);

    p {
      margin: 0;
      color: inherit;
    }

    pre {
      max-height: 180px;
      overflow: auto;
      margin: 0;
      padding: 8px;
      color: inherit;
      background: var(--background-2);
      border-radius: 6px;
      font: inherit;
      white-space: pre-wrap;
    }
  }
}

.bot-work-filter {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--text-4);
  font-size: --font-xs;

  select {
    padding: 4px 8px !important;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: inherit;
    font-size: --font-xs;
  }
}

.bot-activity-list {
  display: grid;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;

  &.standalone {
    padding-right: 2px;
  }

  li {
    position: relative;
    display: grid;
    grid-template-columns: 12px minmax(0, 1fr);
    gap: 8px;
    padding: 0 0 13px;

    &:not(:last-child)::before {
      position: absolute;
      top: 9px;
      bottom: 0;
      left: 3px;
      width: 1px;
      background: var(--border-color);
      content: '';
    }

    > div {
      min-width: 0;
      display: grid;
      gap: 3px;
      overflow-wrap: anywhere;
    }

    strong {
      color: var(--text-2);
      font-size: --font-md;
    }

    p {
      margin: 0;
      color: var(--text-3);
      font-size: --font-sm;
      line-height: 1.45;
    }

    small {
      color: var(--text-4);
      font-size: --font-sm;
      text-transform: capitalize;
    }
  }
}

.bot-activity-dot {
  position: relative;
  z-index: 1;
  width: 7px;
  height: 7px;
  margin-top: 6px;
  background: var(--text-4);
  border-radius: 999px;

  &.completed {
    background: var(--success-color, var(--text-2));
  }

  &.blocked,
  &.attention,
  &.failure {
    background: var(--warning-color, var(--text-2));
  }
}

.bot-queue-actions {
  display: flex;
  gap: 6px;

  button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    font-size: --font-sm;
    border-radius: 6px;
    border: 1px solid var(--border-color);
    background: var(--background-2);
    color: var(--text-1);

    &:hover {
      background: var(--item-hover);
    }
  }

  .bot-queue-approve {
    color: var(--success-color, var(--text-2));
  }

  .bot-queue-deny {
    color: var(--danger-color, var(--text-2));
  }
}

.bot-settings-backdrop {
  display: grid;
  place-items: center;
}

.bot-settings-dialog {
  width: min(1200px, calc(100vw - 48px));
  height: min(640px, calc(100vh - 64px));
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  overflow: hidden;
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  box-shadow: 0 24px 64px rgb(0 0 0 / .42);

  > .dialog-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
    }

    h2 {
      overflow: hidden;
      margin: 0;
      color: var(--text-1);
      font-size: --font-md;
      font-weight: 600;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    p {
      margin: 2px 0 0;
      color: var(--text-3);
      font-size: --font-xs;
    }
  }

  > .dialog-footer {
    min-height: 64px;
    justify-content: flex-end;
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border-color);

    > div {
      display: flex;
      gap: 8px;
    }

    button:disabled {
      opacity: .55;
      cursor: wait;
    }
  }

  @media (max-width: 700px) {
    width: 100%;
    height: 100%;
    max-height: none;
    border: 0;
    border-radius: 0;

    > .dialog-header,
    > .dialog-footer {
      padding-inline: 16px;
    }
  }
}

.bot-settings-header-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  color: var(--text-2);
  background: var(--background-3);
  border-radius: 8px;
}

.bot-settings-workspace {
  min-height: 0;
  display: grid;
  grid-template-columns: 176px minmax(0, 1fr);

  @media (max-width: 700px) {
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
  }
}

.bot-settings-tabs {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;

  .bot-settings-tab {
    min-width: 0;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 8px;
    text-align: left;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    > svg {
      justify-self: center;
    }

    > span {
      min-width: 0;
      display: grid;
      gap: 1px;
    }

    strong {
      color: inherit;
      font-size: --font-sm;
      font-weight: 500;
    }

    small {
      overflow: hidden;
      color: var(--text-4);
      font-size: --font-xs;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);

      small {
        color: var(--text-3);
      }
    }
  }

  @media (max-width: 700px) {
    overflow-x: auto;
    flex-direction: row;
    gap: 2px;
    padding: 8px 12px;
    border-right: 0;
    border-bottom: 1px solid var(--border-color);
    scrollbar-width: none;

    .bot-settings-tab {
      flex: 1 0 auto;
      display: flex;
      justify-content: center;
      padding: 8px 10px;

      small {
        display: none;
      }
    }
  }
}

.bot-settings-body {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  padding: 0 24px;
  outline: 0;
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  > .bot-settings-section {
    padding: 24px 0;

    &:not(:first-child) {
      border-top: 1px solid var(--border-color);
    }
  }

  input:not([type="checkbox"]):not([type="radio"]),
  select,
  textarea {
    width: 100%;
    min-width: 0;
    padding: 9px 10px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-family: inherit;
    font-size: --font-sm;
    transition: border-color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    &:hover {
      border-color: var(--text-4);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
      background: var(--background-0);
    }

    &[readonly] {
      color: var(--text-3);
    }
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 36px;
    padding: 8px 11px;
    color: var(--text-2);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: --font-sm;
    cursor: pointer;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition),
      border-color 140ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &:active {
      background: var(--item-active);
    }

    &.danger {
      color: var(--danger-color, var(--text-1));
    }
  }

  @media (max-width: 700px) {
    padding-inline: 20px;
  }
}

.bot-settings-section {
  display: grid;
  gap: 16px;

  > header {
    display: grid;
    gap: 4px;

    h3 {
      margin: 0;
      color: var(--text-1);
      font-size: --font-md;
      font-weight: 550;
    }

    p {
      max-width: 520px;
      margin: 0;
      color: var(--text-3);
      font-size: --font-sm;
      line-height: 1.5;
    }
  }
}

.bot-settings-control {
  min-width: 0;
  display: grid;
  gap: 6px;

  > span:first-child {
    color: var(--text-2);
    font-size: --font-sm;
    font-weight: 500;
  }

  > small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.45;
  }

  &.grow {
    flex: 1;
  }

  textarea {
    min-height: 144px;
    resize: vertical;
    line-height: 1.5;
  }
}

.bot-settings-work-queue {
  display: grid;
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.bot-settings-work-queue-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  align-items: center;
  padding: 8px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;

  > .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
}

.bot-settings-work-queue-actions {
  display: flex;
  gap: 2px;

  > button {
    width: 28px;
    height: 28px;
    min-height: 28px;
    padding: 0;
  }
}

.bot-settings-work-queue-empty {
  margin: 0;
  padding: 14px;
  color: var(--text-4);
  background: var(--background-1);
  border: 1px dashed var(--border-color);
  border-radius: 10px;
  font-size: --font-sm;
}

.bot-settings-work-queue-add {
  justify-self: start;
}

.bot-settings-hint {
  color: var(--text-4);
  font-size: --font-xs;
  line-height: 1.45;
}

.bot-settings-profile {
  display: flex;
  align-items: center;
  gap: 16px;
}

.bot-settings-avatar {
  flex: 0 0 auto;
  display: grid;
  justify-items: center;
  gap: 8px;

  .bot-avatar.large {
    width: 48px;
    height: 48px;
  }

  button {
    min-height: 28px;
    padding: 4px 8px;
  }
}

.bot-settings-folder {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  gap: 8px;
}

.bot-settings-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.bot-settings-mcp {
  > .bot-settings-mcp-empty {
    margin: 0;
    color: var(--text-3);
    font-size: --font-sm;
  }
}

.bot-settings-mcp-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;

  > .bot-settings-mcp-path {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-4);
    font-size: --font-xs;
  }
}

.bot-settings-dialog .bot-settings-mcp-scope {
  display: block;
  grid-column: auto;
  min-height: 0;
  overflow: visible;
  background: transparent;

  .mcp-scope-heading {
    display: grid;
    gap: 2px;
    padding: 8px 12px 4px;

    strong {
      color: var(--text-2);
      font-size: --font-sm;
      font-weight: 550;
    }

    small {
      color: var(--text-4);
      font-size: --font-xs;
    }
  }

  .mcp-server-main {
    width: 100%;
    min-height: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    justify-content: normal;
    padding: 10px 8px 10px 12px;
    background: transparent;
    border: 0;
    text-align: left;
  }

  .mcp-server-actions {
    min-width: max-content;
  }

  .mcp-server-actions > .icon-button {
    width: 28px;
    height: 28px;
    min-height: 28px;
    display: inline-grid;
    place-items: center;
    gap: 0;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border: 0;
    border-radius: 999px;

    > svg {
      flex: none;
      margin: 0;
    }
  }
}

.bot-settings-context-size {
  max-width: 280px;
}

.bot-settings-period {
  max-width: 220px;
}

.bot-settings-number-unit {
  display: grid;
  grid-template-columns: 72px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  color: var(--text-3);
  font-size: --font-sm;
}

.bot-settings-choices {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
  padding: 0;
  border: 0;
}

.bot-settings-choice {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 140ms var(--base-transition),
    background 140ms var(--base-transition);

  > input {
    margin-top: 2px;
  }

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  &:hover {
    background: var(--item-hover);
  }

  &:focus-within {
    outline: 2px solid var(--text-3);
    outline-offset: 1px;
  }

  &.active {
    border-color: var(--text-3);
    background: var(--item-active);
  }
}

.bot-settings-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 4px 0;
  cursor: pointer;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  > input {
    flex: 0 0 auto;
  }
}

.bot-settings-inline-detail {
  grid-template-columns: minmax(0, 1fr) 88px;
  align-items: center;
  padding: 12px;
  background: var(--background-1);
  border-radius: 8px;

  > input {
    grid-column: 2;
    grid-row: 1;
  }
}

.bot-settings-window {
  display: grid;
  gap: 16px;
  padding: 16px;
  background: var(--background-1);
  border-radius: 10px;

  input:not([type="checkbox"]):not([type="radio"]),
  select,
  textarea,
  button {
    background: var(--background-2);
  }

  > small {
    color: var(--text-4);
    font-size: --font-xs;
  }
}

.bot-settings-days {
  display: grid;
  grid-template-columns: repeat(7, minmax(40px, 1fr));
  gap: 6px;

  .bot-settings-day {
    min-width: 0;
    min-height: 40px;
    padding: 0 4px;

    &.active {
      color: var(--text-1);
      border-color: var(--text-3);
      background: var(--item-active);
    }
  }
}

.bot-settings-path {
  font-family: var(--font-code) !important;
  font-size: --font-xs !important;
}

.bot-settings-danger-zone {
  > header h3 {
    color: var(--danger-color, var(--text-1));
  }
}

.bot-settings-danger-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;

  > span {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  strong {
    color: var(--text-1);
    font-size: --font-sm;
    font-weight: 500;
  }

  small {
    color: var(--text-4);
    font-size: --font-xs;
    line-height: 1.4;
  }

  > button {
    flex: 0 0 auto;
  }
}

.bot-settings-error {
  margin: 0;
  padding: 10px 20px;
  color: var(--danger-color, var(--text-1));
  background: var(--background-1);
  border-top: 1px solid var(--border-color);
  font-size: --font-sm;
}

@media (max-width: 540px) {

  .bot-settings-profile,
  .bot-settings-danger-action {
    align-items: stretch;
    flex-direction: column;
  }

  .bot-settings-avatar {
    justify-items: start;
  }

  .bot-settings-folder,
  .bot-settings-grid,
  .bot-settings-choices,
  .bot-settings-work-queue-item {
    grid-template-columns: minmax(0, 1fr);
  }

  .bot-settings-work-queue-actions {
    justify-content: flex-end;
  }

  .bot-settings-folder input {
    grid-column: 1 / -1;
  }

  .bot-settings-danger-action > button {
    align-self: start;
  }

  .bot-settings-days {
    grid-template-columns: repeat(4, minmax(44px, 1fr));
  }
}