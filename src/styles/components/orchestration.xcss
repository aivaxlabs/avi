.orchestration-page {
  min-width: 0;
  height: 100%;
  overflow: auto;
  padding: 72px clamp(24px, 5vw, 72px) 48px;
    background: var(--background-1);
  color: var(--text-1);
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  .orchestration-header {
    max-width: 1180px;
    position: relative;
    margin: 0 auto 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .orchestration-eyebrow {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 6px 0 4px;
    color: var(--text-1);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 620;
    letter-spacing: -.035em;
  }

  .orchestration-header p {
    margin: 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .orchestration-range-trigger,
  .orchestration-refresh {
    min-height: 32px;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .orchestration-range-trigger {
    margin-left: auto;
    padding: 6px 10px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-weight: 500;
    transition: background 160ms var(--base-transition),
      border-color 160ms var(--base-transition);

    &:hover,
    &[aria-expanded="true"] {
      color: var(--text-1);
      background: var(--background-3);
      border-color: var(--text-4);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }
  }

  .orchestration-range-popover {
    width: min(500px, calc(100vw - 40px));
    position: absolute;
    z-index: 20;
    top: calc(100% + 10px);
    right: 92px;
    padding: 12px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, .24);
  }

  .orchestration-range-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);

    > svg {
      margin-bottom: 9px;
      color: var(--text-4);
    }

    label {
      min-width: 0;
      display: grid;
      gap: 6px;
    }

    label > span {
      color: var(--text-3);
      font-size: 11px;
      font-weight: 600;
    }

    input {
      min-width: 0;
      width: 100%;
      height: 34px;
      padding: 0 8px;
      color: var(--text-1);
      color-scheme: dark;
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font: inherit;
      font-size: 12px;

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .orchestration-range-presets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    padding-top: 12px;

    button {
      min-height: 34px;
      padding: 7px 10px;
      color: var(--text-2);
      background: transparent;
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font-size: 12px;
      font-weight: 520;
      text-align: left;
      transition: background 140ms var(--base-transition),
        border-color 140ms var(--base-transition);

      &:hover,
      &.active {
        color: var(--text-1);
        background: var(--item-hover);
        border-color: var(--text-4);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .orchestration-refresh {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: var(--background-0);
    background: var(--text-1);
    border-radius: 999px;
    font-weight: 500;
    transition: background 160ms var(--base-transition),
      transform 160ms var(--base-transition);

    &:hover:not(:disabled) {
      background: var(--text-2);
    }

    &:active:not(:disabled) {
      transform: scale(.97);
    }

    &:disabled {
      color: var(--background-1);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }
  }

  .spinning {
    animation: orchestration-spin 900ms linear infinite;
  }

  .orchestration-tabs {
    max-width: 1180px;
    margin: 0 auto 28px;
    display: flex;
    gap: 4px;

    button {
      position: relative;
      padding: 6px 12px;
      color: var(--text-3);
      background: transparent;
      font-size: 13px;
      font-weight: 570;
      transition: color 160ms var(--base-transition),
        background 160ms var(--base-transition);


      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &[aria-selected="true"] {
        color: var(--text-1);
        background-color: --background-4;
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: -2px;
      }
    }
  }

  .token-overview {
    max-width: 1180px;
    margin: 0 auto 28px;
    display: grid;
    grid-template-columns: minmax(220px, .85fr) minmax(0, 2fr);
    border-block: 1px solid var(--border-color);
  }

  .token-overview-total {
    min-width: 0;
    display: grid;
    align-content: center;
    gap: 6px;
    padding: 26px 30px 26px 0;
    border-right: 1px solid var(--border-color);

    > span,
    small {
      color: var(--text-3);
      font-size: 12px;
    }

    > span {
      font-weight: 620;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-size: clamp(36px, 5vw, 54px);
      font-weight: 600;
      letter-spacing: -.045em;
      line-height: 1;
      text-overflow: ellipsis;
    }
  }

  .token-overview-cost {
    display: flex;
    align-items: baseline;
    gap: 7px;
    margin-top: 4px;

    > span {
      color: var(--text-3);
      font-size: 12px;
      font-weight: 620;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    > strong {
      color: var(--text-1);
      font-size: 18px;
      font-weight: 620;
      letter-spacing: -.02em;
    }
  }

  .token-overview-metrics {
    min-width: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    div {
      min-width: 0;
      display: grid;
      align-content: center;
      gap: 7px;
      padding: 24px;

      + div {
        border-left: 1px solid var(--border-color);
      }
    }

    dt {
      overflow: hidden;
      color: var(--text-3);
      font-size: 12px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    dd {
      margin: 0;
      overflow: hidden;
      color: var(--text-1);
      font-size: clamp(20px, 2.4vw, 28px);
      font-weight: 590;
      font-variant-numeric: tabular-nums;
      letter-spacing: -.025em;
      text-overflow: ellipsis;
    }
  }

  .orchestration-grid {
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    gap: 2em;
    margin: 0 auto;
  }

  .orchestration-section {
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
  }

  .orchestration-section-heading {
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    h2 {
      margin: 0;
      color: var(--text-1);
      font-size: 14px;
      font-weight: 620;
    }

    .section-icon {
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      display: grid;
      place-items: center;
      color: var(--text-3);
      background: var(--background-3);
      border-radius: 8px;

      &.active {
        color: var(--text-1);
        background: var(--item-active);
      }

      &.attention {
        color: var(--text-2);
        background: var(--background-3);
      }
    }
  }

  .section-count,
  .section-caption {
    color: var(--text-3);
    font-size: 12px;
  }

  .section-count {
    min-width: 24px;
    padding: 3px 7px;
    background: var(--background-3);
    border-radius: 999px;
    text-align: center;
  }

  .task-list {
    min-height: 196px;
    display: grid;
    align-content: start;
    padding: 6px;
  }

  .task-row {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 10px;
    color: inherit;
    background: transparent;
    border-radius: 9px;
    text-align: left;
    transition: background 160ms var(--base-transition),
      transform 160ms var(--base-transition);

    &:hover {
      background: var(--item-hover);
    }

    &:active {
      transform: scale(.995);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }

  .task-status-dot {
    width: 7px;
    height: 7px;
    border: 1px solid var(--text-3);
    border-radius: 999px;

    &.live {
      border-color: var(--text-1);
      background: var(--text-1);
      box-shadow: 0 0 0 4px var(--text-4);
    }

    &.attention {
      border-color: var(--text-2);
      background: var(--text-3);
    }
  }

  .task-copy,
  .task-meta {
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .task-copy {

    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-weight: 580;
    }

    span {
      color: var(--text-3);
      font-size: .9rem;
    }
  }

  .task-meta {
    justify-items: end;

    strong {
      color: var(--text-2);
      font-weight: 570;
    }

    span {
      color: var(--text-4);
      font-size: .85rem;
    }
  }

  .daily-token-section,
  .model-usage-section {
    grid-column: 1 / -1;
  }

  .usage-breakdown-grid {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2em;
  }

  .usage-breakdown-list {
    min-height: 184px;
    display: grid;
    align-content: start;
  }

  .usage-breakdown-row {
    min-width: 0;
    display: grid;
    gap: 11px;
    padding: 15px 16px;

    + .usage-breakdown-row {
      border-top: 1px solid var(--border-color);
    }
  }

  .usage-breakdown-content {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .usage-breakdown-track {
    height: 3px;
    overflow: hidden;
    background: var(--text-4);
    border-radius: 999px;

    > span {
      display: block;
      height: 100%;
      background: var(--primary-color);
      border-radius: inherit;
    }
  }

  .usage-breakdown-copy,
  .usage-breakdown-value {
    min-width: 0;
    display: grid;
    gap: 3px;
  }

  .usage-breakdown-copy {
    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-size: 14px;
      font-weight: 580;
    }

    span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  .usage-breakdown-value {
    flex: 0 0 auto;
    justify-items: end;

    strong {
      color: var(--text-1);
      font-size: 16px;
      font-weight: 620;
      font-variant-numeric: tabular-nums;
    }

    span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  .daily-token-heading {
    min-height: 68px;
    align-items: flex-start;
  }

  .daily-token-title {
    min-width: 0;
    display: grid;
    gap: 3px;

    > span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  .daily-token-legend {
    min-width: 0;
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    padding: 20px 0 0 64px;
  }

  .daily-token-legend-item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-3);
    font-size: 12px;

    > span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .daily-token-legend-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    background: var(--chart-color);
    border-radius: 2px;
  }

  .daily-token-chart {
    min-height: 340px;
    padding: 34px 16px 22px;
  }

  .daily-token-chart-layout {
    --daily-token-chart-height: 240px;
    min-width: 0;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 12px;
  }

  .daily-token-y-axis {
    height: var(--daily-token-chart-height);
    position: relative;

    span {
      position: absolute;
      right: 0;
      color: var(--text-4);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      transform: translateY(-50%);
      white-space: nowrap;
    }
  }

  .daily-token-plot {
    min-width: 0;
    position: relative;

    svg {
      width: 100%;
      height: var(--daily-token-chart-height);
      display: block;
      overflow: visible;
    }
  }

  .daily-token-grid line {
    stroke: var(--border-color);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .daily-token-bar rect {
    shape-rendering: geometricPrecision;
  }

  .daily-token-x-axis {
    height: 24px;
    position: relative;
    margin-top: 9px;

    span {
      position: absolute;
      top: 0;
      color: var(--text-4);
      font-size: 11px;
      white-space: nowrap;
      transform: translateX(-50%);

      &.start {
        transform: none;
      }

      &.end {
        transform: translateX(-100%);
      }
    }
  }

  .model-token-chart {
    padding: 32px 16px 28px;
    border-bottom: 1px solid var(--border-color);
  }

  .model-token-chart-layout {
    --model-token-chart-height: 240px;
    min-width: 0;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 12px;
  }

  .model-token-y-axis {
    height: var(--model-token-chart-height);
    position: relative;

    span {
      position: absolute;
      right: 0;
      color: var(--text-4);
      font-size: 11px;
      font-variant-numeric: tabular-nums;
      line-height: 1;
      transform: translateY(-50%);
      white-space: nowrap;
    }
  }

  .model-token-plot {
    min-width: 0;
    position: relative;

    svg {
      width: 100%;
      height: var(--model-token-chart-height);
      display: block;
      overflow: visible;
    }

    path {
      opacity: .86;
      stroke: var(--background-1);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
  }

  .model-token-grid line {
    stroke: var(--border-color);
    stroke-dasharray: 3 4;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .model-token-x-axis {
    height: 24px;
    position: relative;
    margin-top: 9px;

    span {
      position: absolute;
      top: 0;
      color: var(--text-4);
      font-size: 11px;
      white-space: nowrap;
      transform: translateX(-50%);

      &.start {
        transform: none;
      }

      &.end {
        transform: translateX(-100%);
      }
    }
  }

  .model-token-legend {
    min-width: 0;
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 24px;
    padding: 24px 0 0 64px;
  }

  .model-token-legend-item {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--text-3);
    font-size: 12px;

    > span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .model-token-legend-dot {
    width: 9px;
    height: 9px;
    flex: 0 0 9px;
    background: var(--chart-color);
    border-radius: 50%;
  }

  .provider-usage-list {
    min-height: 184px;
    display: grid;
    align-content: start;
  }

  .provider-usage-group {
    min-width: 0;
    padding: 22px 16px;

    + .provider-usage-group {
      border-top: 1px solid var(--border-color);
    }
  }

  .provider-usage-header {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    > div:first-child {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 12px;

      > div {
        min-width: 0;
        display: grid;
        gap: 3px;
      }
    }

    h3 {
      margin: 0;
      overflow: hidden;
      color: var(--text-1);
      font-size: 16px;
      font-weight: 620;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  .provider-mark {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    color: var(--background-1);
    background: var(--text-1);
    border-radius: 50%;
    font-size: 13px;
    font-weight: 700;
  }

  .provider-token-total {
    flex: 0 0 auto;
    display: grid;
    justify-items: end;
    gap: 3px;

    strong {
      color: var(--text-1);
      font-size: 18px;
      font-weight: 620;
      font-variant-numeric: tabular-nums;
    }
  }

  .provider-usage-track {
    height: 4px;
    margin: 16px 0 6px 46px;
    overflow: hidden;
    background: var(--background-4);
    border-radius: 999px;

    span {
      display: block;
      height: 100%;
      background: var(--text-1);
      border-radius: inherit;
      transition: width 300ms var(--base-transition);
    }
  }

  .provider-model-list {
    margin-left: 46px;
  }

  .provider-model-row {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(150px, 1fr) minmax(380px, 1.8fr);
    align-items: center;
    gap: 24px;
    padding: 14px 0;

    + .provider-model-row {
      border-top: 1px solid var(--border-color);
    }
  }

  .provider-model-name {
    min-width: 0;
    display: grid;
    gap: 4px;

    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-size: 14px;
      font-weight: 570;
    }

    span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  .provider-model-pricing {
    color: var(--text-4) !important;
    font-variant-numeric: tabular-nums;
  }

  .provider-model-metrics {
    min-width: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(58px, 1fr));
    gap: 12px;

    div {
      min-width: 0;
      display: grid;
      gap: 4px;
      text-align: right;
    }

    dt {
      overflow: hidden;
      color: var(--text-4);
      font-size: 11px;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    dd {
      margin: 0;
      overflow: hidden;
      color: var(--text-2);
      font-size: 13px;
      font-weight: 570;
      font-variant-numeric: tabular-nums;
      text-overflow: ellipsis;
    }

    div:first-child dd {
      color: var(--text-1);
      font-weight: 640;
    }
  }

  .orchestration-empty {
    min-height: 184px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 9px;
    color: var(--text-3);
    font-size: 12px;
  }

  .orchestration-error {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 16px;
    color: var(--text-1);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 10px;
  }

  @media (max-width: 900px) {
    padding-inline: 20px;

    .orchestration-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .orchestration-range-trigger {
      margin-left: 0;
    }

    .orchestration-range-popover {
      top: 100%;
      right: 0;
    }

    .token-overview {
      grid-template-columns: 1fr;
    }

    .token-overview-total {
      padding-inline: 0;
      border-right: 0;
      border-bottom: 1px solid var(--border-color);
    }

    .orchestration-grid {
      grid-template-columns: 1fr;
    }

    .usage-breakdown-grid {
      grid-template-columns: 1fr;
    }

    .daily-token-section,
    .model-usage-section {
      grid-column: auto;
    }

    .daily-token-legend {
      padding-left: 64px;
    }

    .model-token-legend {
      padding-left: 64px;
    }

    .provider-model-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 620px) {
    padding-inline: 14px;

    .token-overview-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      div:nth-child(3) {
        border-left: 0;
      }

      div:nth-child(n + 3) {
        border-top: 1px solid var(--border-color);
      }
    }

    .orchestration-section-heading,
    .provider-usage-header {
      align-items: flex-start;
    }

    .section-caption {
      text-align: right;
    }

    .usage-breakdown-row {
      gap: 12px;
      padding-inline: 12px;
    }

    .daily-token-chart {
      padding-inline: 8px;
    }

    .daily-token-chart-layout {
      --daily-token-chart-height: 200px;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 8px;
    }

    .daily-token-legend {
      gap: 8px 16px;
      padding-left: 50px;
    }

    .model-token-chart {
      padding-inline: 8px;
    }

    .model-token-chart-layout {
      --model-token-chart-height: 200px;
      grid-template-columns: 42px minmax(0, 1fr);
      gap: 8px;
    }

    .model-token-legend {
      gap: 8px 16px;
      padding-left: 50px;
    }

    .provider-usage-group {
      padding-inline: 12px;
    }

    .provider-usage-track,
    .provider-model-list {
      margin-left: 0;
    }

    .provider-model-metrics {
      grid-template-columns: repeat(3, minmax(0, 1fr));

      div {
        text-align: left;
      }
    }
  }
}

@keyframes orchestration-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .orchestration-page {

    .orchestration-refresh,
    .orchestration-range-trigger,
    .orchestration-range-presets button,
    .orchestration-tabs button,
    .task-row,
    .provider-usage-track span {
      transition: none;
    }

    .spinning {
      animation: none;
    }
  }
}