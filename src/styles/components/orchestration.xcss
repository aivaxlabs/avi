.orchestration-page {
  min-width: 0;
  height: 100%;
  overflow: auto;
  padding: 72px clamp(24px, 5vw, 72px) 48px;
  color: var(--text-1);
  scrollbar-width: thin;
  scrollbar-color: var(--text-4) transparent;

  .orchestration-header {
    max-width: 1180px;
    position: relative;
    margin: 0 auto 28px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .orchestration-eyebrow {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 6px 0 4px;
    color: var(--text-1);
    font-size: clamp(28px, 3.2vw, 40px);
    font-weight: 620;
    letter-spacing: -.035em;
  }

  .orchestration-header p {
    margin: 0;
    color: var(--text-3);
    font-size: 14px;
  }

  .orchestration-range-trigger,
  .orchestration-refresh {
    min-height: 32px;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .orchestration-range-trigger {
    margin-left: auto;
    padding: 6px 10px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-weight: 500;
    transition: background 160ms var(--base-transition),
      border-color 160ms var(--base-transition);

    &:hover,
    &[aria-expanded="true"] {
      color: var(--text-1);
      background: var(--background-3);
      border-color: var(--text-4);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }
  }

  .orchestration-range-popover {
    width: min(500px, calc(100vw - 40px));
    position: absolute;
    z-index: 20;
    top: calc(100% + 10px);
    right: 92px;
    padding: 12px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, .24);
  }

  .orchestration-range-fields {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: end;
    gap: 10px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);

    > svg {
      margin-bottom: 9px;
      color: var(--text-4);
    }

    label {
      min-width: 0;
      display: grid;
      gap: 6px;
    }

    label > span {
      color: var(--text-3);
      font-size: 11px;
      font-weight: 600;
    }

    input {
      min-width: 0;
      width: 100%;
      height: 34px;
      padding: 0 8px;
      color: var(--text-1);
      color-scheme: dark;
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font: inherit;
      font-size: 12px;

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .orchestration-range-presets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    padding-top: 12px;

    button {
      min-height: 34px;
      padding: 7px 10px;
      color: var(--text-2);
      background: transparent;
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font-size: 12px;
      font-weight: 520;
      text-align: left;
      transition: background 140ms var(--base-transition),
        border-color 140ms var(--base-transition);

      &:hover,
      &.active {
        color: var(--text-1);
        background: var(--item-hover);
        border-color: var(--text-4);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .orchestration-refresh {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: var(--background-0);
    background: var(--text-1);
    border-radius: 999px;
    font-weight: 500;
    transition: background 160ms var(--base-transition),
      transform 160ms var(--base-transition);

    &:hover:not(:disabled) {
      background: var(--text-2);
    }

    &:active:not(:disabled) {
      transform: scale(.97);
    }

    &:disabled {
      color: var(--background-1);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }
  }

  .spinning {
    animation: orchestration-spin 900ms linear infinite;
  }

  .orchestration-tabs {
    max-width: 1180px;
    margin: 0 auto 28px;
    display: flex;
    gap: 4px;

    button {
      position: relative;
      padding: 6px 12px;
      color: var(--text-3);
      background: transparent;
      font-size: 13px;
      font-weight: 570;
      transition: color 160ms var(--base-transition),
        background 160ms var(--base-transition);


      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &[aria-selected="true"] {
        color: var(--text-1);
        background-color: --background-4;
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: -2px;
      }
    }
  }

  .orchestration-kpis {
    max-width: 1180px;
    margin: 0 auto 16px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2em;
  }

  .orchestration-kpi {
    min-width: 0;
    min-height: 104px;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr) auto;
    align-items: start;
    gap: 12px;

    .kpi-icon {
      width: 36px;
      height: 36px;
      display: grid;
      place-items: center;
      color: var(--text-1);
      background: var(--background-3);
      border-radius: 9px;
    }

    div {
      min-width: 0;
      display: grid;
      gap: 4px;
    }

    div > span,
    small {
      color: var(--text-3);
      font-size: 12px;
    }

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-size: 25px;
      font-weight: 620;
      letter-spacing: -.025em;
      text-overflow: ellipsis;
    }

    small {
      padding-top: 2px;
    }
  }

  .orchestration-grid {
    max-width: 1180px;
    display: flex;
    flex-direction: column;
    gap: 2em;
    margin: 0 auto;
  }

  .orchestration-section {
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
  }

  .orchestration-section-heading {
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-color);

    > div {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    h2 {
      margin: 0;
      color: var(--text-1);
      font-size: 14px;
      font-weight: 620;
    }

    .section-icon {
      width: 30px;
      height: 30px;
      flex: 0 0 30px;
      display: grid;
      place-items: center;
      color: var(--text-3);
      background: var(--background-3);
      border-radius: 8px;

      &.active {
        color: var(--text-1);
        background: var(--item-active);
      }

      &.attention {
        color: var(--text-2);
        background: var(--background-3);
      }
    }
  }

  .section-count,
  .section-caption {
    color: var(--text-3);
    font-size: 12px;
  }

  .section-count {
    min-width: 24px;
    padding: 3px 7px;
    background: var(--background-3);
    border-radius: 999px;
    text-align: center;
  }

  .task-list,
  .model-usage-list {
    min-height: 196px;
    display: grid;
    align-content: start;
    padding: 6px;
  }

  .task-row {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 10px;
    color: inherit;
    background: transparent;
    border-radius: 9px;
    text-align: left;
    transition: background 160ms var(--base-transition),
      transform 160ms var(--base-transition);

    &:hover {
      background: var(--item-hover);
    }

    &:active {
      transform: scale(.995);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }

  .task-status-dot {
    width: 7px;
    height: 7px;
    border: 1px solid var(--text-3);
    border-radius: 999px;

    &.live {
      border-color: var(--text-1);
      background: var(--text-1);
      box-shadow: 0 0 0 4px var(--text-4);
    }

    &.attention {
      border-color: var(--text-2);
      background: var(--text-3);
    }
  }

  .task-copy,
  .task-meta {
    min-width: 0;
    display: grid;
    gap: 4px;
  }

  .task-copy {

    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-weight: 580;
    }

    span {
      color: var(--text-3);
      font-size: .9rem;
    }
  }

  .task-meta {
    justify-items: end;

    strong {
      color: var(--text-2);
      font-weight: 570;
    }

    span {
      color: var(--text-4);
      font-size: .85rem;
    }
  }

  .model-usage-section {
    grid-column: 1 / -1;
  }

  .model-usage-list {
    min-height: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 25px;
    padding: 12px;
  }

  .model-usage-row {
    min-width: 0;
    display: grid;
    gap: 12px;
  }

  .model-usage-header {
    min-width: 0;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }

  .model-rank {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    color: var(--text-3);
    background: var(--background-3);
    border-radius: 7px;
    font-size: 11px;
    font-weight: 600;
  }

  .model-usage-copy {
    min-width: 0;
    display: grid;
    gap: 2px;

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-size: 1rem;
      font-weight: 580;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    span {
      color: var(--text-3);
      font-size: .9rem;
      font-weight: 500;
    }
  }

  .model-token-total {
    display: grid;
    justify-items: end;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 620;
    font-variant-numeric: tabular-nums;

    span {
      color: var(--text-4);
      font-size: .7rem;
      font-weight: 560;
      letter-spacing: .05em;
      text-transform: uppercase;
    }
  }

  .model-usage-track {
    height: 4px;
    overflow: hidden;
    background: var(--background-4);
    border-radius: 999px;

    span {
      display: block;
      height: 100%;
      background: var(--text-1);
      border-radius: inherit;
      transition: width 300ms var(--base-transition);
    }
  }

  .model-metrics {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: 8px;

    div {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    dt {
      overflow: hidden;
      color: var(--text-3);
      font-size: .85rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    dd {
      margin: 0;
      color: var(--text-2);
      font-size: .95rem;
      font-weight: 570;
      font-variant-numeric: tabular-nums;
    }
  }

  .orchestration-empty {
    min-height: 184px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 9px;
    color: var(--text-3);
    font-size: 12px;
  }

  .orchestration-error {
    max-width: 1180px;
    margin: 0 auto;
    padding: 14px 16px;
    color: var(--text-1);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 10px;
  }

  @media (max-width: 900px) {
    padding-inline: 20px;

    .orchestration-header {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .orchestration-range-trigger {
      margin-left: 0;
    }

    .orchestration-range-popover {
      top: 100%;
      right: 0;
    }

    .orchestration-kpis {
      grid-template-columns: 1fr;
    }

    .orchestration-grid {
      grid-template-columns: 1fr;
    }

    .model-usage-section {
      grid-column: auto;
    }

    .model-usage-list {
      grid-template-columns: 1fr;
    }
  }
}

@keyframes orchestration-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .orchestration-page {

    .orchestration-refresh,
    .orchestration-range-trigger,
    .orchestration-range-presets button,
    .orchestration-tabs button,
    .task-row,
    .model-usage-track span {
      transition: none;
    }

    .spinning {
      animation: none;
    }
  }
}