.attachment-list,
.attachment-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;

  > .attachment-pill,
  > .attachment-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: min(100%, 320px);
    min-width: 0;
    padding: 5px 7px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    font-size: 12px;

    .attachment-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      flex: 0 0 auto;
      color: var(--text-4);
    }

    &.context-marker {
      color: var(--text-1);
      height: 2em;

      svg {
        flex: 0 0 auto;
        color: var(--text-3);
      }
    }
  }

  > .attachment-chip {
    svg {
      flex: 0 0 auto;
    }

    button {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      color: var(--text-3);
      background: transparent;
    }
  }
}

.attachment-strip > .attachment-image {
  position: relative;
  width: 132px;
  margin: 0;
  overflow: hidden;
  color: var(--text-2);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 12px;

  img,
  video {
    width: 100%;
    height: 88px;
    display: block;
    object-fit: contain;
    background: var(--background-3);
  }

  &.attachment-video video {
    object-fit: cover;
  }

  figcaption {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px;
    padding: 5px 7px 6px;
    font-size: 10px;

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      color: var(--text-4);
    }
  }

  button {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-2);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    box-shadow: 0 1px 4px rgb(0 0 0 / 18%);
    transition: color 160ms var(--base-transition),
      background 160ms var(--base-transition),
      transform 160ms var(--base-transition);

    &:hover,
    &:focus-visible {
      color: var(--danger-color);
      background: var(--background-2);
    }

    &:active {
      transform: scale(.92);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .attachment-strip > .attachment-image button {
    transition: none;
  }
}