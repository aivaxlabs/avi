.attachment-list,
.attachment-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;

  .attachment-pill,
  .attachment-chip,
  .attachment-image {
    width: 180px;
    height: 40px;
    overflow: hidden;
    color: var(--text-2);
    font-size: --font-sm;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    margin: 0;

    button {
      flex: 0 0 auto;
      padding: 4px;
      margin-left: auto;
      display: grid;
      place-items: center;
      opacity: .6;
      background: transparent;

      > svg {
        color: --text-2;
        width: 13px;
        height: 13px;
      }

      & :hover {
        opacity: 1;
      }
    }
  }

  > .attachment-pill,
  > .attachment-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 8px;

    .attachment-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      color: var(--text-4);
    }

    & .context-marker {
      
      svg {
        flex: 0 0 auto;
        color: var(--text-3);
      }
    }
  }

  > .attachment-chip {

    > svg {
      flex: 0 0 auto;
    }
  }
}

.attachment-strip > .attachment-image {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 4px;

  img,
  video {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    display: block;
    object-fit: cover;
    outline: 1px solid --border-color;
    background: var(--background-3);
  }

  &.attachment-video video {
    object-fit: cover;
  }

  figcaption {
    min-width: 0;
    display: block;
    gap: 6px;
    padding: 5px 7px 6px;

    span {
      display: block;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: --font-sm;
      margin-bottom: -3px;
    }

    small {
      color: var(--text-4);
      font-size: --font-xs;
    }
  }
}

.user-bubble + .user-attachment-list {

  .attachment-pill {
    width: fit-content;
    max-width: 180px;
    height: auto;
    padding: 6px 10px;
    font-size: --font-sm;
    

    small {
      align-self: flex-end;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .attachment-strip > .attachment-image button {
    transition: none;
  }
}