.attachment-list,
.attachment-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-bottom: 8px;

  > .attachment-pill,
  > .attachment-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: min(100%, 320px);
    min-width: 0;
    padding: 5px 7px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    font-size: 12px;

    .attachment-name {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      flex: 0 0 auto;
      color: var(--text-4);
    }

    &.context-marker {
      color: var(--text-1);

      svg {
        flex: 0 0 auto;
        color: var(--text-3);
      }
    }
  }

  > .attachment-chip {
    svg {
      flex: 0 0 auto;
    }

    button {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      color: var(--text-3);
      background: transparent;
    }
  }
}
