.notes-panel {
  display: flex;
  flex-direction: column;
  min-height: 0;
  height: 100%;
  padding: 12px;
  gap: 8px;
  color: var(--text-1);
  font-size: 12px;

  > .notes-toolbar {
    display: flex;
    align-items: center;
    gap: 6px;

    > input {
      min-width: 0;
      flex: 1;
    }
  }

  > .notes-scope {
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-3);
    font-size: 11px;
  }

  > .notes-lists {
    flex: 1;
    overflow: auto;
    min-height: 0;
    padding-bottom: 180px;

    > .notes-list {
      border-bottom: 1px solid var(--border-color);
      padding: 8px 0;

      > .notes-list-heading {
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        min-height: 28px;

        > strong {
          flex: 1;
          min-width: 0;
          overflow-wrap: anywhere;
        }

        > span[draggable] {
          display: flex;
          cursor: grab;
          color: var(--text-3);
          opacity: .5;
        }

        > .notes-list-actions {
          display: flex;
          align-items: center;
          gap: 8px;
          flex: 0 0 auto;

          > button {
            white-space: nowrap;
            background-color: --background-2;
          }
        }
      }

      > .notes-items {
        list-style: none;
        padding: 0;
        margin: 0;

        > .notes-item {
          display: flex;
          align-items: flex-start;
          gap: 6px;
          padding: 9px 0;

          > .notes-grip {
            cursor: grab;
            color: var(--text-3);
            padding-top: 3px;
            opacity: .5;
          }

          > input {
            margin-top: 3px;
            flex: none;
          }

          > .notes-copy {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
            background: transparent;
            border: 0;
            padding: 0;
            text-align: left;
            color: inherit;

            > strong {
              font-size: 12px;
              font-weight: 500;
              overflow-wrap: anywhere;
            }

            > span {
              color: var(--text-2);
              display: -webkit-box;
              -webkit-line-clamp: 2;
              -webkit-box-orient: vertical;
              overflow: hidden;
              white-space: pre-wrap;
            }

            > small {
              font-size: 10px;
              color: var(--text-3);
            }
          }

          &.is-done > .notes-copy > strong {
            text-decoration: line-through;
            color: var(--text-3);
          }
        }
      }
    }
  }

  .notes-empty {
    margin: 10px 0;
    color: var(--text-3);
  }

  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: default;
    opacity: 0.5;
  }

  button:focus-visible,
  summary:focus-visible {
    outline: 2px solid var(--text-2);
    outline-offset: 2px;
  }

  input:not([type=checkbox]),
  select {
    background: var(--background-2);
    border: 1px solid var(--border-color);
    color: var(--text-1);
    border-radius: 4px;
    padding: 6px;
  }
}

.notes-menu {
  position: relative;
  flex: none;

  > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    list-style: none;
    cursor: pointer;
    width: 26px;
    height: 26px;
    border-radius: 4px;

    &:hover {
      background: var(--background-3);
    }
  }

  > .notes-menu-content {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 20;
    width: 210px;
    max-height: 360px;
    overflow: auto;
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 8px;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    background: var(--background-2);
    box-shadow: 0 8px 24px #0004;

    > button {
      background: transparent;
      color: var(--text-1);
      text-align: left;
      border: 0;
      padding: 6px;
      border-radius: 3px;

      &:hover {
        background: var(--background-3);
      }
    }

    > strong {
      color: var(--text-3);
      font-size: 10px;
      padding: 5px;
    }

    > hr {
      width: 100%;
      border: 0;
      border-top: 1px solid var(--border-color);
    }

    > label {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 5px;

      &.notes-checkbox {
        flex-direction: row;
        align-items: center;
      }
    }
  }
}

.notes-dialog {
  width: min(560px, calc(100vw - 32px));
  display: block;
  max-height: calc(100vh - 60px);
  overflow: hidden;
  color: var(--text-1);

  @media (max-width: 700px) {
    max-height: calc(100vh - 32px);
    > form { max-height: calc(100vh - 64px); }
  }

  > form {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-height: calc(100vh - 94px);
    min-height: 0;

    > .notes-editor-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      flex: 0 0 auto;

      > button {
        display: inline-flex;
        background-color: --background-3;
        align-items: center;
        gap: 6px;
        cursor: default;

        &:focus-visible {
          outline: 2px solid var(--focus-border);
          outline-offset: 2px;
        }

        > span {
          font-size: var(--font-xs);
        }
      }
    }

    > .dialog-header,
    > .dialog-footer {
      flex: 0 0 auto;
    }

    > footer {
      justify-content: flex-end;
    }

    > .notes-error {
      max-height: 64px;
      overflow: auto;
      flex-shrink: 0;
    }

    label {
      display: flex;
      flex-direction: column;
      gap: 5px;
      font-size: 12px;
    }

    input:not([type=checkbox]),
    textarea,
    select {
      width: 100%;
      min-width: 0;
      padding: 7px;
      border-radius: 4px;
      border: 1px solid var(--border-color);
      background: var(--background-2);
      color: var(--text-1);
    }

    textarea {
      resize: vertical;
    }

    > .notes-tabpanel {
      display: flex;
      flex-direction: column;
      gap: 14px;
      height: 400px;
      overflow: auto;
      padding: 2px;

      &[hidden] {
        display: none;
      }

      > .notes-fields {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;

        > label {
          flex: 1 1 180px;
          min-width: 0;
        }
      }

      > .notes-tab-empty {
        margin: 0;
        padding: 16px 0;
        color: var(--text-3);
        font-size: var(--font-sm);
      }

      > button {
        align-self: flex-start;
      }

      > .notes-subtask,
      > .notes-attachment,
      > button,
      > small {
        flex-shrink: 0;
      }

      > small {
        color: var(--text-3);
        font-size: 11px;
      }

      > .notes-subtask,
      > .notes-attachment {
        display: flex;
        align-items: center;
        gap: 5px;

        > input:not([type=checkbox]),
        > span {
          flex: 1;
          min-width: 0;
          overflow-wrap: anywhere;
        }
      }
    }

    button {
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.5;
      cursor: default;
    }
  }
}

.notes-error {
  color: var(--text-1);
  border-left: 3px solid var(--text-2);
  padding-left: 8px;
}