.files-panel {
  height: 100%;
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(190px, 38%) minmax(0, 1fr);
  overflow: hidden;
  container-type: inline-size;

  .files-explorer,
  .files-preview {
    min-width: 0;
    min-height: 0;
  }

  .files-explorer {
    display: grid;
    grid-template-rows: 48px 38px minmax(0, 1fr);
    border-right: 1px solid var(--border-color);
  }

  .files-explorer-header,
  .files-preview-header {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    border-bottom: 1px solid var(--border-color);
  }

  .files-explorer-header > span,
  .files-preview-header > span {
    min-width: 0;
    flex: 1;
    display: grid;
    gap: 2px;
  }

  .files-explorer-header strong,
  .files-explorer-header small,
  .files-preview-header strong,
  .files-preview-header small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .files-explorer-header strong,
  .files-preview-header strong {
    color: var(--text-1);
    font-weight: 600;
  }

  .files-explorer-header small,
  .files-preview-header small {
    color: var(--text-3);
    font-size: .9rem;
  }

  .files-explorer-header button,
  .files-preview-back {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border-radius: 7px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover:not(:disabled),
    &.active {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &.active {
      box-shadow: inset 0 0 0 1px var(--border-color);
    }

    &:active:not(:disabled) {
      transform: scale(.94);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }

    &:disabled {
      opacity: .45;
    }
  }

  .files-preview-back {
    display: none;
  }

  .files-search {
    min-width: 0;
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 5px;
    margin: 6px 7px 4px;
    padding: 0 6px;
    color: var(--text-3);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;

    &:focus-within {
      color: var(--text-2);
      border-color: var(--text-3);
      box-shadow: 0 0 0 1px var(--text-3);
    }

    input {
      min-width: 0;
      height: 25px;
      padding: 0;
      color: var(--text-1);
      background: transparent;
      border: 0;
      outline: 0;

      &::placeholder {
        color: var(--text-3);
      }

      &::-webkit-search-cancel-button {
        display: none;
      }
    }
  }

  .files-search-clear {
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border-radius: 4px;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }

  .files-tree {
    min-width: 0;
    min-height: 0;
    padding: 7px 4px 12px;
    overflow: auto;
  }

  .files-root {
    min-width: max-content;
  }

  .files-root-label {
    height: 26px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 8px;
    color: var(--text-1);
    font-size: 11px;
    font-weight: 600;

    span {
      max-width: 220px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .files-tree-entry {
    min-width: 0;
  }

  .files-tree-node {
    width: 100%;
    min-width: max-content;
    height: 27px;
    display: grid;
    grid-template-columns: 14px 16px minmax(80px, 1fr) auto auto;
    align-items: center;
    gap: 4px;
    padding: 0 7px 0 calc(7px + var(--files-depth) * 14px);
    color: var(--text-2);
    background: transparent;
    border-radius: 5px;
    text-align: left;
    transition: color 140ms var(--base-transition),
      background 140ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active {
      background: var(--item-active);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }

    &.selected {
      color: var(--text-1);
      background: var(--item-active);
    }

    &.status-untracked .files-node-name,
    &.status-untracked .files-status {
      color: --git-untracked-status-color;
    }

    &.status-modified .files-node-name,
    &.status-modified .files-status {
      color: --git-modified-status-color;
    }

    &.status-conflict .files-node-name,
    &.status-conflict .files-status {
      color: --git-conflict-status-color;
    }

    &.status-ignored .files-node-name,
    &.status-ignored .files-status {
      color: --git-ignored-status-color;
    }

    &.status-ignored {
      opacity: .62;
    }
  }

  .files-node-chevron,
  .files-node-icon {
    width: 14px;
    height: 14px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
  }

  img.files-node-icon {
    object-fit: contain;
  }

  .files-node-name {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 1rem;
  }

  .files-repository-mark {
    color: var(--text-3);
  }

  .files-status {
    min-width: 12px;
    color: var(--text-3);
    font-size: 10px;
    font-weight: 600;
    text-align: right;
  }

  .files-tree-message {
    height: 25px;
    display: flex;
    align-items: center;
    padding-left: calc(41px + var(--files-depth) * 14px);
    color: var(--text-3);
    font-size: 10px;
  }

  .files-search-results {
    min-width: 0;
    height: 100%;

    section + section {
      margin-top: 7px;
      padding-top: 5px;
      border-top: 1px solid var(--border-color);
    }

    h3 {
      margin: 0;
      padding: 3px 8px 5px;
      color: var(--text-3);
      font-size: 9px;
      font-weight: 600;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
  }

  .files-search-result {
    width: 100%;
    min-width: 0;
    min-height: 34px;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) 14px;
    align-items: center;
    gap: 5px;
    padding: 3px 7px;
    color: var(--text-2);
    background: transparent;
    border-radius: 5px;
    text-align: left;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active {
      background: var(--item-active);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }

    > span:not(.files-status) {
      min-width: 0;
      display: grid;
      gap: 1px;
    }

    strong,
    small {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: inherit;
      font-weight: 500;
    }

    small {
      color: var(--text-3);
      font-size: .85rem;
    }

    &.status-untracked strong,
    &.status-untracked .files-status {
      color: --git-untracked-status-color;
    }

    &.status-modified strong,
    &.status-modified .files-status {
      color: --git-modified-status-color;
    }

    &.status-conflict strong,
    &.status-conflict .files-status {
      color: --git-conflict-status-color;
    }

    &.status-ignored strong,
    &.status-ignored .files-status {
      color: --git-ignored-status-color;
    }

    &.status-ignored {
      opacity: .62;
    }
  }

  .files-search-content-result {
    min-height: 39px;
  }

  .files-search-limit {
    margin: 8px;
    padding: 7px 8px;
    color: var(--text-3);
    background: var(--background-3);
    border-radius: 6px;
    font-size: 9px;
    line-height: 1.45;
  }

  .files-preview {
    display: grid;
    grid-template-rows: 48px minmax(0, 1fr);
    background: var(--background-0);

    > .files-panel-state {
      grid-row: 1 / -1;
    }
  }

  .files-preview-breadcrumb {
    cursor: context-menu;

    &:focus-visible {
      border-radius: 3px;
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }

  .files-preview-content {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }

  .files-code {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 8px 0 24px;
    overflow: auto;
    color: var(--text-1);
    background: var(--background-0);
    font-family: var(--font-code);
    font-size: 11px;
    line-height: 1.55;
    tab-size: 2;

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }

  .files-code-line {
    min-width: max-content;
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);

    > span {
      padding-right: 10px;
      color: var(--text-3);
      text-align: right;
      user-select: none;
    }

    code {
      padding-right: 20px;
      color: inherit;
      font: inherit;
      white-space: pre;
    }

    &.target-line {
      background: var(--background-3);
      box-shadow: inset 2px 0 var(--text-3);
    }
  }

  .files-diff {
    display: block;

    > code {
      min-width: max-content;
      display: block;
      padding: 0 16px;
      color: inherit;
      font: inherit;
      white-space: pre;

      .token.deleted:not(.prefix) {
        background-color: var(--diff-removed-bg);
      }

      .token.inserted:not(.prefix) {
        background-color: var(--diff-added-bg);
      }

      .token.deleted-sign .token.prefix,
      .token.inserted-sign .token.prefix {
        background-color: var(--diff-relative-margin-bg);
      }
    }
  }

  .files-edit-empty {
    display: block;
    padding: 20px;
    color: var(--text-2);
    font-family: inherit;
    font-style: italic;
    text-align: center;
  }

  .files-image-preview {
    width: 100%;
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 10px;
    padding: 20px;
    overflow: auto;
    background:
      linear-gradient(45deg, var(--background-3) 25%, transparent 25%),
      linear-gradient(-45deg, var(--background-3) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--background-3) 75%),
      linear-gradient(-45deg, transparent 75%, var(--background-3) 75%);
    background-position: 0 0, 0 8px, 8px -8px, -8px 0;
    background-size: 16px 16px;

    img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      box-shadow: 0 4px 18px rgb(0 0 0 / 12%);
    }

    span {
      padding: 3px 7px;
      color: var(--text-3);
      background: var(--background-2);
      border-radius: 5px;
      font-size: 9px;
    }
  }
}

.selection-action-group {
  position: fixed;
  height: 30px;
  display: inline-flex;
  align-items: stretch;
  z-index: 125;
  color: var(--text-1);
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: 0 2px 16px #00000011;
  white-space: nowrap;

  button {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 8px;
    color: inherit;
    background: transparent;
    border: 0;
    border-radius: 5px;
    font: inherit;
    font-size: .95rem;
    cursor: pointer;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    + button {
      border-left: 1px solid var(--border-color);
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    &:hover {
      background: var(--item-hover);
    }

    &:active {
      transform: scale(.97);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -1px;
    }

    svg {
      flex: 0 0 auto;
      color: var(--text-3);
    }
  }
}

.files-panel-state,
.files-loading {
  height: 100%;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 6px;
  padding: 24px;
  color: var(--text-3);
  text-align: center;

  strong {
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  span {
    max-width: 260px;
    font-size: 10px;
    line-height: 1.5;
  }
}

.files-panel-error {
  margin: 8px;
  padding: 8px 9px;
  color: var(--text-1);
  background: var(--background-3);
  border-radius: 7px;
  font-size: 10px;
  line-height: 1.45;
}

.files-context-menu {
  width: 190px;
}

@container (max-width: 520px) {
  .files-panel {
    .files-explorer {
      grid-column: 1 / -1;
    }

    .files-preview {
      display: none;
    }

    &.has-preview {
      .files-explorer {
        display: none;
      }

      .files-preview {
        display: grid;
        grid-column: 1 / -1;
      }

      .files-preview-back {
        display: grid;
      }
    }
  }
}

@media (prefers-reduced-motion: reduce) {

  .selection-action-group button,
  .files-panel .files-tree-node,
  .files-panel .files-search-clear,
  .files-panel .files-search-result,
  .files-panel .files-explorer-header button,
  .files-panel .files-preview-back {
    transition: none;
  }
}