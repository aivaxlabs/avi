.project-picker-row {
  width: min(720px, 100%);
  margin: 6px auto 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  .project-picker-holder {
    position: relative;
    min-width: 0;
  }

  .project-picker {
    min-width: 0;
    max-width: min(420px, 70vw);
    height: 28px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 8px;
    color: var(--color-muted-strong);
    border-radius: 7px;
    font-size: 11px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      border-color 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover:not(:disabled) {
      color: var(--color-text-primary);
      background: var(--surface-hover);
      border-color: var(--border-control);
    }

    &:active:not(:disabled) {
      transform: scale(.98);
    }

    &:focus-visible {
      outline: 2px solid var(--border-accent);
      outline-offset: 2px;
    }

    &:disabled {
      color: var(--color-muted);
      background: transparent;
      cursor: not-allowed;
      opacity: .72;
    }
  }

  .project-picker-menu {
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
    z-index: 130;
    width: 280px;
    padding: 6px;
    background: var(--surface-menu-solid);
    border: 1px solid var(--border-panel);
    border-radius: 12px;
    box-shadow: 0 16px 40px var(--shadow-menu);
  }

  .project-picker-search {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 6px;
    padding: 0 6px;
    color: var(--color-muted);

    input {
      min-width: 0;
      height: 30px;
      padding: 6px 0 !important;
      color: var(--color-text-primary);
      background: transparent;
      border: 0;
      border-radius: 0;
      outline: 0;
      font-size: 12px !important;
    }
  }

  .project-picker-list {
    max-height: 224px;
    overflow-y: auto;
  }

  .project-picker-list button, .project-picker-action {
    width: 100%;
    min-width: 0;
    min-height: 30px;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 7px;
    padding: 6px 8px;
    color: var(--color-text-primary);
    background: transparent;
    text-align: left;
    font-size: 12px;
  }

  .project-picker-list button:hover, .project-picker-list button.active, .project-picker-action:hover {
    background: var(--surface-neutral-hover);
  }

  .project-picker-list button:focus-visible, .project-picker-action:focus-visible {
    outline: 2px solid var(--border-accent);
    outline-offset: -2px;
  }

  .project-picker-list button > span, .project-picker-list button > small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-picker-list button > small {
    max-width: 82px;
    color: var(--color-muted);
    font-size: 10px;
  }

  .project-picker-list button > svg:last-child {
    grid-column: 4;
    color: var(--color-text-primary);
  }

  .project-picker-empty {
    display: block;
    padding: 10px 8px;
    color: var(--color-muted);
    font-size: 11px;
  }

  .project-picker-divider {
    height: 1px;
    margin: 5px 6px;
    background: var(--color-divider-subtle);
  }

  .project-picker-action {
    grid-template-columns: 16px minmax(0, 1fr) 16px;
  }

  .project-picker-action svg, .project-picker-list button > svg:first-child {
    color: var(--color-menu-icon);
  }

  .project-picker-action.active {
    background: var(--surface-neutral-hover);
  }

  .project-picker-action > svg:last-child {
    color: var(--color-text-primary);
  }

  .context-usage {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 0;
    color: var(--color-muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }

  .context-usage-ring {
    --context-progress: 0deg;
    width: 16px;
    height: 16px;
    position: relative;
    display: block;
    border-radius: 50%;
    background: conic-gradient(var(--color-text-primary) var(--context-progress),
      var(--surface-muted-solid) 0);

    &::after {
      content: '';
      position: absolute;
      inset: 3px;
      background: var(--surface-solid);
      border-radius: 50%;
    }
  }

  .project-picker-path, .project-picker-branch span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .project-picker-path {
    flex: 1 1 auto;
  }

  .project-picker-branch {
    min-width: 0;
    max-width: 160px;
    display: flex;
    align-items: center;
    gap: 4px;
    padding-left: 7px;
    border-left: 1px solid var(--border-hairline);
  }

  .project-picker-branch svg, .project-picker-lock {
    flex: 0 0 auto;
  }

  .project-picker-spinner {
    animation: project-picker-spin 800ms linear infinite;

    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }
}

@keyframes project-picker-spin {
  to {
    transform: rotate(360deg);
  }
}
