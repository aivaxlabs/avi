.inline-error,
.toast {
  color: var(--text-1);
  font-size: 12px;
}

.toast {
  position: fixed;
  right: 18px;
  bottom: 18px;
  max-width: 420px;
  padding: 10px 12px;
  color: var(--text-5);
  background: var(--text-1);
  border-radius: 8px;
  box-shadow: 0 18px 50px rgb(0 0 0 / 30%);
  z-index: 80;
}
