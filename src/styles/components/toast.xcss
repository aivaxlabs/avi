.inline-error,
.toast {
  color: var(--text-1);
  font-size: .9rem;
}

.toast {
  position: fixed;
  right: 18px;
  bottom: 18px;
  max-width: 420px;
  padding: 10px 12px;
  color: var(--text-5);
  background: var(--text-1);
  border-radius: 8px;
  box-shadow: 0 18px 50px rgb(0 0 0 / 30%);
  z-index: 80;
  animation: toast-in var(--duration-medium) var(--ease-smooth-out);

  &[data-closing] {
    animation: toast-out var(--duration-medium) var(--ease-smooth-out) forwards;
  }
}

@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateY(var(--distance-base)) scale(var(--scale-medium));
  }
}

@keyframes toast-out {
  to {
    opacity: 0;
    transform: translateY(var(--distance-micro)) scale(var(--scale-medium));
  }
}

@media (prefers-reduced-motion: reduce) {
  .toast,
  .toast[data-closing] {
    animation: none;
  }
}
