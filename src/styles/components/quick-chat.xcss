html.quick-chat-window,
html.quick-chat-window body,
html.quick-chat-window #root {
  height: 100%;
  min-height: 0;
  background: var(--background-1);
  overflow: hidden;
}

html.quick-chat-window #root {
  position: relative;
}

.quick-chat-shell {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  color: var(--text-1);
  background: var(--background-1);
  overflow: hidden;

  > .chat-view-slot {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .chat-area {
    position: absolute;
    inset: 0;
    height: auto;
  }

  .empty-chat > p {
    max-width: 360px;
    margin: 8px 0 0;
    color: var(--text-3);
    font-size: var(--font-sm);
  }
}

html.quick-chat-window .message-action-icon[title="Fork"] {
  display: none;
}

.quick-chat-error {
  margin: 8px 12px 0;
  padding: 8px 10px;
  color: var(--danger-color);
  background: color-mix(in srgb, var(--danger-color) 12%, var(--background-2));
  border: 1px solid color-mix(in srgb, var(--danger-color) 35%, var(--border-color));
  border-radius: 8px;
  font-size: var(--font-sm);
}

.quick-question-popover {
  width: min(440px, calc(100vw - 16px));
  grid-template-rows: auto minmax(0, 1fr) auto auto auto;

  > .quick-question-messages {
    min-height: 0;
    max-height: 340px;
    overflow-y: auto;
    padding: 0 4px;
    font-size: var(--font-sm);

    &:empty {
      display: none;
    }

    .message-row {
      width: 100%;

      + .message-row {
        margin-top: .9em;
      }
    }

    .message-action-icon[title="Fork"] {
      display: none;
    }
  }

  > .quick-question-error {
    margin: 0;
    color: var(--danger-color);
    font-size: var(--font-sm);
  }

  > textarea {
    min-height: 52px;
  }
}
