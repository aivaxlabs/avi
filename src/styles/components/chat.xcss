.chat-area {
  position: relative;
  height: 100%;
  --composer-bottom: 0;
  background: var(--background-1);
  overflow: hidden;
  isolation: isolate;

  > .chat-find {
    position: absolute;
    top: 8px;
    right: 12px;
    left: 12px;
    z-index: 10;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: var(--font-sm);

    > input {
      flex: 1;
      min-width: 120px;
      color: var(--text-1);
      background: var(--background-1);
      border: 1px solid var(--border-color);
      padding: 6px;
    }

    > button { padding: 6px; }
  }

  .chat-background-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    pointer-events: none;
    user-select: none;
    contain: strict;
  }

  .empty-chat-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    background-image:
      radial-gradient(ellipse 58% 48% at 50% 78%,
        color-mix(in srgb, var(--primary-color) 9%, transparent),
        transparent 72%),
      radial-gradient(ellipse 34% 32% at 18% 68%,
        color-mix(in srgb, var(--primary-color) 3%, transparent),
        transparent 74%),
      radial-gradient(circle at center,
        color-mix(in srgb, var(--primary-color) 7%, transparent) 0 .7px,
        transparent .9px);
    background-size: auto, auto, 24px 24px;
    pointer-events: none;
    contain: strict;
    transition: opacity 1800ms var(--base-transition);

    &[data-webgpu-ready="true"] {
      background-image: none;
    }
  }

  &.chat-empty .empty-chat-background {
    opacity: 1;
  }

  .chat-scroll {
    position: relative;
    z-index: 1;
    height: 100%;
    overflow: auto;
    padding: 22px 5px calc(var(--composer-clearance, 176px) + 54px) 20px;
    scrollbar-gutter: stable;
    outline: none;
  }

  .file-drop-overlay {
    position: absolute;
    inset: 34px 0 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 28px;
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    backdrop-filter: blur(8px);
    pointer-events: none;

    div {
      display: grid;
      justify-items: center;
      gap: 8px;
      padding: 18px 22px;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      box-shadow: 0 18px 60px rgb(0 0 0 / 12%);
    }

    span {
      font-size: 1rem;
      font-weight: 500;
    }
  }

  .empty-chat {
    min-height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    transform: translateY(-72px);
  }

  &.chat-empty {
    --composer-bottom: min(calc(50% - 60px),
        calc(100% - var(--composer-clearance, 176px) - 14px));

    &:has(.command-picker) {
      --composer-bottom: 0;
    }

    > .composer-wrap:not(.inline-composer-wrap) .composer {
      --empty-composer-secondary: color-mix(in oklch, var(--primary-color) 64%, var(--success-color));
      --empty-composer-tertiary: color-mix(in oklch, var(--primary-color) 60%, var(--warn-color));

      &::before,
      &::after {
        content: '';
        position: absolute;
        pointer-events: none;
      }

      &::before {
        inset: -2px;
        z-index: -1;
        padding: 1px;
        background:
          linear-gradient(108deg,
            transparent 29%,
            color-mix(in srgb, var(--primary-color) 76%, transparent) 35%,
            color-mix(in srgb, var(--empty-composer-secondary) 72%, transparent) 39%,
            color-mix(in srgb, var(--empty-composer-tertiary) 74%, transparent) 43%,
            transparent 49%);
        background-size: 260% 100%;
        border-radius: inherit;
        opacity: .5;
        -webkit-mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        -webkit-mask-composite: xor;
        mask:
          linear-gradient(#000 0 0) content-box,
          linear-gradient(#000 0 0);
        mask-composite: exclude;
        animation: empty-composer-shimmer 8s ease-in-out infinite;
      }

    }
  }

  &.chat-empty-home {
    display: flex;
    flex-direction: column;
    --composer-bottom: 0;

    > .chat-scroll {
      flex: 1;
      min-height: 0;
      height: auto;
      padding: 40px 28px 20px;

      > .empty-chat {
        width: min(100%, 760px);
        grid-template-columns: minmax(0, 1fr);
        margin: auto;
        gap: 32px;
        transform: none;

        > h1 {
          justify-self: start;
          font-size: clamp(var(--font-xxl), 2.8vw, 2rem);
          font-weight: 400;
          letter-spacing: -.025em;
          text-align: left;
          text-wrap: balance;
        }

        > .empty-chat-summary {
          display: grid;
          grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
          gap: 28px;
          width: 100%;
          text-align: left;

          &:has(> .summary-empty) { grid-template-columns: minmax(0, 1fr); }

          > section {
            min-width: 0;
            align-self: start;

            &.summary-empty {
              display: grid;
              grid-template-columns: auto minmax(0, 1fr);
              align-items: center;
              gap: 4px 16px;
              padding-top: 20px;
              border-top: 1px solid var(--border-color);

              > header { display: contents; }
              > header > h2 { font-size: var(--font-sm); color: var(--text-3); }
              > header > .summary-open { grid-column: 2; justify-self: end; }
              > .summary-state { grid-column: 1 / -1; padding: 0; }
              > .summary-caption, > ul { display: none; }
            }

            > header {
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 8px;

              > h2 {
                display: flex;
                align-items: center;
                gap: 8px;
                margin: 0;
                font-size: var(--font-md);
                font-weight: 500;
                > svg { color: var(--text-3); }
                > .summary-count { color: var(--text-3); font-size: var(--font-xs); font-variant-numeric: tabular-nums; }
              }

              > .summary-open {
                display: inline-flex;
                align-items: center;
                gap: 4px;
                flex-shrink: 0;
                padding: 6px 0 6px 8px;
                color: var(--text-3);
                background: transparent;
                border-radius: 4px;
                font-size: var(--font-xs);
                > svg { margin: 0; }
              }
            }

            > .summary-caption { font-size: var(--font-xs); color: var(--text-3); margin: 2px 0 14px; }
            > .summary-state { padding: 16px 0; font-size: var(--font-sm); line-height: 1.5; }

            > ul {
              list-style: none;
              padding: 0;
              margin: 0;
              > li {
                + li { margin-top: 4px; }
                > .summary-item {
                  display: grid;
                  gap: 6px;
                  width: 100%;
                  min-width: 0;
                  padding: 10px;
                  text-align: left;
                  border-radius: 8px;
                  background: transparent;
                  color: var(--text-1);
                  font-size: var(--font-md);
                  > strong { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
                  > .summary-meta {
                    display: flex;
                    flex-wrap: wrap;
                    justify-content: space-between;
                    gap: 4px 12px;
                    color: var(--text-3);
                    font-size: var(--font-xs);
                    overflow-wrap: anywhere;
                  }
                  > .summary-preview {
                    display: -webkit-box;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: 1;
                    overflow: hidden;
                    overflow-wrap: anywhere;
                    color: var(--text-3);
                    font-size: var(--font-xs);
                    line-height: 1.5;
                  }
                }
              }
            }

            button {
              &:hover { background: var(--item-hover); }
              &:focus-visible { outline: 2px solid var(--focus-border); outline-offset: 2px; }
            }
          }
        }
      }
    }

    > .composer-wrap { position: relative; flex: 0 0 auto; bottom: auto; }
    @media (max-width: 600px) {
      > .chat-scroll { padding: 24px 16px 16px; }
    }
  }

  > .composer-wrap {
    z-index: 2;
  }

  .copilot-orb,
  .brand-mark {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--text-5);
    background: linear-gradient(135deg, var(--text-1), var(--text-1) 52%, var(--text-2));
    border-radius: 8px;
    box-shadow: 0 20px 60px rgb(0 0 0 / 28%);
  }

  .empty-chat h1 {
    margin: 0;
    font-size: 2.3rem;
    font-weight: 400;
  }
}

@keyframes empty-composer-shimmer {

  0%,
  100% {
    background-position: 115% 50%;
    filter: hue-rotate(-12deg);
    opacity: .26;
  }

  48% {
    background-position: -15% 50%;
    filter: hue-rotate(54deg);
    opacity: .62;
  }
}

@keyframes empty-composer-smoke {

  0%,
  100% {
    background-position: -12px 4px, 0 10px, 12px -2px;
    filter: hue-rotate(-16deg);
    opacity: .28;
  }

  46% {
    background-position: 8px -5px, -8px 2px, -10px 8px;
    filter: hue-rotate(48deg);
    opacity: .46;
  }

  74% {
    background-position: -4px 8px, 8px -6px, 4px -7px;
    filter: hue-rotate(-34deg);
    opacity: .36;
  }
}

.platform-win32 .chat-area,
.platform-darwin .chat-area {
  backdrop-filter: saturate(120%);
}

.platform-linux .sidebar {
  background: var(--background-2);
}

@media (prefers-reduced-motion: reduce) {
  .chat-area {
    .empty-chat-background {
      transition: none;
    }

    &.chat-empty > .composer-wrap:not(.inline-composer-wrap) .composer {

      &::before,
      &::after {
        animation: none;
        filter: none;
      }
    }
  }
}

.empty-chat p,
.dialog-header p {
  margin: 0;
  color: var(--text-3);
  font-size: .9rem;
}