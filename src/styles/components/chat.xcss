.chat-area {
  position: relative;
  height: 100%;
  --composer-bottom: 0;
  background: var(--background-1);
  overflow: hidden;
  isolation: isolate;

  .empty-chat-background {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    background-image:
      radial-gradient(
        ellipse 58% 48% at 50% 78%,
        color-mix(in srgb, var(--primary-color) 9%, transparent),
        transparent 72%
      ),
      radial-gradient(
        ellipse 34% 32% at 18% 68%,
        color-mix(in srgb, var(--primary-color) 3%, transparent),
        transparent 74%
      ),
      radial-gradient(
        circle at center,
        color-mix(in srgb, var(--primary-color) 7%, transparent) 0 .7px,
        transparent .9px
      );
    background-size: auto, auto, 24px 24px;
    pointer-events: none;
    contain: strict;
    transition: opacity 1800ms var(--base-transition);

    &[data-webgpu-ready="true"] {
      background-image: none;
    }
  }

  &.chat-empty .empty-chat-background {
    opacity: 1;
  }

  .chat-scroll {
    position: relative;
    z-index: 1;
    height: 100%;
    overflow: auto;
    padding: 22px 5px calc(var(--composer-clearance, 176px) + 54px) 20px;
    scrollbar-gutter: stable;
  }

  .file-drop-overlay {
    position: absolute;
    inset: 34px 0 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 28px;
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    backdrop-filter: blur(8px);
    pointer-events: none;

    div {
      display: grid;
      justify-items: center;
      gap: 8px;
      padding: 18px 22px;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      box-shadow: 0 18px 60px rgb(0 0 0 / 12%);
    }

    span {
      font-size: 13px;
      font-weight: 500;
    }
  }

  .empty-chat {
    min-height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    transform: translateY(-72px);
  }

  &.chat-empty {
    --composer-bottom: min(
      calc(50% - 60px),
      calc(100% - var(--composer-clearance, 176px) - 14px)
    );

    &:has(.command-picker) {
      --composer-bottom: 0;
    }
  }

  > .composer-wrap {
    z-index: 2;
  }

  .copilot-orb,
  .brand-mark {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--text-5);
    background: linear-gradient(135deg, var(--text-1), var(--text-1) 52%, var(--text-2));
    border-radius: 8px;
    box-shadow: 0 20px 60px rgb(0 0 0 / 28%);
  }

  .empty-chat h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 400;
  }
}

.platform-win32 .chat-area,
.platform-darwin .chat-area {
  backdrop-filter: saturate(120%);
}

.platform-linux .sidebar {
  background: var(--background-2);
}

@media (prefers-reduced-motion: reduce) {
  .chat-area .empty-chat-background {
    transition: none;
  }
}

.empty-chat p,
.dialog-header p {
  margin: 0;
  color: var(--text-3);
  font-size: 12px;
}