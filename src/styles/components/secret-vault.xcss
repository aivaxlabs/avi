.settings-page.secret-vault-page {
  grid-template-columns: minmax(0, 1fr);

  .secret-vault-header-actions {
    flex: 0 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
  }

  .secret-vault-list,
  .secret-vault-editor {
    display: grid;
    align-content: start;
    gap: 24px;
  }

  .secret-vault-list > .settings-section {
    gap: 12px;
  }

  .settings-list-summary > .input {
    width: min(280px, 100%);
  }

  .secret-vault-fieldset {
    min-width: 0;
    margin: 0;
  }

  .settings-card-row > span {
    min-width: 0;
    display: grid;
    gap: 4px;

    small {
      color: --text-3;
      font-size: .9rem;
    }
  }

  .secret-vault-value-field {
    > .secret-vault-value-actions {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 6px;
    }

    > .secret-vault-value {
      grid-column: 1 / -1;
      grid-row: 3;
      font-family: --font-code;
      overflow-wrap: anywhere;

      &[data-masked="true"] {
        -webkit-text-security: disc;
      }
    }
  }
}
