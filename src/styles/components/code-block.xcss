.code-block {
  max-width: 100%;
  min-width: 0;
  margin: 0 0 12px;
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);

  pre {
    max-height: 500px;
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
    padding: 0 8px 0 12px;
    color: var(--text-3);
    background: var(--background-3);
    border-bottom: 1px solid var(--border-color);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;

    button {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 26px;
      padding: 0 7px;
      color: var(--text-3);
      background: transparent;
      border-radius: 6px;
      font-size: 11px;
      text-transform: none;

      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }
    }
  }

  .token.comment, .token.prolog, .token.doctype, .token.cdata {
    color: var(--text-4);
  }

  .token.punctuation {
    color: var(--text-3);
  }

  .token.property, .token.tag, .token.boolean, .token.constant, .token.symbol, .token.deleted {
    color: var(--text-1);
  }

  .token.selector, .token.attr-name, .token.char, .token.builtin, .token.inserted {
    color: var(--text-2);
  }

  .token.operator, .token.entity, .token.url, .language-css .token.string, .style .token.string {
    color: var(--text-1);
  }

  .token.atrule, .token.attr-value, .token.keyword {
    color: var(--text-2);
  }

  .token.function {
    color: var(--text-2);
  }

  .token.regex, .token.important, .token.variable, .token.string {
    color: var(--text-2);
  }

  .token.number {
    color: var(--text-1);
  }

  .token.class-name {
    color: var(--text-2);
  }

  .token.important, .token.bold {
    font-weight: 500;
  }

  .token.italic {
    font-style: italic;
  }
}

.markdown-body .code-block pre {
  max-width: 100%;
  margin: 0;
  padding: 13px 14px;
  overflow-x: auto;
  overflow-y: auto;
  color: var(--text-1);
  background: transparent;
  border-radius: 0;
  font-size: 13px;
  line-height: 1.55;
  tab-size: 2;
}

.markdown-body .code-block code {
  display: block;
  width: max-content;
  min-width: 100%;
  padding: 0;
  color: inherit;
  background: transparent;
  font-family: "Cascadia Code", "JetBrains Mono", Consolas, monospace;
  white-space: pre;
}
