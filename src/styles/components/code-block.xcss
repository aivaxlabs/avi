.code-block {
  max-width: 100%;
  min-width: 0;
  margin: 0 0 12px;
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);

  pre {
    max-height: 500px;
  }

  .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
    padding: 0 8px 0 12px;
    color: var(--text-3);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;

    button {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      min-height: 26px;
      padding: 0 7px;
      color: var(--text-3);
      background: transparent;
      border-radius: 6px;
      font-size: 11px;
      text-transform: none;

      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }
    }
  }
}

.markdown-body .code-block {
  pre {
    max-width: 100%;
    margin: 0;
    padding: 13px 14px;
    overflow-x: auto;
    overflow-y: auto;
    color: var(--text-1);
    background: transparent;
    border-radius: 0;
    font-size: 13px;
    line-height: 1.55;
    tab-size: 2;
  }

  code {
    display: block;
    width: max-content;
    min-width: 100%;
    padding: 0;
    color: inherit;
    background: transparent;
    font-family: var(--font-code);
    white-space: pre;
  }
}