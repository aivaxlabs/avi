.chat-workspace {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  overflow: hidden;

  &.with-side-chat {
    grid-template-columns: minmax(0, 58%) minmax(0, 42%);
  }
}

.side-chat-panel {
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: grid;
  grid-template-rows: 44px minmax(0, 1fr);
  padding-top: 34px;
  overflow: hidden;
  background: var(--surface-solid);
  border-left: 1px solid var(--border-panel);

  .side-chat-header {
    min-width: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 5px 8px;
    border-bottom: 1px solid var(--color-divider-subtle);
  }

  .side-chat-heading {
    padding-left: 4px;
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
    white-space: nowrap;
  }

  .side-chat-tabs {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .side-chat-tab {
    min-width: 0;
    flex: 0 1 156px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px;
    align-items: center;
    color: var(--color-muted);
    border-radius: 8px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      border-color 180ms var(--base-transition);

    &:hover {
      color: var(--color-text-strong);
      background: var(--surface-hover);
    }

    &.active {
      color: var(--color-text-strong);
      background: var(--surface-muted);
      border-color: var(--border-hairline);
    }

    > button {
      min-width: 0;
      height: 30px;
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 0 4px 0 8px;
      color: inherit;
      background: transparent;
      text-align: left;

      > span:last-child {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
      }

      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: -2px;
      }
    }
  }

  .side-chat-close {
    width: 28px;
    padding: 0;
    justify-content: center;
    color: var(--color-muted);
    border-radius: 6px;

    &:hover,
    &:focus-visible {
      color: var(--color-text-strong);
      background: var(--surface-hover-strong);
    }
  }

  .side-chat-view {
    height: 100%;
    padding-top: 0;

    .chat-scroll {
      padding-inline: 12px 4px;
    }

    .composer-wrap {
      padding: 12px 12px 18px;
    }

    .composer {
      border-radius: 16px;
    }

    .empty-chat {
      transform: translateY(-42px);

      h1 {
        font-size: 20px;
      }
    }
  }

  .side-chat-content {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
}

@media (max-width: 860px) {
  .chat-workspace.with-side-chat {
    grid-template-columns: minmax(0, 50%) minmax(0, 50%);
  }

  .side-chat-panel {
    .side-chat-header {
      grid-template-columns: minmax(0, 1fr);
    }

    .side-chat-heading {
      display: none;
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .side-chat-tab {
    transition: none;
  }
}
