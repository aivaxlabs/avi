.composer-wrap {
  position: absolute;
  bottom: var(--composer-bottom);
  left: 0;
  width: 100%;

  padding: 14px 28px 24px;
  pointer-events: none;
  transition: bottom 360ms var(--base-transition);

  > * {
    pointer-events: all;
  }

  .composer-wrap-strip {
    position: relative;
    z-index: 0;
    width: min(680px, 95%);
    margin: 0 auto;
    color: var(--text-1);
    background: var(--background-2);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border-color);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
  }

  .composer-wrap-strip + .composer-wrap-strip {
    border-radius: 0;
  }

  .goal-strip {
    min-height: 54px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    padding: 7px 10px 7px 12px;

    > svg {
      color: var(--text-1);
    }

    &.paused > svg {
      color: var(--text-3);
    }
  }

  .goal-strip-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong {
      overflow: hidden;
      color: var(--text-1);
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 12px;
      font-weight: 500;
    }

    small {
      display: flex;
      align-items: center;
      gap: 5px;
      color: var(--text-3);
      font-size: 10px;
      font-variant-numeric: tabular-nums;
    }
  }

  .goal-strip-actions {
    display: flex;
    align-items: center;
    gap: 2px;

    button {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      padding: 0;
      color: var(--text-3);
      background: transparent;
      border-radius: 7px;
      transition: color 180ms var(--base-transition),
        background 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      &:hover,
      &:focus-visible {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &:active {
        transform: scale(.94);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }

      &:disabled {
        opacity: .45;
        cursor: wait;
      }
    }
  }

  .subagent-strip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: var(--text-2);
    text-align: left;
    font-size: 12px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition);

    &:hover,
    &:focus-visible {
      color: var(--text-1);
      background: var(--background-2);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }

  .queued-messages {
    max-height: min(210px, 28vh);
    margin-bottom: -4px;
    padding: 6px;
    overflow: auto;
    list-style: none;
    scrollbar-width: thin;

    li {
      min-width: 0;
      min-height: 34px;
      display: grid;
      grid-template-columns: 22px 18px auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 5px;
      padding: 3px 5px;
      border-radius: 8px;
      transition: background 180ms var(--base-transition),
        opacity 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      + li {
        border-top: 1px solid var(--border-color);
      }

      &:hover,
      &:focus-within {
        background: var(--item-hover);
      }

      &.dragging {
        opacity: .48;
        transform: scale(.99);
      }
    }
  }

  .queued-message-grip {
    width: 22px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border-radius: 6px;
    cursor: grab;
    opacity: .4;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      opacity 180ms var(--base-transition),
      transform 180ms var(--base-transition);
  }

  .queued-messages li:hover .queued-message-grip,
  .queued-messages li:focus-within .queued-message-grip,
  .queued-message-grip:focus-visible {
    opacity: 1;
  }

  .queued-message-grip:hover,
  .queued-message-grip:focus-visible {
    color: var(--text-1);
    background: var(--item-hover);
  }

  .queued-message-grip:active {
    cursor: grabbing;
    transform: scale(.92);
  }

  .queued-message-position {
    color: var(--text-4);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .queued-message-copy {
    min-width: 0;
    overflow: hidden;
    color: var(--text-1);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
  }

  .queued-message-status,
  .message-delivery-indicator {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-3);
    font-size: 10px;
    font-weight: 500;
    white-space: nowrap;
  }

  .queued-message-status {
    padding: 3px 6px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 999px;
  }

  .queued-messages li.steered .queued-message-status {
    color: var(--link-color);
  }

  .queued-message-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: .4;
    transition: opacity 180ms var(--base-transition);
  }

  .queued-messages li:hover .queued-message-actions,
  .queued-messages li:focus-within .queued-message-actions,
  .queued-messages li.menu-open .queued-message-actions {
    opacity: 1;
  }

  .queued-message-actions button {
    min-width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 7px;
    color: var(--text-3);
    background: transparent;
    border-radius: 9999px;
    font-size: 11px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover,
    &:focus-visible {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);
    }

    &:active {
      transform: scale(.94);
    }
  }

  .queued-message-grip:focus-visible,
  .queued-message-actions button:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: 1px;
  }

  .queued-message-actions .queued-message-steer {
    padding-inline: 8px;
  }

  .composer {
    position: relative;
    z-index: 3;
    width: min(720px, 100%);
    margin: 0 auto;
    padding: 10px 8px 8px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    outline: 3px solid transparent;
    border-radius: 20px;

    &:focus-within {
      border-color: --primary-color;
      outline: 3px solid --primary-color-opaque;
    }

    &:has(.model-input-menu) {
      z-index: 3;
    }
  }

  .composer-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(92px, 230px) auto;
    grid-template-areas: "input input input input"
      "plus permission model send";
    column-gap: 7px;
    row-gap: 8px;
    align-items: end;

    > .round-button {
      grid-area: send;
      justify-self: end;
    }
  }

  .round-button {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
  }

  .send-button {
    color: var(--text-5);
    background: var(--background-5);

    &:hover {
      color: var(--text-5);
      background: var(--background-5);
    }
  }

  .model-pill {
    height: 34px;
    max-width: 270px;
    font-weight: 400;
    font-size: 1rem;
    padding: 0 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-2);
    border-radius: 8px;
    -webkit-app-region: no-drag;

    @media (max-width: 860px) {
      max-width: 120px;
    }
  }

  .composer textarea {
    grid-area: input;
    width: 100%;
    min-height: 48px;
    max-height: 500px;
    field-sizing: content;
    resize: none;
    border: 0;
    outline: 0;
    padding: 4px 6px 2px;
    overflow-y: auto;
    color: var(--text-1);
    background: transparent;
    font-size: 14px;
    line-height: 1.35;
  }

  .plus-holder {
    grid-area: plus;
    position: relative;
  }

  .composer-mode-controls {
    grid-area: permission;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .permission-mode-holder {
    position: relative;
    min-width: 0;
  }

  .permission-mode-trigger {
    max-width: 100%;
    height: 34px;
    display: grid;
    grid-template-columns: 14px minmax(0, auto) 13px;
    align-items: center;
    gap: 6px;
    padding: 0 9px;
    color: var(--text-1);
    background: transparent;
    border-radius: 999px;
    font-size: 12px;

    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    svg {
      color: var(--text-3);
    }

    &:hover {
      color: var(--text-1);
      background: var(--background-4);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }

  .work-mode-chip {
    height: 30px;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 0 9px 0 7px;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    font-size: 12px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active {
      transform: scale(.96);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }
  }

  .message-delivery-indicator {
    height: 26px;
    flex: 0 0 auto;
    padding: 0 8px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 999px;

    &.steer {
      color: var(--link-color);
      border-color: color-mix(in srgb, var(--link-color) 35%, var(--border-color));
    }
  }

  .permission-mode-menu {
    left: 0;
    bottom: 42px;
    width: min(278px, calc(100vw - 56px));

    .dropdown-menu-item {
      align-items: start;
    }
  }

  .permission-mode-copy {
    display: grid;
    gap: 2px;

    strong,
    small {
      display: block;
    }

    strong {
      color: var(--text-1);
      font-size: 12px;
      font-weight: 500;
    }

    small {
      color: var(--text-3);
      font-size: 10px;
      line-height: 1.35;
    }
  }

  @media (max-width: 560px) {
    .permission-mode-trigger {
      grid-template-columns: 14px;
      padding-inline: 8px;

      span,
      svg:last-child {
        display: none;
      }
    }
  }

  .model-input-holder {
    grid-area: model;
    justify-self: end;
    position: relative;
    min-width: 0;
    width: fit-content;
  }

  .model-input-trigger {
    min-width: 0;
    max-width: 220px;
    height: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14px;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    color: var(--text-1);
    background: transparent;
    border-radius: 999px;
    font-size: 12px;
    text-align: left;

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .model-input-effort {
    color: var(--text-3);
  }

  .model-input-trigger svg {
    color: var(--text-3);
  }

  .model-input-trigger:hover {
    color: var(--text-1);
    background: var(--background-4);
  }

  .model-input-menu {
    right: 0;
    bottom: 42px;
    width: min(260px, calc(100vw - 56px));
    gap: 4px;
  }

  .attachment-dropdown-menu {
    left: 0;
    bottom: 42px;
    min-width: 230px;
  }

  .model-input-menu-list {
    display: grid;
    gap: 8px;
    max-height: min(360px, calc(100vh - 180px));
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .model-menu-section {
    display: grid;
    gap: 2px;
  }

  .model-menu-section + .model-menu-section {
    padding-top: 8px;
    border-top: 1px solid var(--border-color);
  }

  .model-menu-section-title {
    min-height: 24px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;

    svg {
      flex: 0 0 auto;
      color: var(--text-3);
    }
  }

  .model-menu-model {
    border-radius: 8px !important;

    > span {
      overflow: visible;
      white-space: normal;
    }
  }

  .model-menu-model-copy {
    display: grid;
    gap: 1px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-size: 12px;
      font-weight: 500;
    }

    small {
      color: var(--text-3);
      font-size: 10px;
      font-weight: 400;
    }
  }

  .model-reasoning-submenu-holder {
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      right: -8px;
      bottom: 0;
      width: 8px;
    }
  }

  .model-reasoning-trigger {
    width: 100%;

    > span {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      svg {
        flex: 0 0 auto;
        color: var(--text-3);
      }
    }
  }

  .model-reasoning-submenu {
    top: -4px;
    left: calc(100% + 6px);
    width: 138px;
  }

  .model-reasoning-submenu .dropdown-menu-item:focus-visible,
  .model-reasoning-trigger:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: -2px;
  }

  .model-reasoning-check {
    width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
  }
}

.chat-empty .composer-wrap {
  background: transparent;
}

.queued-message-actions-menu {
  width: 174px;

  .dropdown-menu-item:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: -2px;
  }
}