.composer-wrap {
  position: absolute;
  bottom: var(--composer-bottom);
  left: 0;
  width: 100%;
  padding: 14px 28px 24px;
  transition: bottom 360ms var(--base-transition);

  .queued-messages {
    position: relative;
    z-index: 0;
    width: min(680px, 100%);
    max-height: min(210px, 28vh);
    margin: 0 auto -10px;
    padding: 6px 6px 14px;
    overflow: auto;
    color: var(--color-text);
    background: var(--surface-panel-soft);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border-panel);
    border-bottom: 0;
    border-radius: 16px 16px 0 0;
    list-style: none;
    scrollbar-width: thin;

    li {
      min-width: 0;
      min-height: 34px;
      display: grid;
      grid-template-columns: 22px 18px minmax(0, 1fr) auto;
      align-items: center;
      gap: 5px;
      padding: 3px 5px;
      border-radius: 8px;
      transition: background 180ms var(--base-transition),
        opacity 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      + li {
        border-top: 1px solid var(--color-divider-subtle);
      }

      &:hover,
      &:focus-within {
        background: var(--surface-neutral-hover);
      }

      &.dragging {
        opacity: .48;
        transform: scale(.99);
      }
    }
  }

  .queued-message-grip {
    width: 22px;
    height: 26px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-muted);
    background: transparent;
    border-radius: 6px;
    cursor: grab;
    opacity: 0;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      opacity 180ms var(--base-transition),
      transform 180ms var(--base-transition);
  }

  .queued-messages li:hover .queued-message-grip,
  .queued-messages li:focus-within .queued-message-grip,
  .queued-message-grip:focus-visible {
    opacity: 1;
  }

  .queued-message-grip:hover,
  .queued-message-grip:focus-visible {
    color: var(--color-text-strong);
    background: var(--surface-hover);
  }

  .queued-message-grip:active {
    cursor: grabbing;
    transform: scale(.92);
  }

  .queued-message-position {
    color: var(--color-muted-light);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .queued-message-copy {
    min-width: 0;
    overflow: hidden;
    color: var(--color-text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 12px;
  }

  .queued-message-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 0;
    transition: opacity 180ms var(--base-transition);
  }

  .queued-messages li:hover .queued-message-actions,
  .queued-messages li:focus-within .queued-message-actions,
  .queued-messages li.menu-open .queued-message-actions {
    opacity: 1;
  }

  .queued-message-actions button {
    min-width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0 7px;
    color: var(--color-muted-strong);
    background: transparent;
    border-radius: 9999px;
    font-size: 11px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover,
    &:focus-visible,
    &.active {
      color: var(--color-text-strong);
      background: var(--surface-hover);
    }

    &:active {
      transform: scale(.94);
    }
  }

  .queued-message-grip:focus-visible,
  .queued-message-actions button:focus-visible {
    outline: 2px solid var(--border-accent);
    outline-offset: 1px;
  }

  .queued-message-actions .queued-message-steer {
    padding-inline: 8px;
  }

  .composer {
    position: relative;
    z-index: 1;
    width: min(720px, 100%);
    margin: 0 auto;
    padding: 10px 8px 8px;
    background: var(--composer-input);
    border: 1px solid var(--composer-input-border);
    border-radius: 20px;

    &:focus-within {
      border-color: var(--border-accent);
    }
  }

  .composer-main {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(92px, 230px) auto;
    grid-template-areas: "input input input input"
      "plus spacer model send";
    column-gap: 7px;
    row-gap: 8px;
    align-items: end;

    > .round-button {
      grid-area: send;
      justify-self: end;
    }
  }

  .round-button {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
  }

  .send-button {
    color: var(--color-primary-text);
    background: var(--color-primary-fill);

    &:hover {
      color: var(--color-primary-text);
      background: var(--color-primary-hover);
    }
  }

  .model-pill {
    height: 34px;
    max-width: 270px;
    font-weight: 400;
    font-size: 1rem;
    padding: 0 11px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--color-text-secondary);
    border-radius: 8px;
    -webkit-app-region: no-drag;

    @media (max-width: 860px) {
      max-width: 120px;
    }
  }

  .composer textarea {
    grid-area: input;
    width: 100%;
    min-height: 48px;
    max-height: 500px;
    resize: none;
    border: 0;
    outline: 0;
    padding: 4px 6px 2px;
    overflow-y: hidden;
    color: var(--color-text-strong);
    background: transparent;
    font-size: 14px;
    line-height: 1.35;
  }

  .plus-holder {
    grid-area: plus;
    position: relative;
  }

  .model-input-holder {
    grid-area: model;
    justify-self: end;
    position: relative;
    min-width: 0;
    width: fit-content;
  }

  .model-input-trigger {
    min-width: 0;
    max-width: 170px;
    height: 34px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 14px;
    align-items: center;
    gap: 5px;
    padding: 0 10px;
    color: var(--color-text);
    background: transparent;
    border-radius: 999px;
    font-size: 12px;
    text-align: left;

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .model-input-effort {
    color: var(--color-muted);
  }

  .model-input-trigger svg {
    color: var(--color-menu-icon);
  }

  .model-input-trigger:hover {
    color: var(--color-text-strong);
    background: var(--surface-hover);
  }

  .model-input-menu {
    right: 0;
    bottom: 42px;
    width: min(260px, calc(100vw - 56px));
    gap: 4px;
  }

  .attachment-dropdown-menu {
    left: 0;
    bottom: 42px;
    min-width: 230px;
  }

  .model-input-menu-list {
    display: grid;
    gap: 2px;
  }

  .model-reasoning-submenu-holder {
    position: relative;

    &::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: -8px;
      width: 8px;
    }
  }

  .model-reasoning-trigger {
    width: 100%;

    > span {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;

      svg {
        flex: 0 0 auto;
        color: var(--color-menu-icon);
      }
    }
  }

  .model-reasoning-submenu {
    right: calc(100% + 6px);
    bottom: -4px;
    width: 138px;
  }

  .model-reasoning-submenu .dropdown-menu-item:focus-visible,
  .model-reasoning-trigger:focus-visible {
    outline: 2px solid var(--border-accent);
    outline-offset: -2px;
  }

  .model-reasoning-check {
    width: 16px;
    height: 16px;
    display: grid;
    place-items: center;
  }
}

.chat-empty .composer-wrap {
  background: transparent;
}

.queued-message-actions-menu {
  width: 174px;

  .dropdown-menu-item:focus-visible {
    outline: 2px solid var(--border-accent);
    outline-offset: -2px;
  }
}