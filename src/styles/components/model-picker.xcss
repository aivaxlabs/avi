.model-dialog {
  .model-picker-toolbar {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 220px;
    gap: 8px;
    margin: 10px 0 12px;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .model-filter-input,
  .model-provider-tabs {
    height: 30px;
    min-width: 0;
    color: var(--text-1);
    background: var(--background-2);
    border-radius: 99px;
  }

  .model-filter-input {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 8px;

    input {
      min-width: 0;
      width: 100%;
      border: 0;
      outline: 0;
      background: transparent;
      font-size: .9rem;
    }
  }

  .model-provider-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: hidden;

    button {
      min-width: 0;
      padding: 0 8px;
      color: var(--text-2);
      background: transparent;
      border-right: 1px solid var(--border-color);
      font-size: .9rem;
      font-weight: 500;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;

      &:last-child {
        border-right: 0;
      }

      &:hover {
        background: var(--item-hover);
      }

      &.active {
        color: var(--text-1);
        background: var(--item-active);
      }
    }
  }

  .search-results {
    min-height: 0;
    overflow: auto;
    display: grid;
    gap: 8px;
  }

  .model-provider-group {
    display: grid;
    gap: 7px;

    h3 {
      margin: 6px 2px 0;
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--text-2);
      font-size: .9rem;
      font-weight: 500;

      small {
        margin-left: auto;
        color: var(--text-3);
        font-size: .9rem;
        font-weight: 500;
      }
    }
  }

  .provider-fallback-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    color: var(--text-3);
    background: var(--background-4);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .favorite-button {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--text-4);
    background: transparent;
    border-radius: 999px;

    &.active {
      color: var(--text-2);
      background: var(--item-active);
    }
  }

  .model-table-wrap {
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .model-table {
    min-height: 0;
    overflow: auto;
    display: grid;
    align-content: start;
    gap: 2px;
    padding-right: 3px;

    .model-provider-group {
      gap: 2px;

      h3 {
        margin: 10px 4px 4px;
        padding-bottom: 5px;
        border-bottom: 1px dashed var(--border-color);
      }
    }
  }

  .model-row {
    min-height: 28px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px;
    align-items: center;
    border-radius: 4px;
    transition: background 180ms var(--base-transition);

    &.active {
      background: rgba(0, 0, 0, 0.18);
    }

    &:hover {
      background: var(--background-2);
    }

    &.active:hover {
      background: rgba(0, 0, 0, 0.22);
    }

    &:focus-within {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }
  }

  .model-row-content {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 74px 88px 88px;
    align-items: center;
    gap: 10px;
    padding: 4px 6px;
    color: var(--text-1);
    background: transparent;
    text-align: left;
    font-size: .9rem;
    transition: transform 180ms var(--base-transition);

    &:active {
      transform: scale(0.995);
    }

    strong,
    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      font-weight: 500;
    }

    @media (max-width: 700px) {
      grid-template-columns: minmax(140px, 1fr) 54px 64px 64px;
      gap: 6px;
    }
  }

  .model-row-name {
    display: grid;
    gap: 1px;
  }

  .model-row-content {
    small {
      color: var(--text-4);
      font-size: inherit;
      font-weight: 400;
    }

    span {
      color: var(--text-2);

      &:nth-child(2) {
        display: flex;
        align-items: center;
        gap: 5px;
        color: var(--text-3);
      }
    }
  }

  .model-row-capabilities {
    min-height: 18px;
  }

  .model-row .favorite-button {
    width: 24px;
    height: 24px;
  }

  .selected-model-details {
    min-height: 176px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;

    @media (max-width: 700px) {
      display: none;
    }
  }

  .selected-model-heading {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-bottom: 1px solid var(--border-color);

    div {
      min-width: 0;
      display: grid;
      gap: 2px;
    }

    span {
      color: var(--text-3);
      font-size: .9rem;
    }

    strong {
      overflow: hidden;
      color: var(--text-1);
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 1.1rem;
    }

    small {
      color: var(--text-4);
      font-size: inherit;
      font-weight: 400;
    }
  }

  .selected-model-body {
    min-height: 0;
    padding: 14px 10px;

    dl {
      margin: 0;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 18px;

      div {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 10px;
      }
    }

    dt {
      color: var(--text-3);
      font-size: .9rem;
      font-weight: 500;
    }

    dd {
      margin: 0;
      color: var(--text-1);
      font-size: .9rem;
      font-weight: 500;
      text-align: right;
      white-space: nowrap;
    }
  }

  .model-dialog-footer {
    margin-top: 12px;

    div {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
    }
  }
}

@media (prefers-reduced-motion: reduce) {

  .model-dialog .model-row,
  .model-dialog .model-row-content {
    transition: none;
  }

  .model-dialog .model-row-content:active {
    transform: none;
  }
}