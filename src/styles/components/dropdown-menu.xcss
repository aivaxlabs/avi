.dropdown-menu {
  position: absolute;
  width: 150px;
  padding: 4px;
  display: grid;
  gap: 2px;
  z-index: 120;
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 16px;
  box-shadow: 0 16px 40px rgb(0 0 0 / 22%);

  &.fixed {
    position: fixed;
  }

  &.conversation-filter-menu {
    width: 180px;
  }

  .dropdown-menu-item {
    min-width: 0;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    color: var(--text-1);
    background: transparent;
    border-radius: 12px;
    text-align: left;
    font-size: 12px;

    &.no-icon {
      grid-template-columns: minmax(0, 1fr);
    }

    &:hover {
      background: var(--item-hover);
    }

    &.active {
      background: var(--item-active);
    }

    &:disabled {
      color: var(--text-4);
      pointer-events: none;

      svg {
        color: var(--text-4);
      }
    }

    svg {
      color: var(--text-3);
    }

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .dropdown-menu-divider {
    height: 1px;
    margin: 2px 4px;
    background: var(--background-4);
  }

  .dropdown-menu-empty {
    padding: 7px 9px;
    color: var(--text-3);
    font-size: 12px;
  }
}
