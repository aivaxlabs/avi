.dropdown-menu {
  position: absolute;
  width: 150px;
  padding: 4px;
  display: grid;
  gap: 2px;
  z-index: 120;
  background: var(--surface-menu-solid);
  border: 1px solid var(--border-panel-strong);
  border-radius: 18px;
  box-shadow: 0 16px 40px var(--shadow-menu);

  &.fixed {
    position: fixed;
  }

  &.conversation-filter-menu {
    width: 180px;
  }

  .dropdown-menu-item {
    min-width: 0;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    color: var(--color-text-primary);
    background: transparent;
    border-radius: 9999px;
    text-align: left;
    font-size: 12px;

    &.no-icon {
      grid-template-columns: minmax(0, 1fr);
    }

    &:hover,
    &.active {
      background: var(--surface-neutral-hover);
    }

    &:disabled {
      color: var(--color-disabled-soft);
      pointer-events: none;

      svg {
        color: var(--color-disabled-icon);
      }
    }

    svg {
      color: var(--color-menu-icon);
    }

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .dropdown-menu-divider {
    height: 1px;
    margin: 2px 4px;
    background: var(--border-hairline);
  }

  .dropdown-menu-empty {
    padding: 7px 9px;
    color: var(--color-muted);
    font-size: 12px;
  }
}