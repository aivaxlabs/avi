.dropdown-menu {
  position: absolute;
  max-width: 220px;
  min-width: 110px;
  width: fit-content;
  padding: 4px;
  display: grid;
  gap: 2px;
  z-index: 120;
  background: --background-1;
  border: 1px solid --border-color;
  border-radius: 16px;
  box-shadow: 0 4px 9px #00000011;

  &.fixed {
    position: fixed;
  }

  &.conversation-filter-menu {
    width: 220px;
  }

  .dropdown-menu-item {
    min-width: 0;
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    color: --text-1;
    background: transparent;
    border-radius: 12px;
    text-align: left;
    font-size: .9rem;

    &.no-icon {
      grid-template-columns: minmax(0, 1fr);
    }

    &:hover {
      background: --item-hover;
    }

    &.active {
      background: --item-active;
    }

    &:disabled {
      color: --text-4;
      pointer-events: none;

      svg {
        color: --text-4;
      }
    }

    svg {
      color: --text-3;
    }

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  .dropdown-menu-divider {
    height: 1px;
    margin: 2px 4px;
    background: --background-4;
  }

  .dropdown-menu-label {
    padding: 6px 12px 2px;
    color: var(--text-4);
    font-size: 11px;
  }

  .dropdown-menu-empty {
    padding: 7px 9px;
    color: --text-3;
    font-size: 12px;
  }
}