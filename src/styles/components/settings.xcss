.settings-page {
  grid-column: 1 / -1;
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  color: var(--color-text);
  background: var(--surface-solid);
  overflow: hidden;

  @media (max-width: 860px) {
    grid-template-columns: 210px minmax(0, 1fr);
  }

  @media (max-width: 700px) {
    grid-template-columns: 176px minmax(0, 1fr);
  }

  .settings-sidebar {
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: var(--surface-muted);
    border-right: 1px solid var(--border-hairline);
    overflow: hidden;
  }

  .settings-sidebar-titlebar {
    flex: 0 0 34px;
  }

  .settings-back {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px;
    padding: 0 9px;
    color: var(--color-muted);
    background: transparent;
    border-radius: 7px;
    font-size: 12px;
    text-align: left;
  }

  .settings-back:hover,
  .settings-navigation button:hover,
  .settings-inline-back:hover,
  .settings-entity-main:hover {
    color: var(--color-text-primary);
    background: var(--surface-neutral-hover);
  }

  .settings-sidebar-heading {
    padding: 14px 16px 12px;

    @media (max-width: 700px) {
      padding-inline: 12px;
    }
  }

  .settings-search {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 4px 8px 10px;
    padding: 0 9px;
    color: var(--color-muted-light);
    background: var(--surface-input);
    border: 1px solid var(--border-input);
    border-radius: 7px;

    &:focus-within {
      border-color: var(--border-accent);
    }

    input {
      width: 100%;
      min-width: 0;
      padding: 0;
      color: var(--color-text-primary);
      background: transparent;
      border: 0;
      outline: 0;
      font-size: 11px;
    }
  }

  .settings-sidebar-heading h1,
  .settings-sidebar-heading p,
  .settings-page-header h2,
  .settings-page-header p,
  .settings-section-heading h3,
  .settings-section-heading p {
    margin: 0;
  }

  .settings-sidebar-heading h1 {
    color: var(--color-text-strong);
    font-size: 18px;
    line-height: 1.3;
  }

  .settings-sidebar-heading p {
    margin-top: 3px;
    color: var(--color-muted);
    font-size: 11px;
  }

  .settings-navigation {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 0 8px 14px;

    > span {
      padding: 8px;
      color: var(--color-muted-light);
      font-size: 11px;
      font-weight: 500;
    }

    button {
      min-height: 34px;
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 0 9px;
      color: var(--color-text-primary);
      background: transparent;
      border-radius: 7px;
      font-size: 12px;
      text-align: left;

      &.active {
        color: var(--color-text-strong);
        background: var(--surface-neutral-hover);
        font-weight: 500;
      }
    }
  }

  .settings-main {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: var(--surface-solid);
  }

  .settings-page-header {
    padding: 82px 48px 30px;

    @media (max-width: 860px) {
      padding: 72px 32px 26px;
    }

    @media (max-width: 700px) {
      padding: 56px 20px 22px;
    }
  }

  .settings-page-header > div,
  .settings-content-inner {
    width: min(768px, 100%);
    margin: 0 auto;
  }

  .settings-inline-back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 14px -6px;
    padding: 5px 7px;
    color: var(--color-muted);
    background: transparent;
    border-radius: 6px;
    font-size: 11px;
  }

  .settings-page-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    @media (max-width: 700px) {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }

  .settings-page-header h2 {
    color: var(--color-text-strong);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
  }

  .settings-page-header p {
    margin-top: 6px;
    color: var(--color-muted);
    font-size: 12px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .settings-add-provider,
  .settings-provider-empty .primary-mini,
  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 7px 10px;
    border-radius: 7px;
    font-size: 12px;
    white-space: nowrap;
  }

  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;

    &:hover:not(:disabled) {
      background: var(--color-primary-hover) !important;
    }

    &:active:not(:disabled) {
      transform: scale(0.98);
    }

    &:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }
  }

  .settings-content {
    min-height: 0;
    padding: 8px 48px 48px;
    overflow: auto;

    @media (max-width: 860px) {
      padding: 8px 32px 40px;
    }

    @media (max-width: 700px) {
      padding: 8px 20px 32px;
    }
  }

  .settings-content-inner {
    min-height: 100%;
  }

  .settings-section {
    display: grid;
    gap: 16px;
  }

  .settings-tuning {
    display: grid;
    gap: 38px;

    @media (max-width: 700px) {
      gap: 30px;
    }

    .settings-section {
      gap: 12px;
    }

    .settings-section-card {
      gap: 0;
      padding: 0 16px;
      overflow: hidden;
    }

    .settings-field {
      min-height: 66px;
      grid-template-columns: minmax(0, 1fr) minmax(150px, auto);
      column-gap: 24px;
      row-gap: 3px;
      padding: 12px 0;

      + .settings-field {
        border-top: 1px solid var(--border-hairline);
      }

      > span {
        grid-column: 1;
        grid-row: 1;
        color: var(--color-text-strong);
        font-weight: 500;
      }

      input,
      select {
        grid-column: 2;
        grid-row: 1 / 3;
        align-self: center;
        justify-self: end;
        width: min(280px, 100%);
        height: 32px;
        padding-block: 5px;
      }

      input[type="number"] {
        width: 120px;
      }

      small {
        grid-column: 1;
        grid-row: 2;
      }

      @media (max-width: 700px) {
        grid-template-columns: minmax(0, 1fr);

        input,
        select {
          grid-column: 1;
          grid-row: 3;
          justify-self: stretch;
          width: 100%;
        }

        input[type="number"] {
          width: 100%;
        }
      }
    }
  }

  .settings-section-heading h3 {
    color: var(--color-text-strong);
    font-size: 14px;
    font-weight: 500;
  }

  .settings-section-heading p {
    margin-top: 3px;
    color: var(--color-muted);
    font-size: 11px;
  }

  .settings-section-card {
    padding: 24px;
    background: var(--surface-solid);
    border: 1px solid var(--border-panel);
    border-radius: 14px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .models-editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .settings-list-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--color-muted);
    font-size: 11px;
  }

  .settings-entity-list {
    display: grid;
    gap: 3px;
  }

  .settings-entity-row {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36px;
    align-items: center;
    border-radius: 9px;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      opacity 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-panel-strong);
    }

    &.disabled {
      opacity: .64;
    }
  }

  .settings-entity-main {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 12px;
    padding: 10px 8px 10px 12px;
    color: var(--color-text-primary);
    background: transparent;
    border-radius: 8px;
    text-align: left;

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr) 16px;
    }

    &:active {
      background: var(--surface-muted);
    }
  }

  .settings-entity-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--color-icon);
    background: var(--surface-muted);
    border: 1px solid var(--border-control);
    border-radius: 8px;
  }

  .settings-entity-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 500;
    }

    small {
      color: var(--color-muted);
      font-size: 10px;
    }
  }

  .settings-status {
    padding: 3px 7px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 400;

    @media (max-width: 700px) {
      display: none;
    }

    &.enabled {
      color: var(--color-live);
      background: var(--surface-accent-soft);
    }

    &.disabled {
      color: var(--color-muted);
      background: var(--surface-muted);
    }
  }

  .settings-entity-arrow {
    color: var(--color-muted-light);
  }

  .settings-entity-row > .icon-button {
    justify-self: center;
  }

  .settings-context-folder-row {
    grid-template-columns: minmax(0, 1fr);

    .settings-entity-main {
      width: 100%;
    }

    @media (max-width: 700px) {
      .settings-entity-main {
        grid-template-columns: 34px minmax(0, 1fr) 16px;
        grid-template-rows: auto auto;
      }

      .settings-context-summary {
        grid-column: 2;
        grid-row: 2;
      }

      .settings-entity-arrow {
        grid-column: 3;
        grid-row: 1 / 3;
      }
    }
  }

  .settings-context-summary {
    color: var(--color-muted);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .settings-context-groups {
    display: grid;
    gap: 28px;
  }

  .settings-context-group {
    display: grid;
    gap: 10px;
  }

  .settings-context-group-header {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    h3 {
      margin: 0;
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 500;
    }

    span {
      min-width: 20px;
      padding: 2px 6px;
      color: var(--color-muted);
      background: var(--surface-muted);
      border-radius: 999px;
      font-size: 10px;
      text-align: center;
    }
  }

  .settings-context-item-list {
    overflow: hidden;
    background: var(--surface-solid);
    border: 1px solid var(--border-panel);
    border-radius: 9px;
  }

  .settings-context-item {
    width: 100%;
    min-width: 0;
    min-height: 66px;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--color-text-primary);
    background: transparent;
    border-radius: 0;
    text-align: left;
    transition: background-color 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    &:hover {
      background: var(--surface-neutral-hover);
    }

    &:active {
      background: var(--surface-muted);
    }

    + .settings-context-item {
      border-top: 1px solid var(--border-hairline);
    }
  }

  .settings-context-item-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong {
      overflow: hidden;
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      display: -webkit-box;
      overflow: hidden;
      color: var(--color-muted);
      font-size: 10px;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }

  .settings-context-token-count {
    color: var(--color-muted);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;

    @media (max-width: 700px) {
      grid-column: 2;
    }
  }

  .settings-context-group-empty {
    padding: 22px 16px;
    color: var(--color-muted);
    background: var(--surface-slate-faint);
    font-size: 11px;
    text-align: center;
  }

  .settings-context-error {
    padding: 10px 12px;
    color: var(--color-danger);
    background: var(--surface-slate-faint);
    border: 1px solid var(--border-panel);
    border-radius: 8px;
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .provider-type-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .provider-type-card {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 16px;
    color: var(--color-text-primary);
    background: var(--surface-solid);
    border: 1px solid var(--border-panel);
    border-radius: 10px;
    text-align: left;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-panel-strong);
      box-shadow: 0 7px 22px var(--shadow-soft);
      transform: translateY(-1px);
    }

    &:active {
      transform: translateY(0);
    }

    > span:nth-child(2) {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    strong {
      color: var(--color-text-strong);
      font-size: 12px;
    }

    small,
    code {
      color: var(--color-muted);
      font-size: 10px;
    }

    code {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    > svg {
      color: var(--color-muted-light);
    }
  }

  .settings-provider-detail {
    display: grid;
    gap: 32px;
  }

  .settings-form,
  .model-editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .settings-field {
    min-width: 0;
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    align-items: center;
    column-gap: 20px;
    row-gap: 6px;
    color: var(--color-text-primary);
    font-size: 12px;
    font-weight: 400;

    > span {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .settings-field-wide {
    grid-column: auto;
  }

  .settings-field input,
  .settings-field select {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    min-width: 0;
    height: 40px;
    padding: 8px;
    color: var(--color-text-primary);
    background: var(--surface-input);
    border: 1px solid var(--border-input);
    border-radius: 7px;
    outline: 0;
    font-size: 12px;
  }

  .settings-field input:focus,
  .settings-field select:focus {
    border-color: var(--border-accent);
  }

  .settings-field small {
    grid-column: 2;
    grid-row: 2;
    color: var(--color-muted);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.5;
  }

  .settings-field small.settings-field-warning {
    color: var(--color-danger);
  }

  .subscription-auth {
    align-items: start;

    > .subscription-auth-row {
      grid-column: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    button {
      min-height: 34px;
      padding: 7px 12px;
      color: var(--color-text-strong);
      background: var(--surface-muted);
      border: 1px solid var(--border-hairline);
      border-radius: 7px;
      font-size: 12px;

      &:hover:not(:disabled) {
        background: var(--surface-hover);
      }
    }

    small + small {
      grid-row: 3;
    }
  }

  .provider-security-code {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 12px;
    padding: 12px;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    border-radius: 7px;

    > span,
    > small {
      grid-column: 1 / -1;
    }

    > span {
      color: var(--color-muted);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    code {
      color: var(--color-text-strong);
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.12em;
      user-select: all;
    }

    > small {
      color: var(--color-muted);
      font-size: 11px;
      line-height: 1.5;
    }
  }

  .models-editor-header h3,
  .models-editor-header p {
    margin: 0;
  }

  .models-editor-header h3 {
    color: var(--color-text-strong);
    font-size: 14px;
  }

  .models-editor-header p {
    margin-top: 2px;
    color: var(--color-muted);
    font-size: 11px;
  }

  .models-editor-header button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 6px 9px;
    color: var(--color-text-soft);
    background: var(--surface-muted);
    border: 1px solid var(--border-control);
    border-radius: 7px;
    font-size: 12px;

    &:hover {
      background: var(--surface-hover);
    }
  }

  .model-editor-card {
    display: grid;
    gap: 24px;
    padding: 24px;
    background: var(--surface-solid);
    border: 1px solid var(--border-panel);
    border-radius: 10px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .model-options-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .model-option-row {
    min-width: 0;
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    align-items: center;
    column-gap: 20px;
    padding: 0;
    border: 0;
  }

  .model-option-label {
    grid-column: 1;
    grid-row: 1;
    color: var(--color-text-primary);
    font-size: 12px;
  }

  .model-option-controls {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .model-options-row label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--color-text-soft);
    font-size: 12px;
  }

  .model-options-row input {
    accent-color: var(--color-brand-blue);
  }

  .reasoning-options label {
    text-transform: lowercase;
  }

  .settings-empty {
    min-height: 320px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: var(--color-muted);
    font-size: 12px;
  }

  .settings-provider-empty strong {
    color: var(--color-text-strong);
    font-size: 13px;
  }

  .settings-provider-empty span {
    text-align: center;
  }

  .settings-models-locked {
    padding: 28px 20px;
    color: var(--color-muted);
    background: var(--surface-slate-faint);
    border: 1px dashed var(--border-panel);
    border-radius: 9px;
    text-align: center;
    font-size: 11px;
  }

  .subscription-models {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    line-height: 1.5;
  }

  .settings-actions {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 48px;
    background: var(--surface-menu-solid);
    border-top: 1px solid var(--border-hairline);

    @media (max-width: 860px) {
      padding-inline: 32px;
    }

    @media (max-width: 700px) {
      align-items: stretch;
      flex-direction: column;
      padding: 10px 20px;
    }

    > div {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 7px;
    }
  }

  .settings-error {
    flex: 1;
    min-width: 0;
    color: var(--color-danger);
    overflow-wrap: anywhere;
  }

  .settings-models-empty {
    padding: 56px 22px;
    background: var(--surface-slate-faint);
    border: 1px dashed var(--border-panel);
    border-radius: 10px;
  }
}

.settings-action-menu {
  position: fixed;
  z-index: 180;
}

.settings-row-menu {
  position: static;
  width: 184px;
  border-radius: 10px;

  .dropdown-menu-item {
    border-radius: 7px;

    &.danger {
      color: var(--color-danger);

      svg {
        color: currentColor;
      }
    }

    &:active {
      background: var(--surface-muted);
    }
  }
}

.settings-back:focus-visible,
.settings-navigation button:focus-visible,
.settings-inline-back:focus-visible,
.settings-page-header button:focus-visible,
.settings-entity-main:focus-visible,
.settings-entity-row > .icon-button:focus-visible,
.settings-context-group-header > .icon-button:focus-visible,
.settings-context-item:focus-visible,
.settings-row-menu .dropdown-menu-item:focus-visible,
.provider-type-card:focus-visible,
.settings-actions button:focus-visible,
.mcp-editor-actions button:focus-visible,
.models-editor-header button:focus-visible,
.settings-field input:focus-visible,
.settings-field select:focus-visible {
  outline: 2px solid var(--border-accent);
  outline-offset: 2px;
}
