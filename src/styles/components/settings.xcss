.settings-page {
  grid-column: 1 / -1;
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  color: var(--text-1);
  background: var(--background-1);
  overflow: hidden;

  @media (max-width: 860px) {
    grid-template-columns: 210px minmax(0, 1fr);
  }

  @media (max-width: 700px) {
    grid-template-columns: 176px minmax(0, 1fr);
  }

  .settings-sidebar {
    min-height: 0;
    padding: 0 4px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .settings-sidebar-titlebar {
    flex: 0 0 24px;
  }

  .settings-back {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px;
    padding: 0 9px;
    color: var(--text-3);
    background: transparent;
    border-radius: 7px;
    text-align: left;
  }

  .settings-back:hover,
  .settings-navigation button:hover,
  .settings-inline-back:hover,
  .settings-entity-main:hover {
    color: var(--text-1);
    background: var(--item-hover);
  }

  .settings-sidebar-heading {
    padding: 14px 16px 12px;

    @media (max-width: 700px) {
      padding-inline: 12px;
    }
  }

  .settings-search {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 4px 8px 10px;
    padding: 0 9px;
    color: var(--text-4);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    &:focus-within {
      border-color: var(--text-3);
    }

    input {
      width: 100%;
      min-width: 0;
      padding: 0;
      color: var(--text-1);
      background: transparent;
      border: 0;
      outline: 0;
    }
  }

  .settings-sidebar-heading h1,
  .settings-sidebar-heading p,
  .settings-page-header h2,
  .settings-page-header p,
  .settings-section-heading h3,
  .settings-section-heading p {
    margin: 0;
  }

  .settings-sidebar-heading h1 {
    color: var(--text-1);
    font-size: 18px;
    line-height: 1.3;
  }

  .settings-sidebar-heading p {
    margin-top: 3px;
    color: var(--text-3);
    font-size: 11px;
  }

  .settings-navigation {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 0 8px 14px;

    > span {
      padding: 8px;
      color: var(--text-4);
      font-weight: 500;
    }

    .settings-navigation-separator {
      height: 1px;
      margin: 8px 8px 6px;
      background: var(--background-3);
    }

    button {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 6px 12px;
      color: var(--text-1);
      background: transparent;
      border-radius: 10px;
      font-size: 1rem;
      text-align: left;

      svg {
        opacity: .7;
      }

      & :hover {
        background-color: --background-4;
      }

      & .active {
        color: var(--text-1);
        background: var(--item-active);
      }
    }
  }

  .settings-main {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: var(--background-1);
  }

  .settings-page-header {
    padding: 82px 48px 30px;

    @media (max-width: 860px) {
      padding: 72px 32px 26px;
    }

    @media (max-width: 700px) {
      padding: 56px 20px 22px;
    }
  }

  .settings-page-header > div,
  .settings-content-inner {
    width: min(768px, 100%);
    margin: 0 auto;
  }

  .settings-inline-back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 14px -6px;
    padding: 5px 7px;
    color: var(--text-3);
    background: transparent;
    border-radius: 6px;
    font-size: .9rem;
  }

  .settings-page-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    @media (max-width: 700px) {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }

  .settings-page-header h2 {
    color: var(--text-1);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
  }

  .settings-page-header p {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .settings-add-provider,
  .settings-provider-empty .primary-mini,
  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    font-size: .9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .settings-add-provider-group {
    position: relative;
    flex: 0 0 auto;
    display: inline-flex;
    border-radius: 9999px;

    &:has(.settings-add-provider-menu-trigger:focus-visible) {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    .settings-add-provider {
      border-radius: 9999px 0 0 9999px;
    }

    .settings-add-provider-menu-trigger {
      min-width: 30px;
      display: grid;
      place-items: center;
      padding: 7px;
      border-left: 1px solid color-mix(in srgb, currentColor 25%, transparent);
      border-radius: 0 9999px 9999px 0;

      &:focus-visible {
        outline: none;
      }
    }

    .settings-add-provider-menu {
      top: calc(100% + 5px);
      right: 0;
      width: 180px;
      border-radius: 8px;

      .dropdown-menu-item {
        border-radius: 5px;
      }
    }
  }

  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;

    &:hover:not(:disabled) {
      background: var(--background-5) !important;
    }

    &:active:not(:disabled) {
      transform: scale(0.98);
    }

    &:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }
  }

  .settings-content {
    min-height: 0;
    padding: 8px 48px 48px;
    overflow: auto;

    @media (max-width: 860px) {
      padding: 8px 32px 40px;
    }

    @media (max-width: 700px) {
      padding: 8px 20px 32px;
    }
  }

  .settings-content-inner {
    min-height: 100%;
  }

  .settings-section {
    display: grid;
    gap: 16px;
  }

  .settings-tuning {
    display: grid;
    gap: 38px;

    @media (max-width: 700px) {
      gap: 30px;
    }

    .settings-section {
      gap: 12px;
    }
  }

  .settings-section-heading h3 {
    color: var(--text-1);
    font-size: 14px;
    font-weight: 500;
  }

  .settings-section-heading p {
    margin-top: 3px;
    color: var(--text-3);
    font-size: --font-sm;
  }

  .settings-section-card {
    padding: 1em;
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 14px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .settings-row-card {
    gap: 0;
    padding: 0;
    overflow: hidden;

    @media (max-width: 700px) {
      padding: 0;
    }

    > .settings-field,
    > .settings-toggle-row,
    > .settings-card-row {
      min-height: 72px;
      padding: 16px 18px;
    }

    > :not(:first-child) {
      border-top: 1px solid var(--border-color);
    }
  }

  .settings-card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .aivax-features-settings {
    .aivax-settings-loading {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--text-3);
    }

    .aivax-spinner,
    .aivax-settings-loading svg {
      animation: aivax-settings-spin 800ms linear infinite;
    }

    .aivax-account-row > span {
      min-width: 0;
      display: grid;
      gap: 4px;

      strong {
        font-weight: 400;
      }

      small {
        overflow: hidden;
        color: var(--text-3);
        text-overflow: ellipsis;
      }
    }

    .aivax-account-actions {
      flex: 0 0 132px;
      display: flex;
      justify-content: flex-end;

      .button {
        justify-content: center;
        min-width: 112px;
        white-space: nowrap;
      }
    }

    &.aivax-landing {
      display: grid;
      gap: 32px;
      padding: 16px 0 8px;
    }

    > .aivax-landing-intro {
      display: grid;
      grid-template-columns: 168px minmax(0, 1fr);
      align-items: start;
      gap: 32px;
      padding-bottom: 32px;
      border-bottom: 1px solid var(--border-color);

      > .aivax-landing-logo {
        width: 144px;
        height: auto;
        margin-top: 4px;
        object-fit: contain;

        :root[data-color-scheme="dark"] & {
          filter: invert(1);
        }
      }

      > div {
        > h3 {
          margin: 0;
          color: var(--text-1);
          font-size: 18px;
          font-weight: 500;
          line-height: 1.4;
        }

        > p {
          max-width: 520px;
          margin: 8px 0 0;
          color: var(--text-3);
          font-size: 12px;
          line-height: 1.6;
          text-wrap: pretty;
        }

        > .aivax-landing-actions {
          display: flex;
          flex-wrap: wrap;
          align-items: center;
          gap: 8px;
          margin-top: 20px;
        }

        > .aivax-landing-security {
          max-width: 520px;
          margin-top: 16px;
          color: var(--text-4);
          font-size: 10px;
          line-height: 1.5;
        }
      }
    }

    .aivax-link-account,
    .aivax-create-account,
    .aivax-login-cancel {
      min-height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 12px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 500;

      > svg {
        margin: 0;
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 2px;
      }

      &:disabled {
        cursor: not-allowed;
        opacity: .55;
      }
    }

    .aivax-create-account {
      color: var(--text-2);
      background: transparent;

      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }
    }

    .aivax-login-cancel {
      color: var(--text-2);
      background: var(--background-3);

      &:hover:not(:disabled) {
        background: var(--item-hover);
      }
    }

    > .aivax-landing-features {
      display: grid;
      grid-template-columns: 168px minmax(0, 1fr);
      align-items: start;
      gap: 32px;

      > h3 {
        margin: 0;
        color: var(--text-2);
        font-size: 12px;
        font-weight: 500;
        line-height: 1.5;
      }

      > dl {
        margin: 0;
        border-top: 1px solid var(--border-color);

        > div {
          min-height: 56px;
          display: grid;
          grid-template-columns: 160px minmax(0, 1fr);
          align-items: center;
          gap: 24px;
          padding: 12px 0;
          border-bottom: 1px solid var(--border-color);

          > dt {
            color: var(--text-1);
            font-size: 11px;
            font-weight: 500;
          }

          > dd {
            margin: 0;
            color: var(--text-3);
            font-size: 11px;
            line-height: 1.5;
            text-wrap: pretty;
          }
        }
      }
    }

    .aivax-login-dialog-backdrop {
      z-index: 90;
    }

    .aivax-login-dialog {
      width: min(460px, 100%);
      display: grid;
      gap: 24px;
      padding: 24px;
      color: var(--text-1);
      background: var(--background-1);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      box-shadow: 0 24px 72px rgb(0 0 0 / 28%);

      > .dialog-header {
        > div {
          min-width: 0;

          > img {
            width: 88px;
            height: auto;
            margin-bottom: 24px;

            :root[data-color-scheme="dark"] & {
              filter: invert(1);
            }
          }

          > h2 {
            margin: 0;
            font-size: 16px;
            font-weight: 500;
          }

          > p {
            max-width: 380px;
            margin: 8px 0 0;
            color: var(--text-3);
            font-size: 11px;
            line-height: 1.6;
            text-wrap: pretty;
          }
        }
      }
    }

    .aivax-login-form {
      display: grid;
      gap: 16px;

      > label {
        min-width: 0;
        display: grid;
        gap: 8px;

        > span {
          color: var(--text-2);
          font-size: 11px;
          font-weight: 500;
        }

        > input {
          width: 100%;
          height: 40px;
          padding: 8px 12px;
          color: var(--text-1);
          background: var(--background-0);
          border: 1px solid var(--border-color);
          border-radius: 8px;
          outline: 0;
          font-family: var(--font-code);
          font-size: 12px;

          &:focus-visible {
            border-color: var(--text-3);
            box-shadow: 0 0 0 2px var(--background-4);
          }
        }
      }

      > .aivax-login-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
      }
    }

    .aivax-collection-row {
      > span {
        min-width: 0;
        display: grid;
        gap: 4px;

        strong {
          font-weight: 400;
        }

        small {
          overflow: hidden;
          color: var(--text-3);
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }
    }

    .aivax-collection-picker-trigger {
      flex: 0 1 310px;
      min-width: 170px;
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 22px;
      color: var(--text-1);
      text-align: left;
    }

    .aivax-collection-dialog-backdrop {
      z-index: 80;
    }

    .aivax-collection-dialog {
      width: min(520px, 100%);
      max-height: min(620px, 88vh);
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: 16px;
      padding: 18px;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

      .dialog-header p {
        margin: 3px 0 0;
        color: var(--text-3);
        font-size: 13px;
        line-height: 1.45;
      }
    }

    .aivax-collection-list {
      min-height: 110px;
      overflow: auto;
      display: grid;
      align-content: start;
      gap: 6px;
      padding: 4px;
      border: 1px solid var(--border-color);
      border-radius: 10px;

      > button {
        width: 100%;
        min-height: 58px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 12px;
        color: var(--text-1);
        background: transparent;
        border: 1px solid transparent;
        border-radius: 7px;
        text-align: left;

        &:hover:not(:disabled) {
          background: var(--item-hover);
        }

        &.selected {
          background: var(--background-3);
          border-color: var(--border-color);
        }

        > span:first-child {
          min-width: 0;
          display: grid;
          gap: 3px;

          strong {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 500;
          }

          small {
            color: var(--text-3);
          }
        }
      }
    }

    .aivax-collection-selected {
      flex: 0 0 auto;
      padding: 3px 7px;
      color: var(--text-2);
      background: var(--background-4);
      border-radius: 999px;
      font-size: 11px;
    }

    .aivax-collection-empty {
      margin: 0;
      padding: 26px 16px;
      color: var(--text-3);
      text-align: center;
      font-size: 13px;
      line-height: 1.45;
    }

    .aivax-collection-create-trigger {
      justify-self: start;
    }

    .aivax-collection-create-dialog {
      width: min(440px, 100%);
      grid-template-rows: auto auto;
    }

    .aivax-collection-create {
      display: grid;
      gap: 16px;

      label {
        min-width: 0;
        display: grid;
        gap: 6px;

        > span {
          color: var(--text-2);
          font-size: 12px;
          font-weight: 500;
        }
      }

      input {
        width: 100%;
        height: 34px;
        padding: 6px 10px;
        color: var(--text-1);
        background: var(--background-1);
        border: 1px solid var(--border-color);
        border-radius: 7px;
        outline: 0;

        &:focus-visible {
          border-color: var(--text-3);
        }
      }
    }

    .aivax-collection-create-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;

      .button {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
      }
    }

    @media (max-width: 700px) {
      > .aivax-landing-intro,
      > .aivax-landing-features {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      > .aivax-landing-intro {
        padding-bottom: 24px;

        > .aivax-landing-logo {
          width: 128px;
          margin-top: 0;
        }
      }

      > .aivax-landing-features > dl > div {
        grid-template-columns: 1fr;
        gap: 4px;
        padding: 12px 0;
      }

      .aivax-login-dialog-backdrop {
        padding: 16px;
      }

      .aivax-login-dialog {
        padding: 20px;

        > .dialog-header > div > img {
          margin-bottom: 16px;
        }
      }

      .aivax-login-form > .aivax-login-actions {
        flex-direction: column-reverse;

        > button {
          width: 100%;
        }
      }

      .aivax-account-actions {
        flex-basis: auto;
        width: 100%;
        justify-content: flex-start;
      }

      .aivax-collection-row {
        align-items: stretch;
        flex-direction: column;
      }

      .aivax-collection-picker-trigger {
        flex-basis: auto;
        width: 100%;
      }

      .aivax-collection-create-actions {
        flex-direction: column-reverse;

        .button {
          width: 100%;
          justify-content: center;
        }
      }
    }
  }

  .settings-about {
    display: grid;
    gap: 24px;
  }

  .settings-about-hero {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 14px;

    h3,
    p {
      margin: 0;
    }

    h3 {
      font-size: 20px;
      font-weight: 500;
    }

    p {
      max-width: 520px;
      margin-top: 5px;
      color: var(--text-3);
      line-height: 1.55;
      text-wrap: pretty;
    }
  }

  .settings-about-logo {
    width: 256px;
    height: 256px;
    flex: 0 0 auto;
    border-radius: 20px;
    object-fit: contain;

    :root[data-color-scheme="dark"] & {
      filter: invert(1);
    }
  }

  .settings-about-details {
    margin: 0;
    border-block: 1px solid var(--border-color);

    > div {
      min-height: 52px;
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      align-items: center;
      gap: 18px;
      padding: 10px 4px;

      + div {
        border-top: 1px solid var(--border-color);
      }
    }

    dt {
      color: var(--text-3);
    }

    dd {
      min-width: 0;
      margin: 0;
      color: var(--text-1);
      overflow-wrap: anywhere;
    }
  }

  .settings-about-link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-1);
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 180ms var(--base-transition),
      text-decoration-color 180ms var(--base-transition);

    &:hover {
      color: var(--link-color);
      text-decoration-color: currentColor;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .settings-about-credit {
    margin: 0;
    color: var(--text-3);
  }

  .models-editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .provider-import-dialog-backdrop {
    z-index: 85;
  }

  .provider-import-dialog {
    width: min(660px, 100%);
    max-height: min(760px, 90vh);
    display: grid;
    gap: 16px;
    padding: 18px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    box-shadow: 0 28px 90px rgb(0 0 0 / 30%);
    overflow: auto;

    .dialog-header p {
      max-width: 520px;
      margin: 2px 0 0;
      color: var(--text-3);
      font-size: .9rem;
      line-height: 1.5;
    }

    .dialog-footer {
      margin-top: 0;
      align-items: end;

      > span {
        max-width: 390px;
        line-height: 1.45;
      }

      > div {
        display: flex;
        gap: 7px;
      }

      .primary-mini {
        color: var(--text-5);
        background: var(--background-5);
        border-color: transparent;
      }

      button:disabled {
        opacity: .5;
        cursor: wait;
      }
    }

    @media (max-width: 700px) {
      max-height: 100vh;
      border: 0;
      border-radius: 0;
    }

    @media (max-width: 560px) {
      .dialog-footer {
        align-items: stretch;
        display: grid;

        > span {
          max-width: none;
        }

        > div {
          justify-content: end;
        }
      }
    }
  }

  .provider-import-source-dialog {
    width: min(520px, 100%);
  }

  .provider-share-dialog {
    width: min(470px, 100%);
    gap: 18px;
    padding: 20px;
    overflow: visible;

    .dialog-header p {
      max-width: 360px;
    }

    .dialog-footer {
      align-items: center;
      justify-content: space-between;

      > div {
        flex-wrap: wrap;
        justify-content: end;
      }

      button {
        white-space: nowrap;
      }
    }

    @media (max-width: 560px) {
      .dialog-footer {
        display: flex;
        align-items: center;

        > div {
          max-width: 260px;
        }
      }
    }
  }

  .provider-share-summary,
  .provider-share-warning {
    display: flex;
    align-items: center;
    gap: 11px;

    > span:last-child {
      min-width: 0;
      display: grid;
      gap: 2px;
    }

    strong {
      color: var(--text-1);
      font-size: 13px;
      font-weight: 500;
    }

    small {
      color: var(--text-3);
      font-size: 12px;
      line-height: 1.4;
    }
  }

  .provider-share-summary {
    padding: 2px 0;
  }

  .provider-share-icon {
    width: 36px;
    height: 36px;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .provider-share-warning {
    align-items: start;
    padding: 11px 12px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 8px;

    > svg {
      flex: 0 0 auto;
      margin-top: 1px;
      color: var(--text-2);
    }
  }

  .provider-import-url-field,
  .provider-import-json-field {
    display: grid;
    gap: 7px;
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;

    input,
    textarea {
      width: 100%;
      padding: 10px 11px;
      color: var(--text-1);
      background: var(--background-4);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font: inherit;
      font-size: 13px;

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }

    textarea {
      min-height: 210px;
      resize: vertical;
      font-family: var(--font-mono);
      line-height: 1.5;
      tab-size: 2;
    }

    small {
      color: var(--text-3);
      font-weight: 400;
      line-height: 1.45;
    }
  }

  .provider-import-review {
    display: grid;
    gap: 14px;

    dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      margin: 0;
      overflow: hidden;
      background: var(--border-color);
      border: 1px solid var(--border-color);
      border-radius: 8px;

      @media (max-width: 560px) {
        grid-template-columns: 1fr;
      }

      div {
        min-width: 0;
        display: grid;
        gap: 4px;
        padding: 10px 11px;
        background: var(--background-3);
      }

      dt {
        color: var(--text-3);
        font-size: 11px;
      }

      dd {
        margin: 0;
        overflow: hidden;
        color: var(--text-1);
        font-size: 12px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    section {
      display: grid;
      gap: 8px;

      > strong {
        font-size: 12px;
        font-weight: 500;
      }

      > p {
        margin: 0;
        color: var(--text-3);
        font-size: 12px;
      }
    }

    ul {
      max-height: 190px;
      display: grid;
      gap: 1px;
      margin: 0;
      padding: 1px;
      overflow: auto;
      list-style: none;
      background: var(--border-color);
      border-radius: 8px;
    }

    li {
      min-width: 0;
      display: grid;
      gap: 2px;
      padding: 8px 10px;
      background: var(--background-3);

      span,
      small {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      span {
        font-size: 12px;
      }

      small {
        color: var(--text-3);
        font-size: 11px;
      }
    }
  }

  .provider-import-warning,
  .provider-import-error {
    margin: 0;
    padding: 9px 10px;
    color: var(--text-2);
    background: var(--background-4);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.45;
  }

  .provider-import-error {
    color: var(--text-1);
  }

  .settings-provider-notice {
    padding: 9px 11px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 12px;

    &.error {
      color: var(--text-1);
    }
  }

  .settings-list-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-3);
    font-size: 11px;
  }

  .settings-entity-list {
    display: grid;
    gap: 3px;
  }

  .settings-entity-row {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36px;
    align-items: center;
    border-radius: 9px;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      opacity 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-color);
    }

    &.disabled {
      opacity: .64;
    }
  }

  .settings-router-row {
    > .settings-entity-main {
      grid-template-columns: 34px minmax(0, 1fr) 16px;
    }
  }

  .settings-entity-main {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 12px;
    padding: 10px 8px 10px 12px;
    color: var(--text-1);
    background: transparent;
    border-radius: 8px;
    text-align: left;

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr) 16px;
    }

    &:active {
      background: var(--item-active);
    }
  }

  .settings-entity-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .settings-entity-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-size: 1rem;
      font-weight: 400;
    }

    small {
      color: var(--text-3);
      font-size: .9rem;
    }
  }

  .settings-status {
    padding: 3px 7px;
    border-radius: 999px;
    border: 1px solid #00000022;
    font-size: .85rem;
    font-weight: 500;

    @media (max-width: 700px) {
      display: none;
    }

    & .enabled {
      color: var(--text-1);
      background: var(--background-3);
    }

    & .disabled {
      color: var(--text-3);
      background: var(--background-3);
    }

    & .error {
      background-color: --danger-color;
      color: white;
    }
  }

  .settings-entity-arrow {
    color: var(--text-4);
  }

  .settings-entity-row > .icon-button {
    justify-self: center;
  }

  .settings-context-folder-row {
    grid-template-columns: minmax(0, 1fr);

    .settings-entity-main {
      width: 100%;
    }

    @media (max-width: 700px) {
      .settings-entity-main {
        grid-template-columns: 34px minmax(0, 1fr) 16px;
        grid-template-rows: auto auto;
      }

      .settings-context-summary {
        grid-column: 2;
        grid-row: 2;
      }

      .settings-entity-arrow {
        grid-column: 3;
        grid-row: 1 / 3;
      }
    }
  }

  .settings-context-summary {
    color: var(--text-3);
    font-size: .88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .settings-context-groups {
    display: grid;
    gap: 28px;
  }

  .settings-context-group {
    display: grid;
    gap: 10px;
  }

  .settings-context-group-header {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    h3 {
      margin: 0;
      color: var(--text-1);
      font-size: 12px;
      font-weight: 500;
    }

    span {
      min-width: 20px;
      padding: 2px 6px;
      color: var(--text-3);
      background: var(--background-3);
      border-radius: 999px;
      font-size: 10px;
      text-align: center;
    }
  }

  .settings-context-item-list {
    overflow: hidden;
  }

  .settings-context-item {
    width: 100%;
    min-width: 0;
    min-height: 66px;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--text-1);
    background: transparent;
    border-radius: 0;
    text-align: left;
    transition: background-color 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    &:hover {
      background: var(--item-hover);
    }

    &:active {
      background: var(--item-active);
    }

    + .settings-context-item {
      border-top: 1px solid var(--border-color);
    }
  }

  .settings-context-item-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      display: -webkit-box;
      overflow: hidden;
      color: var(--text-3);
      font-size: .9rem;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }

  .settings-context-token-count {
    color: var(--text-3);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;

    @media (max-width: 700px) {
      grid-column: 2;
    }
  }

  .settings-context-group-empty {
    padding: 22px 16px;
    color: var(--text-3);
    background: var(--background-2);
    font-size: 11px;
    text-align: center;
  }

  .settings-context-error {
    padding: 10px 12px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .provider-type-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .provider-type-card {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 16px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    text-align: left;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-color);
      box-shadow: 0 7px 22px rgb(0 0 0 / 12%);
      transform: translateY(-1px);
    }

    &:active {
      transform: translateY(0);
    }

    > span:nth-child(2) {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    strong {
      color: var(--text-1);
      font-size: 12px;
    }

    small,
    code {
      color: var(--text-3);
      font-size: 10px;
    }

    code {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    > svg {
      color: var(--text-4);
    }
  }

  .settings-provider-detail {
    display: grid;
    gap: 32px;
  }

  .settings-router-detail {
    gap: 20px;
  }

  .settings-router-models {
    display: grid;
    gap: 6px;

    > .settings-router-model {
      min-width: 0;
      display: grid;
      grid-template-columns: 28px minmax(0, 1fr) auto auto;
      align-items: center;
      gap: 10px;
      padding: 9px 10px;
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 9px;

      @media (max-width: 700px) {
        grid-template-columns: 28px minmax(0, 1fr) auto;

        > .settings-status {
          display: none;
        }
      }

      > .settings-router-model-order {
        width: 24px;
        height: 24px;
        display: grid;
        place-items: center;
        color: var(--text-3);
        background: var(--background-3);
        border-radius: 6px;
        font-size: .85rem;
        font-variant-numeric: tabular-nums;
      }

      > .settings-router-model-copy {
        min-width: 0;
        display: grid;
        gap: 2px;

        > strong,
        > small {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }

        > strong {
          font-size: .95rem;
          font-weight: 500;
        }

        > small {
          color: var(--text-3);
          font-size: .82rem;
        }
      }

      > .settings-router-model-actions {
        display: flex;
        gap: 2px;

        > .icon-button {
          width: 28px;
          height: 28px;

          &:disabled {
            opacity: .35;
          }
        }
      }
    }
  }

  .settings-form,
  .model-editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .settings-field {
    min-width: 0;
    display: grid;
    grid-template-columns: .6fr .4fr;
    align-items: center;
    column-gap: 40px;
    row-gap: 6px;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 400;

    > span {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .settings-field-wide {
    grid-column: auto;
  }

  .default-model-row {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(140px, 1fr);
    gap: 8px;

  }

  .settings-field .default-model-row > select {
    grid-column: auto;
    grid-row: auto;
  }


  .settings-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: var(--text-1);

    > span {
      display: grid;
      gap: 4px;

      strong {
        font-weight: 400;
      }
    }

    small {
      color: var(--text-3);
      font-size: .9rem;
      font-weight: 400;
      line-height: 1.5;
    }

    input {
      flex: 0 0 auto;
    }
  }

  .settings-field input,
  .settings-field select {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    min-width: 0;
    height: 32px;
    padding: 6px 10px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 99px;
    outline: 0;
  }

  .settings-field input:focus,
  .settings-field select:focus {
    border-color: var(--text-3);
    background: var(--background-0);
  }

  .settings-field small {
    position: relative;
    top: -.5em;
    grid-column: 1;
    grid-row: 2;
    color: var(--text-3);
    font-size: .9rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .settings-field small.settings-field-warning {
    color: var(--text-1);
  }

  @media (max-width: 860px) {
    .default-model-field {
      grid-template-columns: minmax(0, 1fr);

      > span,
      .default-model-row,
      small {
        grid-column: 1;
      }

      .default-model-row {
        grid-row: 2;
      }

      small {
        position: static;
        grid-row: 3;
      }
    }
  }

  @media (max-width: 700px) {
    .default-model-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .subscription-auth {
    align-items: start;

    > .subscription-auth-row {
      grid-column: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    button {
      min-height: 34px;
      padding: 7px 12px;
      color: var(--text-1);
      background: var(--background-3);
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font-size: 12px;

      &:hover:not(:disabled) {
        background: var(--item-hover);
      }
    }

    small + small {
      grid-row: 3;
    }
  }

  .provider-security-code {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 12px;
    padding: 12px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    > span,
    > small {
      grid-column: 1 / -1;
    }

    > span {
      color: var(--text-3);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    code {
      color: var(--text-1);
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.12em;
      user-select: all;
    }

    > small {
      color: var(--text-3);
      font-size: 11px;
      line-height: 1.5;
    }
  }

  .models-editor-header h3,
  .models-editor-header p {
    margin: 0;
  }

  .models-editor-header h3 {
    color: var(--text-1);
    font-size: 14px;
  }

  .models-editor-header p {
    margin-top: 2px;
    color: var(--text-3);
    font-size: 11px;
  }

  .models-editor-header button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 6px 9px;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    font-size: 12px;

    &:hover {
      background: var(--item-hover);
    }
  }

  .model-editor-card {
    display: grid;
    gap: 24px;
    padding: 24px;
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 10px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .model-options-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .model-option-row {
    min-width: 0;
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    align-items: center;
    column-gap: 20px;
    padding: 0;
    border: 0;
  }

  .model-option-label {
    grid-column: 1;
    grid-row: 1;
    color: var(--text-1);
    font-size: 12px;
  }

  .model-multiselect {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }

  .model-multiselect-trigger {
    width: 100%;
    min-height: 32px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    text-align: left;
    font-size: 12px;

    &:hover {
      background: var(--item-hover);
    }

    > span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .placeholder,
    svg {
      color: var(--text-3);
    }
  }

  .model-multiselect-menu {
    top: calc(100% + 4px);
    right: 0;
    left: 0;
    max-width: none;
    width: auto;
    border-radius: 10px;
    z-index: 150;

    .dropdown-menu-item {
      border-radius: 7px;
      text-transform: none;
    }
  }

  .model-multiselect-check {
    width: 14px;
    height: 14px;
    display: grid;
    place-items: center;
  }

  .settings-empty {
    min-height: 320px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 12px;
  }

  .archive-settings {
    display: grid;
    gap: 38px;
  }

  .archive-search {
    height: 36px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 12px;
    color: var(--text-4);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 9px;

    &:focus-within {
      border-color: var(--text-3);
    }

    input {
      width: 100%;
      min-width: 0;
      color: var(--text-1);
      background: transparent;
      border: 0;
      outline: 0;
    }
  }

  .archive-list {
    padding: 0;
    overflow: hidden;
  }

  .archive-row {
    min-width: 0;
    min-height: 68px;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;

    &:not(:first-child) {
      border-top: 1px solid var(--border-color);
    }

    @media (max-width: 700px) {
      grid-template-columns: 32px minmax(0, 1fr);

      .archive-actions {
        grid-column: 1 / -1;
        justify-content: flex-end;
      }
    }
  }

  .archive-copy {
    min-width: 0;
    display: grid;
    gap: 4px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-weight: 500;
    }

    small {
      color: var(--text-3);
    }
  }

  .archive-actions {
    display: flex;
    gap: 6px;

    button,
    .archive-maintenance button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 9px;
      color: var(--text-2);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 7px;

      &:hover:not(:disabled) {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &.danger:hover:not(:disabled) {
        color: var(--danger-color);
      }
    }
  }

  .archive-empty {
    min-height: 160px;
  }

  .archive-list.is-loading {
    opacity: 0.6;
  }

  .archive-pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-3);
    font-size: 12px;

    > span:last-child {
      display: flex;
      gap: 6px;
    }

    button {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 7px 9px;
      color: var(--text-2);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 7px;

      &:hover:not(:disabled) {
        color: var(--text-1);
        background: var(--item-hover);
      }
    }

    @media (max-width: 520px) {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .archive-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;

    @media (max-width: 860px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    > div {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px;
      color: var(--text-3);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 10px;

      > span {
        min-width: 0;
        display: grid;
        gap: 2px;
      }

      strong {
        color: var(--text-1);
        font-size: 15px;
        font-weight: 500;
      }
    }
  }

  .archive-maintenance {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;

    > span {
      display: grid;
      gap: 4px;

      strong {
        font-weight: 500;
      }

      small {
        color: var(--text-3);
        line-height: 1.5;
      }
    }

    button {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 10px;
      color: var(--danger-color);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 7px;

      &:hover:not(:disabled) {
        background: var(--item-hover);
      }
    }

    @media (max-width: 700px) {
      align-items: stretch;
      flex-direction: column;
    }
  }

  .maintenance-settings {
    display: grid;
    gap: 38px;
  }

  .maintenance-tabs {
    display: flex;
    gap: 4px;

    button {
      position: relative;
      padding: 6px 12px;
      color: var(--text-3);
      background: transparent;
      font-size: 13px;
      font-weight: 570;
      transition: color 160ms var(--base-transition),
        background 160ms var(--base-transition);

      &:hover {
        color: var(--text-1);
        background: var(--item-hover);
      }

      &[aria-selected="true"] {
        color: var(--text-1);
        background-color: --background-4;
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: -2px;
      }
    }
  }

  .semaphore-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .semaphore-refresh {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 9px;
    color: var(--text-2);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    &:hover:not(:disabled) {
      color: var(--text-1);
      background: var(--item-hover);
    }

    .spinning {
      animation: aivax-settings-spin 900ms linear infinite;
    }
  }

  .semaphore-list {
    padding: 0;
    overflow: hidden;
  }

  .semaphore-row {
    min-width: 0;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;

    &:not(:first-child) {
      border-top: 1px solid var(--border-color);
    }

    @media (max-width: 700px) {
      grid-template-columns: 32px minmax(0, 1fr);

      .archive-actions {
        grid-column: 1 / -1;
        justify-content: flex-end;
      }
    }
  }

  .semaphore-copy {
    min-width: 0;
    display: grid;
    gap: 4px;

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    > small {
      color: var(--text-3);
    }
  }

  .semaphore-parties {
    display: grid;
    gap: 2px;
    margin-top: 2px;
  }

  .semaphore-party {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    overflow: hidden;
    color: var(--text-3);
    text-overflow: ellipsis;
    white-space: nowrap;

    svg {
      flex: 0 0 auto;
      color: var(--text-4);
    }
  }

  .semaphore-empty {
    min-height: 160px;
  }

  .semaphore-list.is-loading {
    opacity: 0.6;
  }

  .settings-provider-empty strong {
    color: var(--text-1);
    font-size: 13px;
  }

  .settings-provider-empty span {
    text-align: center;
  }

  .settings-models-locked {
    padding: 28px 20px;
    color: var(--text-3);
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    border-radius: 9px;
    text-align: center;
    font-size: 11px;
  }

  .subscription-models {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    line-height: 1.5;
  }

  .settings-actions {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 48px;
    background: var(--background-1);
    border-top: 1px solid var(--border-color);

    @media (max-width: 860px) {
      padding-inline: 32px;
    }

    @media (max-width: 700px) {
      align-items: stretch;
      flex-direction: column;
      padding: 10px 20px;
    }

    > div {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 7px;
    }
  }

  .settings-error {
    flex: 1;
    min-width: 0;
    color: var(--text-1);
    overflow-wrap: anywhere;
  }

  .settings-models-empty {
    padding: 56px 22px;
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    border-radius: 10px;
  }
}

.settings-action-menu {
  position: fixed;
  z-index: 180;
}

.settings-row-menu {
  position: static;
  width: 184px;
  border-radius: 10px;

  .dropdown-menu-item {
    border-radius: 7px;

    &.danger {
      color: var(--text-1);

      svg {
        color: currentColor;
      }
    }

    &:active {
      background: var(--item-active);
    }
  }
}

@keyframes aivax-settings-spin {
  to { transform: rotate(360deg); }
}

.settings-back:focus-visible,
.settings-navigation button:focus-visible,
.settings-inline-back:focus-visible,
.settings-page-header button:focus-visible,
.settings-entity-main:focus-visible,
.settings-entity-row > .icon-button:focus-visible,
.settings-context-group-header > .icon-button:focus-visible,
.settings-context-item:focus-visible,
.settings-about-link:focus-visible,
.settings-row-menu .dropdown-menu-item:focus-visible,
.provider-type-card:focus-visible,
.settings-actions button:focus-visible,
.mcp-editor-actions button:focus-visible,
.models-editor-header button:focus-visible,
.settings-field input:focus-visible,
.settings-field select:focus-visible {
  outline: 2px solid var(--text-3);
  outline-offset: 2px;
}

.settings-page {
  .remote-settings {
    gap: 10px;
  }

  .remote-header {
    background: var(--background-2);
  }

  .remote-start-warning {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 18px;
    color: var(--danger-color);
    background: color-mix(in srgb, var(--danger-color) 9%, transparent);
    border-top: 1px solid var(--border-color);
    font-size: 11px;
    line-height: 1.4;

    svg {
      flex: 0 0 auto;
    }
  }

  .remote-heading,
  .remote-row-copy {
    min-width: 0;
  }

  .remote-heading h3,
  .remote-row-copy > strong {
    display: block;
    margin: 0;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .remote-heading p,
  .remote-row-copy > span {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 4px 0 0;
    color: var(--text-3);
    font-size: .9rem;
    line-height: 1.4;
  }

  .remote-switch {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    user-select: none;
  }

  .remote-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .remote-switch-track {
    position: relative;
    width: 34px;
    height: 20px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--background-4);
    transition: background-color .16s ease, border-color .16s ease;
  }

  .remote-switch-track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-3);
    transition: transform .16s ease, background-color .16s ease;
  }

  .remote-switch input:checked + .remote-switch-track {
    border-color: var(--primary-color);
    background: var(--primary-color-opaque);
  }

  .remote-switch input:checked + .remote-switch-track::after {
    background: var(--primary-color);
    transform: translateX(14px);
  }

  .remote-switch input:focus-visible + .remote-switch-track {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  .remote-switch input:disabled + .remote-switch-track,
  .remote-switch:has(input:disabled) strong {
    opacity: .55;
  }

  .remote-switch strong {
    min-width: 18px;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 550;
  }

  .remote-port-input {
    width: 106px;
    min-width: 106px;
    padding: 8px 10px;
    color: var(--text-1);
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-align: right;
    background: var(--background-0);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    &:focus {
      border-color: var(--text-3);
      outline: none;
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: .55;
    }
  }

  .remote-endpoint-row code {
    min-width: 0;
    padding: 6px 9px;
    color: var(--text-2);
    font-size: 11px;
    overflow-wrap: anywhere;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .remote-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-4);
  }

  .remote-status.running {
    color: var(--success-color);
  }

  .remote-status.running i {
    background: var(--success-color);
  }

  .remote-key-controls {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .remote-key-status {
    color: var(--text-3);
    font-size: 11px;
    white-space: nowrap;
  }

  .remote-key-status.configured {
    color: var(--success-color);
  }

  .remote-key-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .remote-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 30px;
    padding: 6px 9px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    transition: color .16s ease, background-color .16s ease, border-color .16s ease;

    &:hover:not(:disabled) {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active:not(:disabled) {
      background: var(--item-active);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      cursor: not-allowed;
      opacity: .45;
    }

    &.primary {
      color: var(--text-1);
      background: var(--background-3);
    }

    &.danger:hover:not(:disabled) {
      color: var(--danger-color);
    }
  }

  .remote-footnote {
    margin: 0;
    padding: 0 2px;
    color: var(--text-3);
    font-size: 11px;
    line-height: 1.45;
  }

  @media (max-width: 760px) {

    .settings-card-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .remote-header {
      flex-direction: row;
      align-items: center;
    }

    .remote-endpoint-row code,
    .remote-key-controls {
      width: 100%;
    }

    .remote-key-controls {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .remote-key-actions {
      flex-wrap: wrap;
    }
  }
}