.settings-page {
  grid-column: 1 / -1;
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  color: var(--text-1);
  background: var(--background-1);
  overflow: hidden;

  @media (max-width: 860px) {
    grid-template-columns: 210px minmax(0, 1fr);
  }

  @media (max-width: 700px) {
    grid-template-columns: 176px minmax(0, 1fr);
  }

  .settings-sidebar {
    min-height: 0;
    padding: 0 4px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .settings-sidebar-titlebar {
    flex: 0 0 24px;
  }

  .settings-back {
    min-height: 34px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 8px;
    padding: 0 9px;
    color: var(--text-3);
    background: transparent;
    border-radius: 7px;
    text-align: left;
  }

  .settings-back:hover,
  .settings-navigation button:hover,
  .settings-inline-back:hover,
  .settings-entity-main:hover {
    color: var(--text-1);
    background: var(--item-hover);
  }

  .settings-sidebar-heading {
    padding: 14px 16px 12px;

    @media (max-width: 700px) {
      padding-inline: 12px;
    }
  }

  .settings-search {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 4px 8px 10px;
    padding: 0 9px;
    color: var(--text-4);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    &:focus-within {
      border-color: var(--text-3);
    }

    input {
      width: 100%;
      min-width: 0;
      padding: 0;
      color: var(--text-1);
      background: transparent;
      border: 0;
      outline: 0;
    }
  }

  .settings-sidebar-heading h1,
  .settings-sidebar-heading p,
  .settings-page-header h2,
  .settings-page-header p,
  .settings-section-heading h3,
  .settings-section-heading p {
    margin: 0;
  }

  .settings-sidebar-heading h1 {
    color: var(--text-1);
    font-size: 18px;
    line-height: 1.3;
  }

  .settings-sidebar-heading p {
    margin-top: 3px;
    color: var(--text-3);
    font-size: 11px;
  }

  .settings-navigation {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 0 8px 14px;

    > span {
      padding: 8px;
      color: var(--text-4);
      font-weight: 500;
    }

    .settings-navigation-separator {
      height: 1px;
      margin: 8px 8px 6px;
      background: var(--background-3);
    }

    button {
      display: flex;
      align-items: center;
      gap: 9px;
      padding: 6px 12px;
      color: var(--text-1);
      background: transparent;
      border-radius: 10px;
      font-size: 1rem;
      text-align: left;

      & :hover {
        background-color: --background-4;
      }

      & .active {
        color: var(--text-1);
        background: var(--item-active);
      }
    }
  }

  .settings-main {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: var(--background-1);
  }

  .settings-page-header {
    padding: 82px 48px 30px;

    @media (max-width: 860px) {
      padding: 72px 32px 26px;
    }

    @media (max-width: 700px) {
      padding: 56px 20px 22px;
    }
  }

  .settings-page-header > div,
  .settings-content-inner {
    width: min(768px, 100%);
    margin: 0 auto;
  }

  .settings-inline-back {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 0 0 14px -6px;
    padding: 5px 7px;
    color: var(--text-3);
    background: transparent;
    border-radius: 6px;
    font-size: .9rem;
  }

  .settings-page-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;

    @media (max-width: 700px) {
      align-items: flex-start;
      flex-direction: column;
      gap: 14px;
    }
  }

  .settings-page-header h2 {
    color: var(--text-1);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.25;
  }

  .settings-page-header p {
    margin-top: 6px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .settings-add-provider,
  .settings-provider-empty .primary-mini,
  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 10px;
    font-size: .9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .settings-actions .primary-mini,
  .mcp-editor-actions .primary-mini {
    transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;

    &:hover:not(:disabled) {
      background: var(--background-5) !important;
    }

    &:active:not(:disabled) {
      transform: scale(0.98);
    }

    &:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }
  }

  .settings-content {
    min-height: 0;
    padding: 8px 48px 48px;
    overflow: auto;

    @media (max-width: 860px) {
      padding: 8px 32px 40px;
    }

    @media (max-width: 700px) {
      padding: 8px 20px 32px;
    }
  }

  .settings-content-inner {
    min-height: 100%;
  }

  .settings-section {
    display: grid;
    gap: 16px;
  }

  .settings-tuning {
    display: grid;
    gap: 38px;

    @media (max-width: 700px) {
      gap: 30px;
    }

    .settings-section {
      gap: 12px;
    }
  }

  .settings-section-heading h3 {
    color: var(--text-1);
    font-size: 14px;
    font-weight: 500;
  }

  .settings-section-heading p {
    margin-top: 3px;
    color: var(--text-3);
    font-size: 11px;
  }

  .settings-section-card {
    padding: 1em;
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 14px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .settings-row-card {
    gap: 0;
    padding: 0;
    overflow: hidden;

    @media (max-width: 700px) {
      padding: 0;
    }

    > .settings-field,
    > .settings-toggle-row,
    > .settings-card-row {
      min-height: 72px;
      padding: 16px 18px;
    }

    > :not(:first-child) {
      border-top: 1px solid var(--border-color);
    }
  }

  .settings-card-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .settings-about {
    display: grid;
    gap: 24px;
  }

  .settings-about-hero {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 22px;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 14px;

    h3,
    p {
      margin: 0;
    }

    h3 {
      font-size: 20px;
      font-weight: 500;
    }

    p {
      max-width: 520px;
      margin-top: 5px;
      color: var(--text-3);
      line-height: 1.55;
      text-wrap: pretty;
    }
  }

  .settings-about-logo {
    width: 256px;
    height: 256px;
    flex: 0 0 auto;
    border-radius: 20px;
    object-fit: contain;

    :root[data-color-scheme="dark"] & {
      filter: invert(1);
    }
  }

  .settings-about-details {
    margin: 0;
    border-block: 1px solid var(--border-color);

    > div {
      min-height: 52px;
      display: grid;
      grid-template-columns: 132px minmax(0, 1fr);
      align-items: center;
      gap: 18px;
      padding: 10px 4px;

      + div {
        border-top: 1px solid var(--border-color);
      }
    }

    dt {
      color: var(--text-3);
    }

    dd {
      min-width: 0;
      margin: 0;
      color: var(--text-1);
      overflow-wrap: anywhere;
    }
  }

  .settings-about-link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-1);
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: color 180ms var(--base-transition),
      text-decoration-color 180ms var(--base-transition);

    &:hover {
      color: var(--link-color);
      text-decoration-color: currentColor;
    }

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }

  .settings-about-credit {
    margin: 0;
    color: var(--text-3);
  }

  .models-editor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .settings-list-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-3);
    font-size: 11px;
  }

  .settings-entity-list {
    display: grid;
    gap: 3px;
  }

  .settings-entity-row {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36px;
    align-items: center;
    border-radius: 9px;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      opacity 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-color);
    }

    &.disabled {
      opacity: .64;
    }
  }

  .settings-entity-main {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto 16px;
    align-items: center;
    gap: 12px;
    padding: 10px 8px 10px 12px;
    color: var(--text-1);
    background: transparent;
    border-radius: 8px;
    text-align: left;

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr) 16px;
    }

    &:active {
      background: var(--item-active);
    }
  }

  .settings-entity-icon {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 8px;
  }

  .settings-entity-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--text-1);
      font-size: 1rem;
      font-weight: 400;
    }

    small {
      color: var(--text-3);
      font-size: .9rem;
    }
  }

  .settings-status {
    padding: 3px 7px;
    border-radius: 999px;
    border: 1px solid #00000022;
    font-size: .85rem;
    font-weight: 500;

    @media (max-width: 700px) {
      display: none;
    }

    & .enabled {
      color: var(--text-1);
      background: var(--background-3);
    }

    & .disabled {
      color: var(--text-3);
      background: var(--background-3);
    }

    & .error {
      background-color: --danger-color;
      color: white;
    }
  }

  .settings-entity-arrow {
    color: var(--text-4);
  }

  .settings-entity-row > .icon-button {
    justify-self: center;
  }

  .settings-context-folder-row {
    grid-template-columns: minmax(0, 1fr);

    .settings-entity-main {
      width: 100%;
    }

    @media (max-width: 700px) {
      .settings-entity-main {
        grid-template-columns: 34px minmax(0, 1fr) 16px;
        grid-template-rows: auto auto;
      }

      .settings-context-summary {
        grid-column: 2;
        grid-row: 2;
      }

      .settings-entity-arrow {
        grid-column: 3;
        grid-row: 1 / 3;
      }
    }
  }

  .settings-context-summary {
    color: var(--text-3);
    font-size: .88rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .settings-context-groups {
    display: grid;
    gap: 28px;
  }

  .settings-context-group {
    display: grid;
    gap: 10px;
  }

  .settings-context-group-header {
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;

    > div {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    h3 {
      margin: 0;
      color: var(--text-1);
      font-size: 12px;
      font-weight: 500;
    }

    span {
      min-width: 20px;
      padding: 2px 6px;
      color: var(--text-3);
      background: var(--background-3);
      border-radius: 999px;
      font-size: 10px;
      text-align: center;
    }
  }

  .settings-context-item-list {
    overflow: hidden;
  }

  .settings-context-item {
    width: 100%;
    min-width: 0;
    min-height: 66px;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    color: var(--text-1);
    background: transparent;
    border-radius: 0;
    text-align: left;
    transition: background-color 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    @media (max-width: 700px) {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    &:hover {
      background: var(--item-hover);
    }

    &:active {
      background: var(--item-active);
    }

    + .settings-context-item {
      border-top: 1px solid var(--border-color);
    }
  }

  .settings-context-item-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong {
      overflow: hidden;
      color: var(--text-1);
      font-weight: 500;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    small {
      display: -webkit-box;
      overflow: hidden;
      color: var(--text-3);
      font-size: .9rem;
      line-height: 1.4;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }
  }

  .settings-context-token-count {
    color: var(--text-3);
    font-size: 10px;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;

    @media (max-width: 700px) {
      grid-column: 2;
    }
  }

  .settings-context-group-empty {
    padding: 22px 16px;
    color: var(--text-3);
    background: var(--background-2);
    font-size: 11px;
    text-align: center;
  }

  .settings-context-error {
    padding: 10px 12px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 11px;
    overflow-wrap: anywhere;
  }

  .provider-type-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;

    @media (max-width: 700px) {
      grid-template-columns: 1fr;
    }
  }

  .provider-type-card {
    min-width: 0;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 16px;
    color: var(--text-1);
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    text-align: left;
    transition: border-color 180ms var(--base-transition),
      box-shadow 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }

    &:hover {
      border-color: var(--border-color);
      box-shadow: 0 7px 22px rgb(0 0 0 / 12%);
      transform: translateY(-1px);
    }

    &:active {
      transform: translateY(0);
    }

    > span:nth-child(2) {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    strong {
      color: var(--text-1);
      font-size: 12px;
    }

    small,
    code {
      color: var(--text-3);
      font-size: 10px;
    }

    code {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    > svg {
      color: var(--text-4);
    }
  }

  .settings-provider-detail {
    display: grid;
    gap: 32px;
  }

  .settings-form,
  .model-editor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .settings-field {
    min-width: 0;
    display: grid;
    grid-template-columns: .7fr .3fr;
    align-items: center;
    column-gap: 40px;
    row-gap: 6px;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 400;

    > span {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .settings-field-wide {
    grid-column: auto;
  }

  .default-model-row {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(140px, 1fr);
    gap: 8px;

  }

  .settings-field .default-model-row > select {
    grid-column: auto;
    grid-row: auto;
  }

  .settings-toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    color: var(--text-1);

    > span {
      display: grid;
      gap: 4px;

      strong {
        font-weight: 400;
      }
    }

    small {
      color: var(--text-3);
      font-size: .9rem;
      font-weight: 400;
      line-height: 1.5;
    }

    input {
      flex: 0 0 auto;
    }
  }

  .settings-field input,
  .settings-field select {
    grid-column: 2;
    grid-row: 1;
    width: 100%;
    min-width: 0;
    height: 32px;
    padding: 6px 10px;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 99px;
    outline: 0;
  }

  .settings-field input:focus,
  .settings-field select:focus {
    border-color: var(--text-3);
    background: var(--background-0);
  }

  .settings-field small {
    position: relative;
    top: -.5em;
    grid-column: 1;
    grid-row: 2;
    color: var(--text-3);
    font-size: .9rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .settings-field small.settings-field-warning {
    color: var(--text-1);
  }

  @media (max-width: 860px) {
    .default-model-field {
      grid-template-columns: minmax(0, 1fr);

      > span,
      .default-model-row,
      small {
        grid-column: 1;
      }

      .default-model-row {
        grid-row: 2;
      }

      small {
        position: static;
        grid-row: 3;
      }
    }
  }

  @media (max-width: 700px) {
    .default-model-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .subscription-auth {
    align-items: start;

    > .subscription-auth-row {
      grid-column: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    button {
      min-height: 34px;
      padding: 7px 12px;
      color: var(--text-1);
      background: var(--background-3);
      border: 1px solid var(--border-color);
      border-radius: 7px;
      font-size: 12px;

      &:hover:not(:disabled) {
        background: var(--item-hover);
      }
    }

    small + small {
      grid-row: 3;
    }
  }

  .provider-security-code {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 12px;
    padding: 12px;
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    > span,
    > small {
      grid-column: 1 / -1;
    }

    > span {
      color: var(--text-3);
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    code {
      color: var(--text-1);
      font-size: 18px;
      font-weight: 600;
      letter-spacing: 0.12em;
      user-select: all;
    }

    > small {
      color: var(--text-3);
      font-size: 11px;
      line-height: 1.5;
    }
  }

  .models-editor-header h3,
  .models-editor-header p {
    margin: 0;
  }

  .models-editor-header h3 {
    color: var(--text-1);
    font-size: 14px;
  }

  .models-editor-header p {
    margin-top: 2px;
    color: var(--text-3);
    font-size: 11px;
  }

  .models-editor-header button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 6px 9px;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    font-size: 12px;

    &:hover {
      background: var(--item-hover);
    }
  }

  .model-editor-card {
    display: grid;
    gap: 24px;
    padding: 24px;
    background: var(--background-1);
    border: 1px solid var(--border-color);
    border-radius: 10px;

    @media (max-width: 700px) {
      padding: 14px;
    }
  }

  .model-options-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  .model-option-row {
    min-width: 0;
    display: grid;
    grid-template-columns: 144px minmax(0, 1fr);
    align-items: center;
    column-gap: 20px;
    padding: 0;
    border: 0;
  }

  .model-option-label {
    grid-column: 1;
    grid-row: 1;
    color: var(--text-1);
    font-size: 12px;
  }

  .model-option-controls {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .model-options-row label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-2);
    font-size: 12px;
  }

  .model-options-row input {
    accent-color: var(--text-1);
  }

  .reasoning-options label {
    text-transform: lowercase;
  }

  .settings-empty {
    min-height: 320px;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 12px;
  }

  .settings-provider-empty strong {
    color: var(--text-1);
    font-size: 13px;
  }

  .settings-provider-empty span {
    text-align: center;
  }

  .settings-models-locked {
    padding: 28px 20px;
    color: var(--text-3);
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    border-radius: 9px;
    text-align: center;
    font-size: 11px;
  }

  .subscription-models {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    line-height: 1.5;
  }

  .settings-actions {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 48px;
    background: var(--background-1);
    border-top: 1px solid var(--border-color);

    @media (max-width: 860px) {
      padding-inline: 32px;
    }

    @media (max-width: 700px) {
      align-items: stretch;
      flex-direction: column;
      padding: 10px 20px;
    }

    > div {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 7px;
    }
  }

  .settings-error {
    flex: 1;
    min-width: 0;
    color: var(--text-1);
    overflow-wrap: anywhere;
  }

  .settings-models-empty {
    padding: 56px 22px;
    background: var(--background-2);
    border: 1px dashed var(--border-color);
    border-radius: 10px;
  }
}

.settings-action-menu {
  position: fixed;
  z-index: 180;
}

.settings-row-menu {
  position: static;
  width: 184px;
  border-radius: 10px;

  .dropdown-menu-item {
    border-radius: 7px;

    &.danger {
      color: var(--text-1);

      svg {
        color: currentColor;
      }
    }

    &:active {
      background: var(--item-active);
    }
  }
}

.settings-back:focus-visible,
.settings-navigation button:focus-visible,
.settings-inline-back:focus-visible,
.settings-page-header button:focus-visible,
.settings-entity-main:focus-visible,
.settings-entity-row > .icon-button:focus-visible,
.settings-context-group-header > .icon-button:focus-visible,
.settings-context-item:focus-visible,
.settings-about-link:focus-visible,
.settings-row-menu .dropdown-menu-item:focus-visible,
.provider-type-card:focus-visible,
.settings-actions button:focus-visible,
.mcp-editor-actions button:focus-visible,
.models-editor-header button:focus-visible,
.settings-field input:focus-visible,
.settings-field select:focus-visible {
  outline: 2px solid var(--text-3);
  outline-offset: 2px;
}

.settings-page {
  .remote-settings {
    gap: 10px;
  }

  .remote-header {
    background: var(--background-2);
  }

  .remote-start-warning {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 11px 18px;
    color: var(--danger-color);
    background: color-mix(in srgb, var(--danger-color) 9%, transparent);
    border-top: 1px solid var(--border-color);
    font-size: 11px;
    line-height: 1.4;

    svg {
      flex: 0 0 auto;
    }
  }

  .remote-heading,
  .remote-row-copy {
    min-width: 0;
  }

  .remote-heading h3,
  .remote-row-copy > strong {
    display: block;
    margin: 0;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .remote-heading p,
  .remote-row-copy > span {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 4px 0 0;
    color: var(--text-3);
    font-size: .9rem;
    line-height: 1.4;
  }

  .remote-switch {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    user-select: none;
  }

  .remote-switch input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .remote-switch-track {
    position: relative;
    width: 34px;
    height: 20px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--background-4);
    transition: background-color .16s ease, border-color .16s ease;
  }

  .remote-switch-track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--text-3);
    transition: transform .16s ease, background-color .16s ease;
  }

  .remote-switch input:checked + .remote-switch-track {
    border-color: var(--primary-color);
    background: var(--primary-color-opaque);
  }

  .remote-switch input:checked + .remote-switch-track::after {
    background: var(--primary-color);
    transform: translateX(14px);
  }

  .remote-switch input:focus-visible + .remote-switch-track {
    outline: 2px solid var(--primary-color);
    outline-offset: 2px;
  }

  .remote-switch input:disabled + .remote-switch-track,
  .remote-switch:has(input:disabled) strong {
    opacity: .55;
  }

  .remote-switch strong {
    min-width: 18px;
    color: var(--text-2);
    font-size: 12px;
    font-weight: 550;
  }

  .remote-port-input {
    width: 106px;
    min-width: 106px;
    padding: 8px 10px;
    color: var(--text-1);
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-align: right;
    background: var(--background-0);
    border: 1px solid var(--border-color);
    border-radius: 7px;

    &:focus {
      border-color: var(--text-3);
      outline: none;
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: .55;
    }
  }

  .remote-endpoint-row code {
    min-width: 0;
    padding: 6px 9px;
    color: var(--text-2);
    font-size: 11px;
    overflow-wrap: anywhere;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 6px;
  }

  .remote-status i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--text-4);
  }

  .remote-status.running {
    color: var(--success-color);
  }

  .remote-status.running i {
    background: var(--success-color);
  }

  .remote-key-controls {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .remote-key-status {
    color: var(--text-3);
    font-size: 11px;
    white-space: nowrap;
  }

  .remote-key-status.configured {
    color: var(--success-color);
  }

  .remote-key-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .remote-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 30px;
    padding: 6px 9px;
    color: var(--text-2);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    transition: color .16s ease, background-color .16s ease, border-color .16s ease;

    &:hover:not(:disabled) {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active:not(:disabled) {
      background: var(--item-active);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      cursor: not-allowed;
      opacity: .45;
    }

    &.primary {
      color: var(--text-1);
      background: var(--background-3);
    }

    &.danger:hover:not(:disabled) {
      color: var(--danger-color);
    }
  }

  .remote-footnote {
    margin: 0;
    padding: 0 2px;
    color: var(--text-3);
    font-size: 11px;
    line-height: 1.45;
  }

  @media (max-width: 760px) {

    .settings-card-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .remote-header {
      flex-direction: row;
      align-items: center;
    }

    .remote-endpoint-row code,
    .remote-key-controls {
      width: 100%;
    }

    .remote-key-controls {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .remote-key-actions {
      flex-wrap: wrap;
    }
  }
}