.chat-workspace {
  min-width: 0;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  overflow: hidden;

  &.with-auxiliary-panel {
    grid-template-columns: minmax(0, 1fr) 0 var(--auxiliary-panel-width, 42%);
  }
}

.auxiliary-panel-toggle {
  position: fixed;
  top: 43px;
  right: 22px;
  z-index: 35;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  padding: 0;
  color: var(--color-muted);
  background: var(--surface-solid);
  opacity: .7;
  border-radius: 8px;
  box-shadow: 0 8px 24px var(--shadow-soft);
  transition: 180ms var(--base-transition);

  &:hover {
    opacity: 1;
    border-color: --border-hairline;
    color: var(--color-text-strong);
    background: var(--surface-hover);
  }

  &:active {
    transform: scale(0.96);
  }

  &:focus-visible {
    outline: 2px solid var(--border-accent);
    outline-offset: 2px;
  }
}

.auxiliary-panel {
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: grid;
  grid-template-rows: 44px minmax(0, 1fr);
  padding-top: 34px;
  overflow: hidden;
  background: var(--surface-solid);
  border-left: 1px solid var(--border-panel);

  .auxiliary-panel-header {
    min-width: 0;
    padding: 5px 8px;
    border-bottom: 1px solid var(--color-divider-subtle);
  }

  .auxiliary-tabs-row {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .auxiliary-empty-header {
    min-width: 0;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-left: 8px;
    color: var(--color-text-secondary);
    font-size: 12px;
    font-weight: 500;
  }

  .auxiliary-empty-actions {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .auxiliary-tabs {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .auxiliary-add {
    position: relative;
    flex: 0 0 auto;
  }

  .auxiliary-add-button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-muted);
    background: transparent;
    border-radius: 7px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover,
    &[aria-expanded="true"] {
      color: var(--color-text-strong);
      background: var(--surface-hover);
    }

    &:active {
      transform: scale(0.94);
    }

    &:focus-visible {
      outline: 2px solid var(--border-accent);
      outline-offset: -2px;
    }
  }

  .auxiliary-add-menu {
    top: 34px;
    right: 0;
    width: 210px;

    .dropdown-menu-item {
      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: -2px;
        background: var(--surface-neutral-hover);
      }

      &:active:not(:disabled) {
        transform: scale(0.98);
      }
    }
  }

  .auxiliary-tab {
    min-width: 0;
    flex: 0 1 156px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px;
    align-items: center;
    color: var(--color-muted);
    border-radius: 8px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      border-color 180ms var(--base-transition);

    &:hover {
      color: var(--color-text-strong);
      background: var(--surface-hover);
    }

    &.active {
      color: var(--color-text-strong);
      background: var(--surface-muted);
      border-color: var(--border-hairline);
    }

    > button {
      min-width: 0;
      height: 30px;
      display: flex;
      align-items: center;
      gap: 7px;
      color: inherit;
      background: transparent;
      text-align: left;

      > span:not(.run-dot) {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 12px;
      }

      & .auxiliary-tab-close {
        opacity: .5;

        & :hover {
          opacity: 1;
        }
      }

      & :hover {
        background: transparent;
      }

      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: -2px;
      }
    }
  }

  .auxiliary-tab-close {
    display: flex;
    width: 28px;
    height: 28px;
    padding: 0;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
    border-radius: 6px;

    &:hover,
    &:focus-visible {
      color: var(--color-text-strong);
      background: var(--surface-hover-strong);
    }

    &:active {
      transform: scale(0.94);
    }

    &:focus-visible {
      outline: 2px solid var(--border-accent);
      outline-offset: -2px;
    }
  }

  .auxiliary-content {
    min-width: 0;
    min-height: 0;
    overflow: hidden;

    &.with-toolbar {
      display: grid;
      grid-template-rows: 38px minmax(0, 1fr);
    }

    &.is-empty {
      display: grid;
      place-items: center;
      overflow: auto;
    }
  }

  .auxiliary-empty {
    width: min(100% - 32px, 420px);
    display: grid;
    gap: 6px;
    padding-block: 24px;

    p {
      margin: 0 0 4px;
      padding-inline: 8px;
      color: var(--color-muted);
      font-size: 11px;
      font-weight: 500;
    }

    button {
      min-width: 0;
      min-height: 50px;
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr) 16px;
      align-items: center;
      gap: 10px;
      padding: 8px 10px;
      color: var(--color-text);
      background: var(--surface-muted);
      border: 1px solid transparent;
      border-radius: 9px;
      text-align: left;
      transition: color 180ms var(--base-transition),
        background 180ms var(--base-transition),
        border-color 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      > span {
        min-width: 0;
        display: grid;
        gap: 2px;
      }

      strong,
      small {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      strong {
        color: var(--color-text-strong);
        font-size: 12px;
        font-weight: 500;
      }

      small {
        color: var(--color-muted);
        font-size: 10px;
      }

      > svg:last-child {
        color: var(--color-muted-light);
      }

      &:hover:not(:disabled) {
        background: var(--surface-hover);
        border-color: var(--border-hairline);
      }

      &:active:not(:disabled) {
        transform: scale(0.99);
      }

      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: 2px;
      }

      &:disabled {
        opacity: 0.48;
        cursor: not-allowed;
      }
    }
  }

  .subagent-empty {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 24px;
    color: var(--color-muted);
    text-align: center;

    strong {
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 500;
    }

    span {
      max-width: 260px;
      font-size: 11px;
      line-height: 1.5;
    }
  }

  .auxiliary-chat-view {
    height: 100%;
    padding-top: 0;

    .chat-scroll {
      padding-inline: 12px 4px;
    }

    .composer-wrap {
      padding: 12px 12px 18px;
    }

    .composer {
      border-radius: 16px;
    }

    .empty-chat {
      transform: translateY(-42px);

      h1 {
        font-size: 20px;
      }
    }
  }

  .subagent-chat-toolbar {
    min-width: 0;
    padding: 4px 8px;
    border-bottom: 1px solid var(--color-divider-subtle);

    button {
      min-width: 0;
      max-width: 100%;
      height: 30px;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 0 8px;
      color: var(--color-text-secondary);
      background: transparent;
      border-radius: 7px;
      font-size: 12px;
      font-weight: 500;

      span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      &:hover,
      &:focus-visible {
        color: var(--color-text-strong);
        background: var(--surface-hover);
      }
    }
  }

  .subagent-list {
    min-height: 0;
    padding: 10px;
    overflow: auto;
  }

  .subagent-list-item {
    width: 100%;
    min-height: 58px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 9px;
    padding: 8px 9px;
    color: var(--color-text);
    background: transparent;
    border-radius: 10px;
    text-align: left;
    transition: background 180ms var(--base-transition);

    + .subagent-list-item {
      border-top: 1px solid var(--color-divider-subtle);
      border-radius: 0 0 10px 10px;
    }

    &:hover,
    &:focus-visible {
      background: var(--surface-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--border-accent);
      outline-offset: -2px;
    }

    > svg {
      color: var(--color-muted-light);
    }
  }

  .subagent-list-copy {
    min-width: 0;
    display: grid;
    gap: 3px;

    strong,
    span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 500;
    }

    span {
      color: var(--color-muted);
      font-size: 11px;
    }
  }

  .subagent-status-dot {
    width: 7px;
    height: 7px;
    background: var(--color-muted-light);
    border-radius: 999px;

    &.working {
      background: var(--color-live);
      box-shadow: 0 0 0 3px var(--surface-accent-soft);
    }

    &.failed {
      background: var(--color-danger);
    }
  }

  .subagent-status {
    color: var(--color-muted);
    font-size: 10px;
    text-transform: capitalize;

    &.working {
      color: var(--color-text-strong);
    }
  }

  .provider-panel-shell {
    height: 100%;
    min-height: 0;
    display: grid;
    grid-template-rows: 42px minmax(0, 1fr);
  }

  .provider-panel-provenance {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-divider-subtle);
    font-size: 10px;

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--color-text-secondary);
      font-weight: 500;
    }

    button {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      padding: 0;
      flex: 0 0 auto;
      color: var(--color-muted);
      background: transparent;
      border-radius: 7px;
      transition: color 180ms var(--base-transition),
        background 180ms var(--base-transition);

      &:hover:not(:disabled) {
        color: var(--color-text-strong);
        background: var(--surface-hover);
      }

      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: -2px;
      }
    }
  }

  .provider-panel-state {
    min-height: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 7px;
    padding: 24px;
    color: var(--color-muted);
    text-align: center;

    strong {
      color: var(--color-text-strong);
      font-size: 13px;
    }

    span {
      max-width: 280px;
      font-size: 11px;
      line-height: 1.5;
    }
  }

  .provider-usage-panel {
    min-height: 0;
    padding: 24px 20px 32px;
    overflow: auto;
  }

  .provider-usage-section + .provider-reset-section {
    margin-top: 32px;
  }

  .provider-section-heading {
    min-width: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;

    h3 {
      margin: 0;
      color: var(--color-text-strong);
      font-size: 12px;
      font-weight: 600;
    }

    small {
      color: var(--color-muted);
      font-size: 10px;
      text-transform: capitalize;
    }
  }

  .provider-limit-list {
    display: grid;
    gap: 10px;
  }

  .provider-limit-card {
    min-height: 62px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(156px, 42%);
    align-items: center;
    gap: 20px;
    padding: 12px 16px;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    border-radius: 10px;
  }

  .provider-limit-copy {
    min-width: 0;
    display: grid;
    gap: 4px;

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    strong {
      color: var(--color-text-strong);
      font-size: 11px;
      font-weight: 500;
    }

    small {
      color: var(--color-muted);
      font-size: 10px;
    }
  }

  .provider-limit-value {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(72px, 1fr) auto;
    align-items: center;
    gap: 12px;
    color: var(--color-muted);
    font-size: 10px;
    white-space: nowrap;
  }

  .provider-limit-track {
    height: 5px;
    overflow: hidden;
    background: var(--surface-hover-strong);
    border-radius: 999px;

    > span {
      display: block;
      height: 100%;
      background: var(--color-text-strong);
      border-radius: inherit;
    }
  }

  .provider-reset-list {
    padding: 0 16px;
    background: var(--surface-muted);
    border: 1px solid var(--border-hairline);
    border-radius: 10px;
  }

  .provider-reset-list article {
    min-height: 60px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 10px 0;

    + article {
      border-top: 1px solid var(--color-divider-subtle);
    }

    > span {
      min-width: 0;
      display: grid;
      gap: 3px;
    }

    strong,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
    }

    strong {
      color: var(--color-text-strong);
      font-size: 11px;
    }

    small {
      color: var(--color-muted);
      font-size: 10px;
    }

    button {
      min-height: 30px;
      padding: 6px 10px;
      color: var(--surface-solid);
      background: var(--color-text-strong);
      border-radius: 7px;
      font-size: 10px;
      transition: opacity 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      &:hover:not(:disabled) {
        opacity: .86;
      }

      &:active:not(:disabled) {
        transform: scale(.97);
      }

      &:focus-visible {
        outline: 2px solid var(--border-accent);
        outline-offset: 2px;
      }
    }
  }

  .provider-panel-empty,
  .provider-panel-error {
    padding: 10px;
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .provider-panel-error {
    margin-bottom: 10px;
    color: var(--color-danger);
    background: var(--surface-danger-soft);
    border-radius: 8px;
  }

  .spin {
    animation: provider-panel-spin 800ms linear infinite;
  }
}

@keyframes provider-panel-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 860px) {
  .chat-workspace.with-auxiliary-panel {
    grid-template-columns: minmax(0, 1fr) 0 var(--auxiliary-panel-width, 50%);
  }

  .auxiliary-panel .provider-limit-card {
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
}

@media (prefers-reduced-motion: reduce) {

  .auxiliary-panel-toggle,
  .auxiliary-tab,
  .auxiliary-add-button,
  .auxiliary-empty button,
  .subagent-list-item {
    transition: none;
  }

  .auxiliary-panel .spin {
    animation: none;
  }
}
