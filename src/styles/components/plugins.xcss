.plugins-settings {
  display: grid;
  gap: 30px;

  .plugins-trust-warning,
  .plugins-restart {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 14px;
    color: var(--text-1);
    background: color-mix(in srgb, var(--warn-color) 10%, var(--background-1));
    border: 1px solid color-mix(in srgb, var(--warn-color) 34%, var(--border-color));
    border-radius: 12px;

    svg { flex: 0 0 auto; color: var(--warn-color); }
    strong { display: block; font-size: 12px; }
    p { margin-top: 3px; color: var(--text-2); font-size: 11px; line-height: 1.5; }
  }

  .plugins-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  .plugins-developer-tools {
    position: relative;

    .secondary-mini svg:last-child { margin-left: 1px; }
    .dropdown-menu { top: calc(100% + 6px); right: 0; z-index: 20; width: 190px; border-radius: 10px; }
    .dropdown-menu-item { border-radius: 7px; }
  }

  .plugins-restart { align-items: center; padding: 10px 12px; font-size: 11px; }
  .plugins-list { display: grid; gap: 10px; }

  .plugin-card {
    display: flex;
    align-items: flex-start;
    gap: 12px;

    > svg { flex: 0 0 auto; color: var(--text-3); }

    &.disabled {
      background: color-mix(in srgb, var(--background-1) 74%, var(--background-2));

      > svg,
      .plugin-card-main { opacity: .66; }
    }
  }

  .plugin-card-main { min-width: 0; flex: 1; }

  .plugin-card-actions {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;

    .danger { color: var(--danger-color); }
  }

  .plugin-card-title {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;

    strong { font-size: 13px; font-weight: 550; }
    > span { color: var(--text-3); font-size: 10px; }
  }

  .plugin-card {
    p { margin-top: 5px; color: var(--text-2); font-size: 11px; line-height: 1.5; }
    small { display: block; margin-top: 5px; color: var(--text-3); overflow-wrap: anywhere; }
  }

  .plugin-status,
  .plugin-capabilities span {
    padding: 3px 7px;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--background-2);
  }

  .plugin-status {
    &.error { color: var(--danger-color); }

    &.disabled,
    &.pending-disable,
    &.pending-enable { color: var(--warn-color); }
  }

  .plugin-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 9px;

    span { color: var(--text-2); font-size: 9px; }
  }
  .plugin-error { margin-top: 9px; color: var(--danger-color); font-size: 11px; overflow-wrap: anywhere; }
  .plugins-empty { display: flex; align-items: center; gap: 9px; color: var(--text-3); font-size: 11px; }

  @media (max-width: 680px) {
    .plugin-card { flex-wrap: wrap; }
    .plugin-card-actions { width: 100%; padding-left: 30px; justify-content: flex-start; }
  }
}

.plugin-settings-editor {
  display: grid;
  gap: 24px;

  .settings-inline-back { justify-self: start; }

  .plugin-settings-editor-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;

    h3 { color: var(--text-1); font-size: 16px; font-weight: 550; }
    p { margin-top: 4px; color: var(--text-3); font-size: 11px; line-height: 1.5; }
  }

  .plugin-settings-loading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 11px;
  }

  .plugin-setting-option {
    min-height: 88px;
    display: grid;
    grid-template-columns: minmax(180px, .42fr) minmax(260px, .58fr);
    gap: 24px;
    padding: 18px;

    &:not(:first-child) { border-top: 1px solid var(--border-color); }
  }

  .plugin-setting-option-copy {
    display: grid;
    align-content: start;
    gap: 4px;

    strong { color: var(--text-1); font-size: 12px; font-weight: 500; }
    small { color: var(--text-3); font-size: 10px; line-height: 1.45; }
  }

  .plugin-setting-control {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 8px;

    > input:not([type='checkbox']),
    > select,
    textarea {
      width: 100%;
      min-width: 0;
    }

    > .appearance-desktop-switch { margin-top: 4px; }
    > .plugin-setting-array,
    > .plugin-setting-object,
    > .plugin-setting-json-field,
    > .plugin-setting-option-error { grid-column: 1 / -1; }
  }

  .plugin-setting-array {
    display: grid;
    gap: 9px;
  }

  .plugin-setting-array-item {
    display: grid;
    gap: 8px;
    padding: 12px;
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 10px;

    > small { color: var(--text-3); font-size: 10px; }
  }

  .plugin-setting-array-item-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;

    strong { font-size: 11px; font-weight: 500; }
    .danger { color: var(--danger-color); }
  }

  .plugin-setting-object {
    display: grid;
    gap: 12px;

    &.inline { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  }

  .plugin-setting-object-field,
  .plugin-setting-json-field {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 5px;

    > span { color: var(--text-2); font-size: 10px; }
    > small { color: var(--text-3); font-size: 9px; }
  }

  .plugin-setting-json-field textarea {
    min-height: 120px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1.5;
  }

  .plugin-setting-field-error,
  .plugin-setting-option-error {
    color: var(--danger-color) !important;
    font-size: 10px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 700px) {
    .plugin-settings-editor-heading { flex-direction: column; }
    .plugin-setting-option { grid-template-columns: 1fr; gap: 14px; }
    .plugin-setting-control { grid-template-columns: minmax(0, 1fr); }
    .plugin-setting-control > .primary-mini { justify-self: start; }
  }
}
