[data-transparency-mode="opaque"] .activity-bar {
  padding-top: 6px;
}

.activity-bar {
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 2px 6px 10px 6px;
  background: transparent;
  -webkit-app-region: drag;

  > button {
    position: relative;
    flex: 0 0 38px;
    width: 38px;
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 9px;
    color: --text-3;
    background: transparent;
    -webkit-app-region: no-drag;

    &:hover {
      color: --text-1;
      background: --item-hover;
    }

    &[aria-current="page"] {
      color: --text-1;
      background: --item-active;
    }

    &:focus-visible {
      outline: 2px solid --primary-color;
      outline-offset: 2px;
    }

    &.activity-settings {
      margin-top: auto;
    }

    > .activity-count-badge {
      position: absolute;
      top: -2px;
      right: -3px;
      min-width: 17px;
      height: 17px;
      padding: 0 4px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      color: --background-0;
      background: --text-1;
      font-size: --font-xs;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      pointer-events: none;
    }

    > .activity-update-badge {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: --primary-color;
    }
  }
}

.app-composer {
  min-width: 0;
  min-height: 0;
  display: grid;
  overflow: hidden;
  border-left: 1px solid --border-color;

  > .settings-composer {
    min-width: 0;
    min-height: 0;
    display: grid;
  }

  > .home-composer {
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-columns: var(--sidebar-width, 222px) 0 minmax(0, 1fr);
    transition: grid-template-columns var(--duration-slow) var(--ease-smooth-out);

    > .home-sidebar {
      min-width: 0;
      min-height: 0;
      display: grid;
      overflow: hidden;
    }
  }

  .chat-view-slot {
    min-width: 0;
    min-height: 0;
    display: grid;
  }

  [hidden] {
    display: none !important;
  }

  :root[data-transparency-mode="transparent"] & {
    border-left: none;

    .sidebar {
      --sidebar-background: var(--background-transparent-2, color-mix(in srgb, var(--background-1) 35%, transparent));
    }
  }
}

.app-shell.sidebar-collapsed .home-composer {
  grid-template-columns: 58px 0 minmax(0, 1fr);
  transition-duration: var(--duration-medium);
}

.app-shell.inbox-active .home-composer {
  grid-template-columns: minmax(0, 1fr);
}

.app-shell.narrow-window {
  --navigation-drawer-width: min(var(--sidebar-width, 222px), calc(100vw - 112px));

  .auxiliary-panel-toggle.navigation-toggle {
    right: auto;
    left: 10px;
    z-index: 64;

    &[aria-expanded="true"] {
      opacity: 1;
    }
  }

  > .activity-bar,
  .home-composer > .home-sidebar {
    position: fixed;
    top: 0;
    bottom: 0;
    z-index: 60;
    background: --background-1;
    visibility: hidden;
    transform: translateX(calc(-52px - var(--navigation-drawer-width)));
    transition: transform var(--duration-medium) var(--ease-smooth-out),
      visibility 0s linear var(--duration-medium);
  }

  > .activity-bar {
    left: 0;
    width: 52px;
    padding-top: 48px;
  }

  .home-composer > .home-sidebar {
    left: 52px;
    width: var(--navigation-drawer-width);
    border-left: 1px solid --border-color;

    > .sidebar {
      min-width: 0;
    }

    .sidebar-toggle {
      display: none;
    }
  }

  &.navigation-open {
    > .activity-bar,
    .home-composer > .home-sidebar {
      visibility: visible;
      transform: none;
      box-shadow: 16px 0 32px -16px rgb(0 0 0 / 24%);
      transition: transform var(--duration-slow) var(--ease-smooth-out);
    }
  }

  .app-composer {
    border-left: none;

    > .home-composer,
    .chat-workspace {
      grid-template-columns: minmax(0, 1fr);
      animation: none;
    }
  }

  .settings-sidebar-titlebar {
    flex-basis: 48px;
  }

  .chat-view-slot .chat-scroll {
    padding-top: 48px;
  }

  .chat-workspace > .orchestration-container > .orchestration-page {
    padding-top: 56px;
  }
}

.folders-page {
  > .folder-navigation {
    min-width: 0;

    > h2 {
      margin: 10px 16px;
      font-size: --font-lg;
      font-weight: 600;
    }

    > .folder-global {
      flex: 0 0 auto;
      padding-bottom: 8px;
      border-bottom: 1px solid --border-color;
    }

    > .settings-search {
      flex: 0 0 32px;
      min-width: 0;

      > svg {
        flex-shrink: 0;
      }
    }

    > h2 {
      flex-shrink: 0;
    }

    > .folder-navigation-scroll {
      flex: 1 1 0;
      min-width: 0;
      min-height: 0;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-gutter: stable;
      scrollbar-width: thin;

      .folder-navigation-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 16px;
        min-width: 0;

        > strong {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }

      .settings-navigation {
        min-width: 0;
        grid-template-columns: minmax(0, 1fr);
        overflow: visible;

        button {
          min-width: 0;
          max-width: 100%;

          > svg {
            flex-shrink: 0;
          }
        }

        p {
          color: --text-3;
          padding: 0 10px;
          font-size: --font-sm;
          overflow-wrap: anywhere;
        }

        button > span {
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .app-shell.narrow-window > .activity-bar,
  .app-shell.narrow-window .home-composer > .home-sidebar,
  .app-shell.narrow-window.navigation-open > .activity-bar,
  .app-shell.narrow-window.navigation-open .home-composer > .home-sidebar {
    transition: none;
  }
}