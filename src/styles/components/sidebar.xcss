.sidebar {
  --sidebar-font-size: 13px;
  position: relative;
  z-index: 55;
  display: flex;
  flex-direction: column;
  min-height: 0;
  background: --background-2;
  font-size: --sidebar-font-size;
  border-right: 1px solid var(--border-color);

  .sidebar-titlebar {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px;
  }

  .app-name {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-1);
  }

  .sidebar-toggle {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    color: var(--text-3);
    background: transparent;
    border-radius: 6px;
    -webkit-app-region: no-drag;

    &:hover {
      background: var(--item-hover);
    }
  }

  .conversation-item .icon-button {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    opacity: 0;
    cursor: default !important;
    pointer-events: none;

    &:hover {
      opacity: 1 !important;
      background-color: transparent;
    }
  }

  .nav-actions {
    display: grid;
    gap: 2px;
    padding: 6px 8px;
  }

  .nav-actions button,
  .settings-button,
  .conversation-main {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--text-1);
    background: transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: --sidebar-font-size;
    text-align: left;
  }

  .nav-actions button:hover,
  .settings-button:hover,
  .conversation-item:hover {
    background: var(--item-hover);
  }

  .nav-actions button.active,
  .conversation-item.active,
  .conversation-item.menu-open {
    background: var(--item-active);
  }

  .conversation-item:hover .icon-button,
  .conversation-item.menu-open .icon-button {
    opacity: .4;
    pointer-events: auto;
  }

  .conversation-item:hover .conversation-age,
  .conversation-item.menu-open .conversation-age {
    opacity: 0;
  }

  .nav-actions button:disabled {
    color: var(--text-4);
  }

  .recent-label {
    padding: 10px 16px 0 16px;
    margin: 1em 0 1em 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid --border-color;
    gap: 6px;
    color: var(--text-4);
  }

  .recent-title {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .recent-filter-button {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    color: var(--text-3);
    background: transparent;
    border-radius: 5px;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &.active {
      color: var(--text-1);
      background: var(--item-active);
    }
  }

  .conversation-list {
    min-height: 0;
    overflow: auto;
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 6px;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--text-4) transparent;

    &::-webkit-scrollbar {
      width: 10px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      min-height: 44px;
      background: var(--text-4);
      background-clip: padding-box;
      border: 3px solid transparent;
      border-radius: 999px;
    }

    &:hover::-webkit-scrollbar-thumb {
      background: var(--text-3);
      background-clip: padding-box;
    }

    &::-webkit-scrollbar-button {
      width: 0;
      height: 0;
      display: none;
    }
  }

  .conversation-group {
    min-width: 0;
    display: grid;
    gap: 2px;

    + .conversation-group {
      margin-top: 1.25em;
    }
  }

  .conversation-group-header {
    min-width: 0;
    min-height: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin: 4px 6px 2px 10px;
    color: var(--text-3);

    > span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .conversation-group-actions {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .conversation-group-actions > button {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      display: grid;
      place-items: center;
      padding: 0;
      color: var(--text-3);
      background: transparent;
      border-radius: 9999px;
      opacity: .72;
      transition: color 180ms var(--base-transition),
        background 180ms var(--base-transition),
        opacity 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      &:hover,
      &:focus-visible {
        color: var(--text-1);
        background: var(--item-hover);
        opacity: 1;
      }

      &.active {
        color: var(--text-1);
        background: var(--item-active);
        opacity: 1;
      }

      &:active {
        transform: scale(.92);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .conversation-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 28px;
    align-items: center;
    width: 100%;
    border-radius: 6px;
    cursor: default !important;
    transition: .3s var(--base-transition);
  }

  .conversation-main {
    display: flex;
    gap: 6px;
    padding: 5px 6px;
    padding-left: 20px;
    width: 100%;
    cursor: default !important;
  }

  .conversation-title {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .conversation-age {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    flex: 0 0 auto;
    color: var(--text-4);
    font-size: 12px;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 120ms var(--base-transition);
  }

  .conversation-show-toggle {
    width: fit-content;
    margin: 2px 0 4px 13px;
    padding: 4px 6px;
    color: var(--text-3);
    background: transparent;
    border-radius: 5px;
    font-size: 12px;
    text-align: left;

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
    }
  }

  .run-dot {
    display: none;
    border-radius: 999px;

    &.live {
      display: block;
      width: 6px;
      height: 6px;
      flex: 0 0 6px;
      background: var(--text-1);
      box-shadow: 0 0 0 4px var(--text-4);
    }
  }

  .nav-actions button,
  .settings-button {
    border-radius: 12px;
    padding: 6px 12px;
  }

  .settings-button {
    margin: auto 4px 4px 4px;
    width: calc(100% - 8px);
    border-radius: 6px;
  }

  .conversation-item,
  .conversation-main {
    border-radius: 12px;
  }

  .conversation-main {
    padding: 6px 10px;
  }
}

.sidebar-collapsed .sidebar {
  padding-inline: 8px;
}

.sidebar-collapsed .sidebar-titlebar {
  justify-content: center;
  padding-inline: 0;
}

.sidebar-collapsed .app-name,
.sidebar-collapsed .nav-actions span,
.sidebar-collapsed .recent-label,
.sidebar-collapsed .conversation-group-header,
.sidebar-collapsed .conversation-show-toggle,
.sidebar-collapsed .conversation-title,
.sidebar-collapsed .conversation-age,
.sidebar-collapsed .settings-button span {
  display: none;
}

.sidebar-collapsed .nav-actions button,
.sidebar-collapsed .settings-button,
.sidebar-collapsed .conversation-main {
  justify-content: center;
  padding-inline: 0;
}

.sidebar-collapsed .conversation-item {
  grid-template-columns: minmax(0, 1fr);

  .icon-button {
    display: none;
  }
}

.sidebar-collapsed .nav-actions button,
.sidebar-collapsed .settings-button,
.sidebar-collapsed .conversation-main {
  padding: 9px 0;
}