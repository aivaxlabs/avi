.sidebar {
  --sidebar-font-size: 1rem;
  --sidebar-text-muted-opacity: .62;
  --sidebar-background: transparent;
  --sidebar-background-hover: var(--background-3);
  --sidebar-background-active: var(--background-4);
  --sidebar-border-color: var(--border-color);
  position: relative;
  z-index: 55;
  display: flex;
  flex-direction: column;
  min-height: 0;
  color: var(--text-1);
  background: var(--sidebar-background);
  font-size: --sidebar-font-size;
  border-right: 1px solid var(--sidebar-border-color);

  :root[data-transparency-mode="transparent"] & {
    --sidebar-background-hover: var(--background-transparent-3, color-mix(in srgb, var(--background-3) 72%, transparent));
    --sidebar-background-active: var(--background-transparent-4, color-mix(in srgb, var(--background-4) 72%, transparent));
    --sidebar-border-color: color-mix(in srgb, var(--text-1) 08%, transparent);
    backdrop-filter: saturate(135%);
    border-right: none;
  }

  .sidebar-sticky-top {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    box-shadow: 0 1px 0 0 #00000000;
    transition: .3s --base-transition;

    & .scrolled {
      box-shadow: 0 1px 3px 0 #00000011;
    }

    .nav-actions {
      margin-bottom: 0;
    }
  }

  .sidebar-sticky-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--text-1) 32%, transparent) transparent;

    .nav-actions {
      margin-top: -4px;
    }

    &::-webkit-scrollbar {
      width: 10px;
    }

    &::-webkit-scrollbar-track {
      background: transparent;
    }

    &::-webkit-scrollbar-thumb {
      min-height: 44px;
      background: color-mix(in srgb, var(--text-1) 32%, transparent);
      background-clip: padding-box;
      border: 3px solid transparent;
      border-radius: 999px;
    }

    &:hover::-webkit-scrollbar-thumb {
      background: color-mix(in srgb, var(--text-1) 48%, transparent);
      background-clip: padding-box;
    }

    &::-webkit-scrollbar-button {
      width: 0;
      height: 0;
      display: none;
    }
  }

  .sidebar-titlebar {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px 6px 18px;
  }

  .app-name {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    opacity: var(--sidebar-text-muted-opacity);
    color: var(--text-1);

    img {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      object-fit: contain;

      :root[data-color-scheme="dark"] & {
        filter: invert(1);
      }
    }
  }

  .sidebar-toggle {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    color: var(--text-1);
    background: transparent;
    border-radius: 6px;
    opacity: var(--sidebar-text-muted-opacity);
    -webkit-app-region: no-drag;

    &:hover {
      background: var(--sidebar-background-hover);
      opacity: 1;
    }
  }

  .conversation-item .icon-button {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    opacity: 0;
    cursor: default !important;
    pointer-events: none;

    &:hover {
      opacity: 1 !important;
      background-color: transparent;
    }
  }

  .nav-actions {
    display: grid;
    gap: 2px;
    padding: 4px 8px;
    margin-bottom: .75em;
  }

  .nav-actions button,
  .settings-button,
  .conversation-main {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    color: var(--text-1);
    background: transparent;
    border-radius: 6px;
    padding: 4px 8px;
    font-size: --sidebar-font-size;
    text-align: left;
  }

  .nav-actions button:hover,
  .settings-button:hover,
  .conversation-item:hover {
    background: var(--sidebar-background-hover);
  }

  .nav-actions button.active,
  .conversation-item.active,
  .conversation-item.menu-open {
    background: var(--sidebar-background-active);
  }

  .conversation-item:hover .icon-button,
  .conversation-item.menu-open .icon-button {
    opacity: .4;
    pointer-events: auto;
  }

  .conversation-item:hover .conversation-age,
  .conversation-item.menu-open .conversation-age {
    opacity: 0;
  }

  .nav-actions button:disabled {
    color: var(--text-1);
    opacity: var(--sidebar-text-muted-opacity);
  }

  .recent-label {
    padding: 10px 16px 0 16px;
    margin-bottom: .75em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--sidebar-border-color);
    gap: 6px;
    color: var(--text-1);
  }

  .recent-title {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    opacity: var(--sidebar-text-muted-opacity);
  }

  .recent-filter-button {
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    color: var(--text-1);
    background: transparent;
    border-radius: 5px;
    opacity: var(--sidebar-text-muted-opacity);

    &:hover {
      background: var(--sidebar-background-hover);
      opacity: 1;
    }

    &.active {
      background: var(--sidebar-background-active);
      opacity: 1;
    }
  }

  .conversation-filter-empty {
    display: grid;
    gap: 8px;
    justify-items: center;
    padding: 18px 12px;
    color: var(--text-1);
    font-size: .9rem;
    text-align: center;
    opacity: var(--sidebar-text-muted-opacity);

    button {
      padding: 4px 10px;
      color: var(--text-1);
      background: var(--sidebar-background-hover);
      border: none;
      border-radius: 8px;
      font-size: .9rem;
    }
  }

  .conversation-list {
    min-height: 0;
    display: grid;
    align-content: start;
    gap: 2px;
    padding: 6px;
    margin-bottom: 4px;
    border-bottom: 1px solid var(--sidebar-border-color);
  }

  .conversation-group {
    min-width: 0;
    display: grid;
    gap: 2px;

    + .conversation-group {
      margin-top: 1.25em;
    }
  }

  .conversation-group-header {
    min-width: 0;
    min-height: 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin: 4px 6px 2px 10px;
    color: var(--text-1);

    > .conversation-group-title {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 6px;
      opacity: var(--sidebar-text-muted-opacity);

      > svg {
        flex: 0 0 auto;
      }

      > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    .conversation-group-actions {
      display: flex;
      align-items: center;
      gap: 2px;
    }

    .conversation-group-actions > button {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      display: grid;
      place-items: center;
      padding: 0;
      color: var(--text-1);
      background: transparent;
      border-radius: 9999px;
      opacity: var(--sidebar-text-muted-opacity);
      transition: color 180ms var(--base-transition),
        background 180ms var(--base-transition),
        opacity 180ms var(--base-transition),
        transform 180ms var(--base-transition);

      &:hover,
      &:focus-visible {
        color: var(--text-1);
        background: var(--sidebar-background-hover);
        opacity: 1;
      }

      &.active {
        color: var(--text-1);
        background: var(--sidebar-background-active);
        opacity: 1;
      }

      &:active {
        transform: scale(.92);
      }

      &:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--text-1) 48%, transparent);
        outline-offset: 1px;
      }
    }
  }

  .conversation-item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 32px;
    align-items: center;
    width: 100%;
    border-radius: 6px;
    cursor: default !important;
    transition: .3s var(--base-transition);

    & .bot-item {

      .conversation-main {
        gap: 13px;
        padding-left: 6px;
      }
    }
  }

  .conversation-main {
    display: flex;
    gap: 6px;
    padding: 5px 6px;
    padding-left: 20px;
    width: 100%;
    cursor: default !important;
  }

  .conversation-title {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .conversation-tag-dots {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex: 0 0 auto;
  }

  .conversation-age {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    flex: 0 0 auto;
    color: var(--text-1);
    font-size: .9rem;
    opacity: var(--sidebar-text-muted-opacity);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 120ms var(--base-transition);
  }

  .conversation-show-toggle {
    width: fit-content;
    margin: 2px 0 4px 23px;
    padding: 4px 6px;
    color: var(--text-1);
    background: transparent;
    border-radius: 5px;
    font-size: .9rem;
    text-align: left;
    opacity: var(--sidebar-text-muted-opacity);

    &:hover {
      background: var(--sidebar-background-hover);
      opacity: 1;
    }
  }

  .completion-indicator {
    flex: 0 0 auto;
    color: var(--success-color);
  }

  .attention-indicator {
    flex: 0 0 auto;
    color: var(--warn-color);
  }

  .sleep-indicator {
    flex: 0 0 auto;
    color: var(--text-1);
    opacity: var(--sidebar-text-muted-opacity);
  }

  .run-spinner {
    flex: 0 0 auto;
    color: var(--text-1);
    animation: sidebar-run-spin 800ms linear infinite;

    @media (prefers-reduced-motion: reduce) {
      animation: none;
    }
  }

  .nav-actions button,
  .settings-button {
    border-radius: 12px;
    padding: 5px 12px;

    svg {
      width: 14px;
      height: 14px;
      opacity: .7;
    }

    & :hover {
      svg {
        opacity: 1;
      }
    }
  }

  .settings-button {
    position: relative;
    .settings-update-badge {
      position: absolute;
      top: 4px;
      right: 6px;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--success-color);
    }
    flex: 0 0 auto;
    margin: 4px;
    border-radius: 6px;
  }

  .conversation-item,
  .conversation-main {
    border-radius: 8px;
  }

  .conversation-main {
    padding: 6px 10px;
    padding-left: 29px;
  }
}

.conversation-tooltip {
  position: fixed;
  z-index: 110;
  width: max-content;
  min-width: 230px;
  max-width: 280px;
  display: grid;
  gap: 3px;
  padding: 8px 12px;
  background: --background-1;
  border: 1px solid --border-color;
  border-radius: 12px;
  box-shadow: 0 4px 12px #00000022;
  pointer-events: none;
  font-size: .9rem;

  .conversation-tooltip-title {
    max-width: 100%;
    margin-bottom: 3px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: --text-1;
    font-weight: 600;
  }

  .conversation-tooltip-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;

    svg {
      flex: 0 0 auto;
      color: --text-3;
    }
  }

  .conversation-tooltip-label {
    flex: 0 0 82px;
    color: --text-4;
  }

  .conversation-tooltip-value {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: --text-1;
  }
}

.tag-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-radius: 9999px;

  &.large {
    width: 10px;
    height: 10px;
  }
}

.color-swatch {
  width: 18px;
  height: 18px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  padding: 0;
  background: transparent;
  border: 1px solid var(--border-color);
  border-radius: 9999px;
  cursor: pointer;
  transition: transform 120ms var(--base-transition),
    box-shadow 120ms var(--base-transition);

  &:hover,
  &:focus-visible {
    transform: scale(1.12);
  }

  &:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: 1px;
  }

  &.active {
    box-shadow: 0 0 0 2px var(--background-1), 0 0 0 4px var(--text-3);
  }

  &.none {
    color: var(--text-3);
    border-style: dashed;

    &:hover {
      color: var(--text-1);
    }
  }
}

.folder-color-picker {
  display: grid;
  gap: 6px;
  padding: 6px 10px 8px;
}

.folder-color-picker-label {
  color: var(--text-3);
  font-size: .9rem;
  letter-spacing: .04em;
  text-transform: uppercase;
}

.folder-color-swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  max-width: 216px;
}

.sidebar-collapsed .sidebar {
  padding-inline: 0;
  background-color: transparent;
  border-right-color: transparent;
  opacity: .4;
  transition: .3s --base-transition;

  > .sidebar-sticky-scroll {
    scrollbar-gutter: auto;
  }

  & :hover {
    opacity: 1;
  }
}

.sidebar-collapsed .sidebar-titlebar {
  justify-content: center;
  padding-inline: 0;
}

.sidebar-collapsed .nav-actions {
  padding: 0;
}

.sidebar-collapsed .app-name,
.sidebar-collapsed .nav-actions span,
.sidebar-collapsed .recent-label,
.sidebar-collapsed .conversation-list,
.sidebar-collapsed .sidebar-bots,
.sidebar-collapsed .settings-button span {
  display: none;
}

.sidebar-collapsed .nav-actions button,
.sidebar-collapsed .settings-button,
.sidebar-collapsed .conversation-main {
  justify-content: center;
  padding-inline: 0;
}

.sidebar-collapsed .conversation-item {
  grid-template-columns: minmax(0, 1fr);

  .icon-button {
    display: none;
  }
}

.sidebar-collapsed .nav-actions button,
.sidebar-collapsed .settings-button,
.sidebar-collapsed .conversation-main {
  padding: 9px 0;
}

@keyframes sidebar-run-spin {
  to {
    transform: rotate(360deg);
  }
}