.markdown-body {
  .directive-heading {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 1.75em 0 .45em;
    color: var(--text-1);
    font-size: 1rem;
    font-weight: 600;

    > svg {
      flex: 0 0 auto;
    }

    > span {
      min-width: 0;
    }

    &.callout-info {
      color: var(--primary-color);
    }

    &.callout-success {
      color: var(--success-color);
    }

    &.callout-warning,
    &.finding-p1 {
      color: var(--warn-color);
    }

    &.callout-danger,
    &.finding-p0 {
      color: var(--danger-color);
    }

    &.finding-heading {
      &::before {
        content: attr(data-directive-label);
        flex: 0 0 auto;
        width: 32px;
        padding: 1px 0;
        background: color-mix(in srgb, currentColor 9%, transparent);
        border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
        border-radius: 4px;
        font: 700 .9rem var(--font-code);
        text-align: center;
      }
    }

    strong,
    code {
      color: inherit;
    }
  }

  .inline-callout {
    padding: 1px 5px;
    background: color-mix(in srgb, currentColor 10%, transparent);
    border-radius: 4px;
    font-weight: 600;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;

    > svg {
      margin-right: 4px;
      vertical-align: -2px;
    }

    &.callout-info {
      color: var(--primary-color);
    }

    &.callout-success {
      color: var(--success-color);
    }

    &.callout-warning {
      color: var(--warn-color);
    }

    &.callout-danger {
      color: var(--danger-color);
    }

    strong,
    code {
      color: inherit;
    }
  }

  .avi-diff-code {
    max-height: min(520px, 60vh);
    margin: 0;
    border-radius: 0;
    font: .9rem/1.55 var(--font-code);
  }

  .rich-chart-progress {
    .rich-chart-bar-row {
      grid-template-columns: minmax(70px, 140px) minmax(100px, 1fr) minmax(70px, auto);

      i {
        background: var(--success-color);
      }
    }
  }

  .async-visualization {
    min-width: 0;
    max-width: 100%;
    margin: 12px 0;
    padding: 16px 0;
    overflow: auto;

    &.is-loading {
      min-height: 96px;
      background: linear-gradient(100deg, var(--background-2) 25%, var(--background-3) 40%, var(--background-2) 55%);
      background-size: 220% 100%;
      animation: visualization-loading 1.4s ease-in-out infinite;
    }

    &.has-error {
      color: var(--danger-color);

      pre {
        margin: 10px 0 0;
        color: var(--text-2);
      }
    }
  }

  .mermaid-visualization {
    position: relative;
    overflow: visible;

    > img {
      width: auto;
      max-width: 100%;
      max-height: min(680px, 75vh);
      display: block;
      margin-inline: auto;
      object-fit: contain;
    }

    .mermaid-expand {
      position: absolute;
      top: 8px;
      right: 0;
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      color: var(--text-3);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      transition: background var(--duration-quick) var(--ease-smooth-out), color var(--duration-quick) var(--ease-smooth-out);

      &:hover,
      &:focus-visible {
        color: var(--text-1);
        background: var(--item-active);
      }

      &:focus-visible {
        outline: 2px solid var(--text-3);
        outline-offset: 1px;
      }
    }
  }

  .latex-visualization {
    color: var(--text-1);
    text-align: center;
  }
}

.attachment-lightbox.mermaid-lightbox > img {
  width: calc(100vw - 96px);
  height: calc(100vh - 96px);
  box-sizing: border-box;
  padding: 24px;
  background: var(--background-0);
}

@keyframes visualization-loading {
  from {
    background-position: 100% 0;
  }

  to {
    background-position: -100% 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .markdown-body .async-visualization.is-loading {
    animation: none;
  }

  .markdown-body .mermaid-expand {
    transition: none;
  }
}