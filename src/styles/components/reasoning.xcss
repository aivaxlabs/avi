.thinking-group {
  margin-bottom: 6px;
}

.thinking-summary,
.worked-summary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 2px 0;
  color: var(--color-muted-alt);
  background: transparent;
  border: 0;
  font-size: 12px;
}

.worked-block {
  margin-bottom: 6px;
  padding-bottom: 6px;
  border-bottom: 1px solid var(--color-divider);
}

.worked-summary {
  color: var(--color-muted-worked);
  font-size: 13px;
  font-weight: 400;
}

.thinking-details,
.worked-details {
  display: grid;
  grid-template-rows: 0fr;
  margin: 0;
  opacity: 0;
  transition:
    grid-template-rows 180ms var(--base-transition),
    margin 180ms var(--base-transition),
    opacity 140ms var(--base-transition);
}

.thinking-group.open .thinking-details,
.worked-block.open .worked-details {
  grid-template-rows: 1fr;
  margin: 11px 0 13px;
  opacity: 1;
}

.thinking-details-inner,
.worked-details-inner {
  overflow: hidden;
  display: grid;
}

.thinking-details-inner {
  gap: 5px;
}

.worked-details-inner {
  gap: 8px;
}

.reasoning-text {
  color: var(--color-muted-warm);
  font-size: 12.6px;
  line-height: 1.42;
}

.reasoning-text > :last-child {
  margin-bottom: 0;
}

.reasoning-text p,
.reasoning-text ul,
.reasoning-text ol,
.reasoning-text pre {
  margin: 0 0 10px;
}

.reasoning-text h1,
.reasoning-text h2,
.reasoning-text h3 {
  margin: 10px 0 6px;
  color: var(--color-muted-warm);
  font-size: 13px;
  line-height: 1.35;
}

.reasoning-text code {
  padding: 1px 4px;
  border-radius: 4px;
  background: var(--surface-code-inline);
}

.reasoning-text pre {
  padding: 10px;
  overflow: auto;
  border-radius: 8px;
  background: var(--surface-code-block);
  color: var(--color-code-text);
}

.tool-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  width: 100%;
  gap: 5px;
  color: var(--color-muted-warm);
  font-size: 12.6px;
  line-height: 1.45;
  cursor: pointer;
  list-style: none;
}

.tool-line::-webkit-details-marker {
  display: none;
}

.tool-line:hover {
  color: var(--color-text-primary);
}

.tool-line:focus-visible {
  outline: 2px solid var(--border-accent);
  outline-offset: 2px;
}

:is(.reasoning-text, .tool-line) {
  position: relative;
  padding: 6px 0 6px 14px;
}

:is(.reasoning-text, .tool-line)::after {
  content: '\2022';
  position: absolute;
  left: 0;
  top: 5px;
  opacity: .5;
}

:is(.reasoning-text + .tool-line,
  .tool-line + .reasoning-text,
  .reasoning-text + .tool-entry .tool-line,
  .tool-entry + .reasoning-text)::before {
  content: '';
  position: absolute;
  border-top: 1px solid var(--color-divider-subtle);
  width: 30px;
  top: -3px;
}

.tool-line-icon {
  flex: 0 0 auto;
  color: var(--color-muted-icon);
}

.tool-line-chevron {
  flex: 0 0 auto;
  transition: transform 180ms var(--base-transition);
}

.tool-entry[open] .tool-line-chevron {
  transform: rotate(90deg);
}

.tool-line strong {
  color: var(--color-text-primary);
  font-weight: 500;
}

.tool-details {
  display: grid;
  gap: 8px;
  padding: 3px 0 8px 14px;
}

.tool-details section {
  min-width: 0;
}

.tool-details section > span {
  display: block;
  margin-bottom: 4px;
  color: var(--color-muted);
  font-size: 11px;
}

.tool-details pre {
  max-height: 260px;
  margin: 0;
  padding: 8px;
  overflow: auto;
  border: 1px solid var(--color-divider-subtle);
  border-radius: 8px;
  background: var(--surface-code-block-soft);
  color: var(--color-code-block-text);
  font: 11.5px/1.45 Consolas, "Cascadia Code", monospace;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.error-line {
  color: var(--color-danger);
}
