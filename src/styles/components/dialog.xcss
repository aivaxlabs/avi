.dialog-footer button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  color: --text-2;
  background: --background-3;
  font-size: 1rem;
}

.dialog-backdrop {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 30px;
  background: rgb(0 0 0 / 58%);
  backdrop-filter: blur(10px);
  z-index: 70;
  animation: dialog-backdrop-in var(--duration-fast) var(--ease-smooth-out);

  > :is(section, form, div) {
    animation: dialog-surface-in var(--duration-fast) var(--ease-smooth-out);
  }

  @media (max-width: 700px) {
    padding: 0;
  }
}

.search-dialog-backdrop {
  place-items: start center;
  padding: max(64px, 12vh) 30px 30px;
  background: rgb(0 0 0 / 44%);
  backdrop-filter: blur(8px);

  @media (max-width: 700px) {
    padding: 28px 14px 14px;
  }
}

.model-dialog,
.search-dialog,
.mcp-dialog {
  width: min(780px, 100%);
  max-height: min(720px, 88vh);
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  padding: 16px;
  background: --background-0;
  border: 1px solid --border-color;
  border-radius: 14px;
  box-shadow: 0 28px 90px #00000022;

  @media(max-width: 700px) {
    max-height: 100vh;
    border-radius: 0;
    border: none;
  }
}

.model-dialog {
  width: min(1040px, 100%);
  min-height: min(620px, 88vh);
  grid-template-rows: auto auto minmax(0, 1fr) auto;
}

.search-dialog {
  width: min(700px, 100%);
  max-height: min(680px, 80vh);
  grid-template-rows: auto minmax(0, 1fr);
  padding: 0;
  overflow: hidden;
  background: --background-1;
  border-color: rgb(127 127 127 / 18%);
  border-radius: 20px;
  box-shadow: 0 24px 64px rgb(0 0 0 / 24%), 0 2px 8px rgb(0 0 0 / 10%);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: start;

  h2 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 500;
  }
}

.dialog-header-actions {
  display: flex;
  gap: 6px;
}

.dialog-search {
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
  background: --background-4;
  border: 1px solid --border-color;
  border-radius: 8px;

  input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 1rem;
  }
}

.search-dialog .dialog-search {
  min-height: 52px;
  margin: 10px;
  gap: 10px;
  padding: 0 14px;
  color: --text-3;
  background: --background-0;
  border: 1px solid --border-color;
  border-radius: 11px;

  input {
    min-width: 0;
    height: 100%;
    color: --text-1;
    font-size: 1.1rem;
    caret-color: --text-1;

    &::placeholder {
      color: --text-3;
    }
  }

  kbd {
    padding: 2px 6px;
    color: --text-3;
    background: --background-3;
    border: 1px solid --border-color;
    border-radius: 6px;
    font-family: inherit;
    font-size: .9rem;
  }

  .search-spinner {
    flex: 0 0 auto;
    animation: search-dialog-spin 800ms linear infinite;
  }
}

.dialog-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  color: --text-3;
  font-size: .9rem;
}

.permission-dialog-backdrop {
  z-index: 90;
}

.tags-dialog-backdrop {
  z-index: 90;
}

.tags-dialog {
  width: min(440px, 100%);
  max-height: min(620px, 88vh);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto auto;
  gap: 10px;
  padding: 16px;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);
}

.workspace-dialog {
  width: min(480px, calc(100vw - 32px));
  margin: auto;
  padding: 0;
  overflow: hidden;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 12px;
  box-shadow: 0 16px 56px rgb(0 0 0 / 22%);

  &::backdrop {
    background: rgb(0 0 0 / 32%);
  }

  > form {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto auto;
    max-height: min(720px, calc(100dvh - 48px));
    min-height: 0;
    overflow: hidden;

    > .dialog-header {
      margin: 0;
      padding: 18px 20px 14px;

      > h2 {
        margin: 0;
        font-size: --font-md;
        font-weight: 600;
      }
    }

    > .workspace-dialog-body {
      min-height: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      padding: 0 20px;

      label {
        display: grid;
        gap: 7px;
        min-width: 0;
        font-size: --font-sm;

        > input {
          box-sizing: border-box;
          width: 100%;
          padding: 8px 10px;
          color: --text-1;
          background: --background-0;
          border: 1px solid --border-color;
          border-radius: 6px;
          font: inherit;

          &:focus-visible {
            outline: 2px solid --text-3;
            outline-offset: 2px;
          }
        }

        > span {
          overflow-wrap: anywhere;
          color: --text-3;
          font-size: --font-xs;
        }
      }

      > .workspace-location {
        margin: 7px 0 20px;
        color: --text-3;
        font: --font-xs --font-code;
        overflow-wrap: anywhere;
      }

      > .workspace-folders-heading {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: --font-sm;
        font-weight: 500;

        > span {
          color: --text-3;
          font-weight: 400;
        }
      }

      > .workspace-empty {
        margin: 10px 0 0;
        padding: 16px 12px;
        border: 1px dashed --border-color;
        border-radius: 6px;
        color: --text-3;
        font-size: --font-sm;
      }

      > .workspace-folder-row {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid --border-color;

        > svg {
          color: --text-3;
        }

        > label {
          gap: 2px;

          > input {
            padding: 4px 6px;
            margin-left: -7px;
            background: transparent;
            border-color: transparent;
            font-weight: 500;

            &:hover, &:focus {
              border-color: --border-color;
              background: --background-0;
            }
          }

          > span {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
          }
        }
      }
    }

    > .workspace-note {
      margin: 12px 20px 16px;
      color: --text-3;
      font-size: --font-xs;
      line-height: 1.5;
    }

    > .workspace-dialog-footer {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 20px;
      border-top: 1px solid --border-color;

      > button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        min-height: 32px;
        padding: 6px 10px;
        border: 1px solid transparent;
        border-radius: 6px;
        color: --text-2;
        background: transparent;
        font: inherit;
        font-size: --font-sm;
        cursor: pointer;

        &:hover:not(:disabled) {
          background: --item-hover;
        }

        &:disabled {
          opacity: .5;
          cursor: default;
        }

        &.workspace-add {
          margin-right: auto;
          border-color: --border-color;
        }

        &.workspace-submit {
          background: --text-1;
          color: --background-0;
          font-weight: 500;

          &:hover:not(:disabled) {
            background: --text-2;
          }
        }
      }
    }
  }
}

.tags-dialog-list {
  min-height: 60px;
  overflow-y: auto;
  display: grid;
  gap: 6px;
  align-content: start;
}

.tags-dialog-empty {
  margin: 0;
  padding: 14px 4px;
  color: --text-3;
  font-size: 1rem;
  text-align: center;
}

.tags-dialog-tag {
  display: grid;
  gap: 4px;
}

.tags-dialog-row {
  display: grid;
  grid-template-columns: auto minmax(120px, 1fr) auto;
  gap: 8px;
  align-items: center;
  padding: 6px 8px;
  background: --background-4;
  border: 1px solid --border-color;
  border-radius: 8px;

  input {
    width: 100%;
    padding: 5px 8px;
    color: --text-1;
    background: --background-0;
    border: 1px solid --border-color;
    border-radius: 6px;
    font: inherit;
    font-size: 1rem;

    &:focus-visible {
      outline: 2px solid --text-3;
      outline-offset: 1px;
    }
  }

  .icon-button.danger:hover {
    color: --danger-color;
    background: --item-hover;
  }
}

.tags-dialog .tag-dot.large.clickable {
  width: 16px;
  height: 16px;
  padding: 0;
  border: 1px solid var(--border-color);
  cursor: pointer;
  transition: transform 120ms var(--base-transition),
    box-shadow 120ms var(--base-transition);

  &:hover,
  &:focus-visible {
    transform: scale(1.15);
  }

  &:focus-visible,
  &.active {
    outline: 2px solid --text-3;
    outline-offset: 2px;
  }
}

.tags-dialog-palette {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  padding: 2px 8px 6px 32px;
}

.tags-dialog-add {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  padding: 8px;
  color: --text-3;
  background: transparent;
  border: 1px dashed --border-color;
  border-radius: 8px;
  font-size: 1rem;
  transition: color 180ms var(--base-transition),
    background 180ms var(--base-transition);

  &:hover,
  &:focus-visible {
    color: --text-1;
    background: --item-hover;
  }

  &:focus-visible {
    outline: 2px solid --text-3;
    outline-offset: 1px;
  }
}

.tags-dialog .dialog-footer {
  margin-top: 0;

  > div {
    display: flex;
    gap: 7px;
  }

  button:disabled {
    opacity: .5;
    cursor: wait;
  }
}

.goal-dialog-backdrop {
  z-index: 85;
}

.goal-dialog {
  width: min(620px, 100%);
  display: grid;
  gap: 14px;
  padding: 18px;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  .dialog-header {
    p {
      max-width: 500px;
      margin: 2px 0 0;
      color: --text-3;
      font-size: .9rem;
      line-height: 1.5;
    }
  }

  > label {
    margin-bottom: -7px;
    color: --text-1;
    font-size: .9rem;
    font-weight: 500;
  }

  > textarea {
    width: 100%;
    min-height: 190px;
    resize: vertical;
    padding: 11px 12px;
    color: --text-1;
    background: --background-4;
    border: 1px solid --border-color;
    border-radius: 8px;
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;

    &:focus-visible {
      outline: 2px solid --text-3;
      outline-offset: 1px;
    }

    &:disabled {
      opacity: .65;
    }
  }

  .dialog-footer {
    margin-top: 0;
    align-items: end;

    > span {
      max-width: 340px;
      line-height: 1.45;
    }

    > div {
      display: flex;
      gap: 7px;
    }

    .primary-mini {
      color: --text-5;
      background: --background-5;
      border-color: transparent;

      &:hover {
        background: --background-5;
      }
    }

    button:focus-visible {
      outline: 2px solid --text-3;
      outline-offset: 2px;
    }

    button:disabled {
      opacity: .5;
      cursor: wait;
    }
  }

  @media (max-width: 560px) {
    .dialog-footer {
      align-items: stretch;
      display: grid;

      > span {
        max-width: none;
      }

      > div {
        justify-content: end;
      }
    }
  }
}

.permission-dialog {
  width: min(540px, 100%);
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 16px;
  padding: 22px;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  h2,
  p,
  dl {
    margin: 0;
  }

  h2 {
    color: --text-1;
    font-size: 1.15rem;
  }

  p {
    margin-top: 5px;
    color: --text-3;
    font-size: .9rem;
    line-height: 1.55;
  }

  dl {
    display: grid;
    gap: 5px;
    margin-top: 14px;
    padding: 10px;
    background: --background-3;
    border-radius: 8px;
  }

  dl > div {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 8px;
  }

  dt {
    color: --text-3;
    font-size: .9rem;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: --text-1;
    font-size: .9rem;
  }

  pre {
    max-height: 180px;
    margin: 10px 0 0;
    padding: 10px;
    overflow: auto;
    color: --text-1;
    background: --background-2;
    border: 1px solid --border-color;
    border-radius: 8px;
    font-size: .9rem;
    line-height: 1.45;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
}

.permission-dialog-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  color: --text-1;
  background: --background-3;
  border: 1px solid --border-color;
  border-radius: 9px;
}

.permission-dialog-copy {
  min-width: 0;
}

.permission-dialog-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 8px;

  button {
    min-height: 32px;
    padding: 6px 10px;
    color: --text-2;
    background: --background-3;
    border: 1px solid --border-color;
    border-radius: 7px;
    font-size: .9rem;

    &:hover {
      background: --item-hover;
    }

    &:focus-visible {
      outline: 2px solid --text-3;
      outline-offset: 2px;
    }

    &:disabled {
      opacity: .5;
      cursor: wait;
    }
  }
}

@media (max-width: 560px) {
  .permission-dialog-actions {
    display: grid;
  }
}

.search-dialog .search-results {
  min-height: 0;
  display: grid;
  align-content: start;
  gap: 4px;
  padding: 0 10px 10px;
  overflow: auto;

  .search-results-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 8px 5px;
    color: --text-3;
    font-size: .9rem;
    font-weight: 500;

    span {
      min-width: 20px;
      padding: 1px 6px;
      background: --background-3;
      border-radius: 999px;
      text-align: center;
      font-size: .9rem;
    }
  }

  button {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    align-items: start;
    gap: 10px;
    min-height: 62px;
    padding: 10px 12px;
    text-align: left;
    color: --text-1;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    transition: background 120ms --base-transition, border-color 120ms --base-transition;

    &:hover,
    &.active {
      background: --item-hover;
      border-color: --border-color;
    }

    &:focus-visible {
      outline: 2px solid --text-3;
      outline-offset: -2px;
    }

    .search-result-icon {
      margin-top: 2px;
      color: --text-3;
    }

    .search-result-copy {
      min-width: 0;
      display: grid;
      gap: 4px;
    }

    .search-result-heading {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 8px;

      strong {
        min-width: 0;
        overflow: hidden;
        font-size: 1rem;
        font-weight: 600;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      small {
        flex: 0 1 auto;
        max-width: 34%;
        overflow: hidden;
        padding: 2px 6px;
        color: --text-3;
        background: --background-3;
        border-radius: 999px;
        font-size: .9rem;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .search-result-age {
        margin-left: auto;
        flex: none;
        color: --text-3;
        font-size: .9rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }
    }

    .search-result-preview {
      min-width: 0;
      overflow: hidden;
      color: --text-3;
      font-size: .9rem;
      line-height: 1.35;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  @media (max-width: 560px) {
    button {
      grid-template-columns: 20px minmax(0, 1fr);
      min-height: 58px;
      padding-inline: 9px;
    }
  }
}

.search-dialog .empty-list {
  min-height: 108px;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 8px;
  padding: 22px;
  color: --text-3;
  text-align: center;
  font-size: .9rem;
}

.provider-usages-backdrop,
.provider-resets-backdrop {
  z-index: 90;
  padding: max(38px, 7vh) 24px 24px;
  align-items: start;
}

.provider-resets-backdrop {
  z-index: 100;
}

.provider-usages-dialog,
.provider-resets-dialog {
  width: min(620px, 100%);
  max-height: min(720px, 86vh);
  display: grid;
  grid-template-rows: auto minmax(0, 1fr);
  gap: 14px;
  padding: 18px;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 14px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  .dialog-header {
    h2 {
      margin: 0;
      font-size: 1.1rem;
    }

    p {
      margin: 4px 0 0;
      color: --text-3;
      font-size: .9rem;
    }
  }
}

.provider-resets-dialog {
  width: min(520px, 100%);
}

.provider-usages-body,
.provider-resets-list {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 12px;
}

.provider-usage-card {

  > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 4px;
    padding: 0 10px 6px 10px;

    div {
      min-width: 0;
    }

    h3,
    small {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    h3 {
      margin: 0;
      color: --text-1;
      font-size: --font-md;
      font-weight: 500;
    }

    small {
      color: --text-3;
      font-size: --font-sm;
    }

    button {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      background: --background-4;
      border-radius: 32px;
      font-weight: 500;
      font-size: --font-sm;

      &:hover {
        color: --text-1;
        background: --item-hover;
      }
    }
  }

  + .provider-usage-card {
    margin-top: 1em;
  }
}

.provider-usage-limits,
.provider-usage-counters {
  display: grid;
  background: --background-1;
  border: 1px solid --border-color;
  border-radius: 12px;

  article {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(130px, 38%);
    align-items: center;
    gap: 14px;
    padding: 12px;

    + article {
      border-top: 1px solid --border-color;
    }
  }

  + :is(.provider-usage-limits, .provider-usage-counters) {
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  & :has(+ :is(.provider-usage-limits, .provider-usage-counters)) {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
  }
}

.provider-usage-copy,
.provider-usage-counters article > span,
.provider-resets-list article > span:first-child {
  min-width: 0;
  display: grid;
  gap: 3px;

  strong {
    color: --text-1;
    font-size: --font-md;
    font-weight: 400;
  }

  small {
    color: --text-3;
    font-size: --font-sm;
  }
}

.provider-usage-value {
  position: relative;
  display: grid;
  justify-items: end;
  color: --text-3;
  font-size: --font-sm;
  font-variant-numeric: tabular-nums;
}

.provider-usage-track {
  width: 100%;
  height: 5px;
  overflow: hidden;
  background: --background-4;
  border-radius: 999px;

  span {
    height: 100%;
    display: block;
    background: --text-1;
    border-radius: inherit;
  }

  + span {
    font-size: --font-xs;
    position: absolute;
    top: 5px;
  }
}

.provider-usage-counters article b {
  overflow-wrap: anywhere;
  color: --text-1;
  text-align: right;
  font-size: --font-sm;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.provider-resets-list article {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 16px;
  padding: 12px;
  background: --background-1;
  border: 1px solid --border-color;
  border-radius: 10px;

  > button,
  .provider-reset-confirmation button {
    padding: 4px 12px;
    background: --background-4;
    border-radius: 32px;
    font-weight: 500;
    font-size: --font-sm;

    &:hover:not(:disabled) {
      color: --text-1;
      background: --item-hover;
    }
  }
}

.provider-reset-confirmation {
  display: grid;
  justify-items: end;
  gap: 6px;

  > span {
    display: flex;
    gap: 6px;
  }

  .primary-mini {
    color: --background-1;
    background: --text-1;
  }
}

.provider-usages-state,
.provider-usages-empty,
.provider-usages-error,
.provider-usages-message {
  margin: 0;
  padding: 12px;
  color: --text-3;
  text-align: center;
  font-size: .9rem;
}

.provider-usages-state {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.provider-usages-error {
  color: --danger;
  background: color-mix(in srgb, var(--danger) 9%, transparent);
  border-radius: 8px;
}

.provider-usages-message {
  color: --text-1;
  background: --item-active;
  border-radius: 8px;
}

@media (max-width: 560px) {

  .provider-usages-backdrop,
  .provider-resets-backdrop {
    padding: 16px;
  }

  .provider-usage-limits article,
  .provider-usage-counters article,
  .provider-resets-list article {
    grid-template-columns: 1fr;
  }

  .provider-usage-value {
    justify-items: start;
  }

  .provider-usage-counters article b {
    text-align: left;
  }
}

@keyframes dialog-backdrop-in {
  from {
    opacity: 0;
  }
}

@keyframes dialog-surface-in {
  from {
    opacity: 0;
    transform: scale(var(--scale-large));
  }
}

@keyframes search-dialog-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .dialog-backdrop,
  .dialog-backdrop > :is(section, form, div) {
    animation: none;
  }

  .search-dialog .search-results button {
    transition: none;
  }

  .search-dialog .dialog-search .search-spinner {
    animation-duration: 1.6s;
  }
}