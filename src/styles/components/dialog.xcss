.dialog-footer button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 9px;
  color: var(--text-2);
  background: var(--background-3);
  font-size: 1rem;
}

.dialog-backdrop {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 30px;
  background: rgb(0 0 0 / 58%);
  backdrop-filter: blur(10px);
  z-index: 70;

  @media (max-width: 700px) {
    padding: 0;
  }
}

.search-dialog-backdrop {
  place-items: start center;
  padding: max(64px, 12vh) 30px 30px;
  background: rgb(0 0 0 / 44%);
  backdrop-filter: blur(8px);

  @media (max-width: 700px) {
    padding: 28px 14px 14px;
  }
}

.model-dialog,
.search-dialog,
.mcp-dialog {
  width: min(780px, 100%);
  max-height: min(720px, 88vh);
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  padding: 16px;
  background: var(--background-0);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: 0 28px 90px #00000022;

  @media(max-width: 700px) {
    max-height: 100vh;
    border-radius: 0;
    border: none;
  }
}

.model-dialog {
  width: min(1040px, 100%);
  min-height: min(620px, 88vh);
  grid-template-rows: auto auto minmax(0, 1fr) auto;
}

.search-dialog {
  width: min(640px, 100%);
  max-height: min(620px, 76vh);
  grid-template-rows: auto minmax(0, 1fr);
  padding: 0;
  overflow: hidden;
  background: var(--background-1);
  border-color: rgb(127 127 127 / 18%);
  border-radius: 20px;
  box-shadow: 0 24px 64px rgb(0 0 0 / 24%), 0 2px 8px rgb(0 0 0 / 10%);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: start;

  h2 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 500;
  }
}

.dialog-header-actions {
  display: flex;
  gap: 6px;
}

.dialog-search {
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
  background: var(--background-4);
  border: 1px solid var(--border-color);
  border-radius: 8px;

  input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 13px;
  }
}

.search-dialog .dialog-search {
  min-height: 58px;
  margin: 0;
  gap: 10px;
  padding: 0 16px;
  color: var(--text-3);
  background: transparent;
  border: 0;
  border-radius: 0;

  input {
    min-width: 0;
    height: 100%;
    color: var(--text-1);
    font-size: 15px;
    caret-color: var(--text-1);

    &::placeholder {
      color: var(--text-3);
    }
  }

  kbd {
    padding: 2px 6px;
    color: var(--text-3);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    font-family: inherit;
    font-size: 10px;
  }

  .search-spinner {
    flex: 0 0 auto;
    animation: search-dialog-spin 800ms linear infinite;
  }
}

.dialog-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  color: var(--text-3);
  font-size: 12px;
}

.permission-dialog-backdrop {
  z-index: 90;
}

.goal-dialog-backdrop {
  z-index: 85;
}

.goal-dialog {
  width: min(620px, 100%);
  display: grid;
  gap: 14px;
  padding: 18px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  .dialog-header {
    p {
      max-width: 500px;
      margin: 2px 0 0;
      color: var(--text-3);
      font-size: .9rem;
      line-height: 1.5;
    }
  }

  > label {
    margin-bottom: -7px;
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  > textarea {
    width: 100%;
    min-height: 190px;
    resize: vertical;
    padding: 11px 12px;
    color: var(--text-1);
    background: var(--background-4);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font: inherit;
    font-size: 13px;
    line-height: 1.5;

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &:disabled {
      opacity: .65;
    }
  }

  .dialog-footer {
    margin-top: 0;
    align-items: end;

    > span {
      max-width: 340px;
      line-height: 1.45;
    }

    > div {
      display: flex;
      gap: 7px;
    }

    .primary-mini {
      color: var(--text-5);
      background: var(--background-5);
      border-color: transparent;

      &:hover {
        background: var(--background-5);
      }
    }

    button:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    button:disabled {
      opacity: .5;
      cursor: wait;
    }
  }

  @media (max-width: 560px) {
    .dialog-footer {
      align-items: stretch;
      display: grid;

      > span {
        max-width: none;
      }

      > div {
        justify-content: end;
      }
    }
  }
}

.permission-dialog {
  width: min(540px, 100%);
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 16px;
  padding: 22px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  h2,
  p,
  dl {
    margin: 0;
  }

  h2 {
    color: var(--text-1);
    font-size: 16px;
  }

  p {
    margin-top: 5px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.55;
  }

  dl {
    display: grid;
    gap: 5px;
    margin-top: 14px;
    padding: 10px;
    background: var(--background-3);
    border-radius: 8px;
  }

  dl > div {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 8px;
  }

  dt {
    color: var(--text-3);
    font-size: 11px;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--text-1);
    font-size: 11px;
  }

  pre {
    max-height: 180px;
    margin: 10px 0 0;
    padding: 10px;
    overflow: auto;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 11px;
    line-height: 1.45;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
}

.permission-dialog-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  color: var(--text-1);
  background: var(--background-3);
  border: 1px solid var(--border-color);
  border-radius: 9px;
}

.permission-dialog-copy {
  min-width: 0;
}

.permission-dialog-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 8px;

  button {
    min-height: 32px;
    padding: 6px 10px;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    font-size: 12px;

    &:hover {
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: .5;
      cursor: wait;
    }
  }
}

@media (max-width: 560px) {
  .permission-dialog-actions {
    display: grid;
  }
}

.search-dialog .search-results {
  min-height: 0;
  padding: 7px;
  overflow: auto;
  border-top: 1px solid var(--border-color);

  .search-results-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 9px 6px;
    color: var(--text-3);
    font-size: 11px;

    span {
      min-width: 20px;
      padding: 1px 6px;
      background: var(--background-3);
      border-radius: 999px;
      text-align: center;
      font-size: 10px;
    }
  }

  button {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(140px, 34%) minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    min-height: 44px;
    padding: 8px 10px;
    text-align: left;
    color: var(--text-1);
    background: transparent;
    border: 0;
    border-radius: 10px;
    transition: background 120ms var(--base-transition);

    &:hover,
    &.active {
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }

    strong,
    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .search-result-heading {
      display: flex;
      align-items: center;
      gap: 7px;

      small {
        max-width: 45%;
        overflow: hidden;
        padding: 2px 6px;
        color: var(--text-3);
        background: var(--background-3);
        border-radius: 999px;
        font-size: 9px;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
    }

    strong {
      font-size: 13px;
      font-weight: 500;
    }

    span {
      color: var(--text-3);
      font-size: 12px;
    }
  }

  @media (max-width: 560px) {
    button {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
}

.search-dialog .empty-list {
  min-height: 108px;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 8px;
  padding: 22px;
  color: var(--text-3);
  text-align: center;
  font-size: 12px;
}

@keyframes search-dialog-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .search-dialog .search-results button {
    transition: none;
  }

  .search-dialog .dialog-search .search-spinner {
    animation-duration: 1.6s;
  }
}