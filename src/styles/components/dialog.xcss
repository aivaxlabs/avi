.dialog-footer button {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 30px;
  padding: 6px 9px;
  color: var(--text-2);
  background: var(--background-3);
  border: 1px solid var(--border-color);
  border-radius: 7px;
  font-size: 12px;
}

.dialog-backdrop {
  position: fixed;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 30px;
  background: rgb(0 0 0 / 58%);
  backdrop-filter: blur(10px);
  z-index: 70;

  @media (max-width: 700px) {
    padding: 14px;
  }
}

.model-dialog,
.search-dialog {
  width: min(780px, 100%);
  max-height: min(720px, 88vh);
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  padding: 16px;
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);
}

.model-dialog {
  width: min(1040px, 100%);
  min-height: min(620px, 88vh);
  grid-template-rows: auto auto minmax(0, 1fr) auto;
}

.search-dialog {
  width: min(640px, 100%);
  grid-template-rows: auto auto minmax(0, 1fr);
}

.dialog-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: start;

  h2 {
    margin: 0 0 4px;
    font-size: 17px;
  }
}

.dialog-header-actions {
  display: flex;
  gap: 6px;
}

.dialog-search {
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 9px 10px;
  background: var(--background-4);
  border: 1px solid var(--border-color);
  border-radius: 8px;

  input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font-size: 13px;
  }
}

.dialog-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  color: var(--text-3);
  font-size: 12px;
}

.permission-dialog-backdrop {
  z-index: 90;
}

.goal-dialog-backdrop {
  z-index: 85;
}

.goal-dialog {
  width: min(620px, 100%);
  display: grid;
  gap: 14px;
  padding: 18px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  .dialog-header {
    p {
      max-width: 500px;
      margin: 4px 0 0;
      color: var(--text-3);
      font-size: 12px;
      line-height: 1.5;
    }
  }

  > label {
    margin-bottom: -7px;
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }

  > textarea {
    width: 100%;
    min-height: 190px;
    resize: vertical;
    padding: 11px 12px;
    color: var(--text-1);
    background: var(--background-4);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font: inherit;
    font-size: 13px;
    line-height: 1.5;

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 1px;
    }

    &:disabled {
      opacity: .65;
    }
  }

  .dialog-footer {
    margin-top: 0;
    align-items: end;

    > span {
      max-width: 340px;
      line-height: 1.45;
    }

    > div {
      display: flex;
      gap: 7px;
    }

    .primary-mini {
      color: var(--text-5);
      background: var(--background-5);
      border-color: transparent;

      &:hover {
        background: var(--background-5);
      }
    }

    button:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    button:disabled {
      opacity: .5;
      cursor: wait;
    }
  }

  @media (max-width: 560px) {
    .dialog-footer {
      align-items: stretch;
      display: grid;

      > span {
        max-width: none;
      }

      > div {
        justify-content: end;
      }
    }
  }
}

.permission-dialog {
  width: min(540px, 100%);
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 16px;
  padding: 22px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  h2,
  p,
  dl {
    margin: 0;
  }

  h2 {
    color: var(--text-1);
    font-size: 16px;
  }

  p {
    margin-top: 5px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.55;
  }

  dl {
    display: grid;
    gap: 5px;
    margin-top: 14px;
    padding: 10px;
    background: var(--background-3);
    border-radius: 8px;
  }

  dl > div {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 8px;
  }

  dt {
    color: var(--text-3);
    font-size: 11px;
  }

  dd {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    color: var(--text-1);
    font-size: 11px;
  }

  pre {
    max-height: 180px;
    margin: 10px 0 0;
    padding: 10px;
    overflow: auto;
    color: var(--text-1);
    background: var(--background-2);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 11px;
    line-height: 1.45;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
}

.permission-dialog-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  color: var(--text-1);
  background: var(--background-3);
  border: 1px solid var(--border-color);
  border-radius: 9px;
}

.permission-dialog-copy {
  min-width: 0;
}

.permission-dialog-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 8px;

  button {
    min-height: 32px;
    padding: 6px 10px;
    color: var(--text-2);
    background: var(--background-3);
    border: 1px solid var(--border-color);
    border-radius: 7px;
    font-size: 12px;

    &:hover {
      background: var(--item-hover);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    &:disabled {
      opacity: .5;
      cursor: wait;
    }
  }
}

@media (max-width: 560px) {
  .permission-dialog-actions {
    display: grid;
  }
}

.search-results button {
  display: grid;
  gap: 4px;
  padding: 10px;
  text-align: left;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 8px;

  span {
    max-height: 42px;
    overflow: hidden;
    color: var(--text-3);
    font-size: 12px;
  }
}

.empty-list {
  padding: 22px;
  color: var(--text-3);
  text-align: center;
  font-size: 13px;
}
