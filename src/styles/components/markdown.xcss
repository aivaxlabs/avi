.markdown-body {
  min-width: 0;
  max-width: 100%;
  font-size: 14px;
  line-height: 1.68;

  > :last-child {
    margin-bottom: 0;
  }

  p,
  ul,
  ol,
  pre,
  table {
    margin: 0 0 12px;
  }

  a {
    color: --link-color;
    font-weight: 500;

    &:hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .file-reference-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    padding: 1px 5px;
    color: --link-color;
    line-height: 1.45;
    text-decoration: none;
    vertical-align: -.08em;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      border-color 180ms var(--base-transition);

    &:hover {
      color: var(--text-1);
      background: var(--item-hover);
      border-color: var(--border-color);
      text-decoration: none;
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: 2px;
    }

    svg {
      flex: 0 0 auto;
      color: var(--text-3);
    }

    span {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }

  h1 {
    font-size: 1.75em;
    border-bottom: 2px solid --border-color;
    margin: 1.25em 0 .5em 0;
  }

  h2 {
    font-size: 1.5em;
    border-bottom: 1px solid --border-color;
    margin: 1.25em 0 .5em 0;
  }

  h3 {
    font-size: 1.2em;
    margin: 1em 0 .5em 0;
    font-weight: 500;
  }

  .finding-heading {
    display: flex;
    align-items: baseline;
    margin: 2.5em 0 .5em 0;
    padding-bottom: .5em;
    border-bottom: 2px solid --border-color;
    gap: 8px;
    font-size: 1.15em;
    font-weight: 500;

    &::before {
      content: attr(data-finding-priority);
      background: color-mix(in srgb, currentColor 9%, transparent);
      border: 1px solid color-mix(in srgb, currentColor 30%, transparent);
      width: 36px;
      text-align: center;
      border-radius: 4px;
      flex: 0 0 auto;
      font-family: var(--font-code);
      font-size: .95em;
      font-weight: 700;
    }

    &.finding-p0 {
      color: var(--danger-color);
    }

    &.finding-p1 {
      color: var(--warn-color);
    }
  }

  code {
    padding: 2px 4px;
    border-radius: 4px;
    font-size: 13px;
    background: var(--background-3);
  }

  hr {
    border-top: 2px solid var(--border-color);
    border-bottom: none;
  }

  pre {
    padding: 12px;
    overflow: auto;
    border-radius: 8px;
    background: var(--background-2);
    color: var(--text-1);
  }

  table {
    width: fit-content;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    line-height: 1.45;
  }

  th,
  td {
    min-width: 120px;
    padding: 9px 11px;
    border-bottom: 1px solid var(--border-color);
    vertical-align: top;
    text-align: left;
  }

  th {
    color: var(--text-1);
    border-bottom: 2px solid var(--border-color);
    font-weight: 500;
  }

  td {
    color: var(--text-1);
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  td > :last-child,
  th > :last-child {
    margin-bottom: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .markdown-body .file-reference-link {
    transition: none;
  }
}