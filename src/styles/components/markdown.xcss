.markdown-body {
  min-width: 0;
  max-width: 100%;
  font-size: 14px;
  line-height: 1.68;

  > :last-child {
    margin-bottom: 0;
  }

  p,
  ul,
  ol,
  pre,
  table {
    margin: 0 0 12px;
  }

  a {
    color: --primary-color;
    font-weight: 500;

    & :hover {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  h1,
  h2,
  h3 {
    margin: 18px 0 8px;
    font-size: 16px;
    line-height: 1.3;
  }

  code {
    padding: 2px 4px;
    border-radius: 4px;
    background: var(--surface-code-inline);
  }

  hr {
    border-top: 2px solid var(--surface-code-inline);
    border-bottom: none;
  }

  pre {
    padding: 12px;
    overflow: auto;
    border-radius: 8px;
    background: var(--surface-code-block);
    color: var(--color-code-text);
  }

  table {
    width: fit-content;
    overflow-x: auto;
    border-collapse: collapse;
    border-spacing: 0;
    line-height: 1.45;
  }

  th,
  td {
    min-width: 120px;
    padding: 9px 11px;
    border-bottom: 1px solid var(--border-hairline);
    vertical-align: top;
    text-align: left;
  }

  th {
    color: var(--color-text-heading);
    border-bottom: 2px solid var(--border-bubble);
    font-weight: 500;
  }

  td {
    color: var(--color-text-primary);
  }

  th:last-child,
  td:last-child {
    border-right: 0;
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  td > :last-child,
  th > :last-child {
    margin-bottom: 0;
  }
}