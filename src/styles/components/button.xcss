button {
  border: 0;
  border-radius: 9999px;
  padding: 4px 10px;

  svg {
    display: inline-block;
    margin: 0 4px;
  }
}

.icon-button,
.round-button,
.recent-filter-button,
.user-copy-float,
.favorite-button,
.sidebar-toggle,
.attachment-chip button {
  border-radius: 9999px;
  padding: 0;
}

.icon-button,
.round-button {
  display: inline-grid;
  place-items: center;
  color: --text-2;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 999px;
}

.icon-button {
  width: 34px;
  height: 34px;

  &.tiny {
    width: 26px;
    height: 26px;
    background: transparent;
    border: 0;
  }
}

.icon-button:hover,
.round-button:hover,
.model-pill:hover,
.message-actions button:hover,
.continuations button:hover {
  background: --item-hover;
}

.primary-mini {
  color: --text-5 !important;
  background: --background-5 !important;
}