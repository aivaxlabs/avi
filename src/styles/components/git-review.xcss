.git-review-panel {
  height: 100%;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  color: var(--text-2);
  font-size: var(--font-sm);
  container-type: inline-size;

  button,
  select,
  textarea {
    font: inherit;
  }

  button:disabled {
    opacity: .45;
    cursor: default;
  }

  button:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--primary-color);
    outline-offset: -2px;
  }

  > .git-review-topbar {
    display: flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 5px 9px;
    border-bottom: 1px solid var(--border-color);
    background: var(--background-1);

    > select {
      min-width: 0;
      flex: 1;
      padding: 4px;
      color: var(--text-1);
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 4px;
    }

    > .git-review-branch {
      max-width: 150px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--text-3);
      font-size: var(--font-xs);
    }
  }

  > .git-review-workspace {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: grid;
    grid-template-columns: minmax(170px, 29%) minmax(0, 1fr);

    > .git-review-navigation {
      min-height: 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      border-right: 1px solid var(--border-color);
      background: var(--background-1);

      > .git-review-commit {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        min-width: 0;
        gap: 6px;
        padding: 10px;
        border-bottom: 1px solid var(--border-color);

        > label {
          font-size: var(--font-xs);
          color: var(--text-3);
        }

        > div {
          display: flex;
          min-width: 0;
          gap: 4px;
          align-items: flex-start;
        }

        textarea {
          flex: 1;
          min-width: 0;
          resize: vertical;
          min-height: 45px;
          max-height: 150px;
          color: var(--text-1);
          background: var(--background-2);
          border: 1px solid var(--border-color);
          border-radius: 4px;
          padding: 6px;
        }

        > .git-review-commit-actions {
          flex-wrap: wrap;

          > button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            flex: 1 1 110px;
            min-width: 0;
            max-width: 100%;
            min-height: 28px;
            padding: 3px 6px;
            border-radius: 4px;
            border: 1px solid var(--border-color);
            color: var(--text-1);
            background: var(--background-2);
            white-space: normal;

            &:hover:not(:disabled) {
              background: var(--item-hover);
            }
          }
        }

        > small {
          color: var(--text-3);
          font-size: var(--font-xs);
        }
      }

      > .git-review-tree {
        min-height: 0;
        flex: 1;
        overflow: auto;
        overscroll-behavior: contain;

        .git-review-tree-row {
          position: absolute;
          left: 0;
          right: 0;
          height: 28px;
          display: flex;
          align-items: center;
          gap: 5px;
          padding-right: 5px;
          cursor: pointer;
          user-select: none;

          &:hover {
            background: var(--item-hover);
          }

          &.selected {
            background: var(--item-active);
            color: var(--text-1);
          }

          &:focus-visible {
            outline: 1px solid var(--primary-color);
            outline-offset: -1px;
          }

          > svg {
            flex: none;
            color: var(--text-3);
          }

          > .git-review-tree-name {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
          }

          > .git-review-file-status {
            font-size: var(--font-xs);
            font-weight: 600;
          }

          > .git-review-staged {
            font-size: 8px;
            color: var(--success-color);
          }

          > .git-review-tree-action {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: none;
            width: 19px;
            height: 22px;
            padding: 0;
            color: var(--text-2);
            background: transparent;
            border: 0;
            opacity: 0;

            &:hover {
              color: var(--text-1);
              background: var(--item-active);
            }
          }

          &:hover,
          &:focus-within {
            > .git-review-tree-action {
              opacity: 1;
            }
          }
        }
      }
    }

    > .git-review-detail {
      min-width: 0;
      min-height: 0;
      display: flex;
      flex-direction: column;

      > .git-review-file-header {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 36px;
        padding: 5px 10px;
        border-bottom: 1px solid var(--border-color);

        > strong {
          flex: 1;
          min-width: 0;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
          font-weight: 500;
        }

        > select {
          max-width: 120px;
          color: var(--text-2);
          background: var(--background-1);
          border: 1px solid var(--border-color);
          border-radius: 4px;
          padding: 3px;
        }
      }
    }
  }
}

.git-diff-viewer {
  display: flex;
  flex: 1;
  min-height: 0;
  min-width: 0;
  position: relative;

  > .git-diff-scroll {
    min-width: 0;
    min-height: 0;
    flex: 1;
    overflow: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;

    &:focus-visible {
      outline: 1px solid var(--primary-color);
      outline-offset: -1px;
    }

    > .git-diff-lines {
      min-width: 100%;
      width: max-content;
      font-family: var(--font-code);
      font-size: var(--font-sm);
      line-height: 22px;

      > .git-diff-line {
        display: flex;
        height: 22px;
        min-width: 100%;

        &.added {
          background: color-mix(in srgb, var(--success-color) 14%, transparent);
        }

        &.deleted {
          background: color-mix(in srgb, var(--danger-color) 14%, transparent);
        }

        > .git-diff-number {
          width: 48px;
          flex: none;
          text-align: right;
          padding-right: 8px;
          color: var(--text-3);
          user-select: none;
        }

        > .git-diff-sign {
          width: 18px;
          flex: none;
          text-align: center;
          color: var(--text-3);
          user-select: none;
        }

        > code {
          display: block;
          white-space: pre;
          padding-right: 22px;
          tab-size: 4;
          font: inherit;
          color: var(--text-1);
        }
      }

      > .git-diff-gap {
        height: 28px;
        display: flex;
        align-items: center;
        gap: 5px;
        padding-left: 70px;
        background: var(--background-2);
        border-block: 1px solid var(--border-color);
        user-select: none;

        > button {
          display: inline-flex;
          align-items: center;
          height: 24px;
          padding: 0 5px;
          color: var(--text-3);
          background: transparent;
          border: 0;
          font-family: var(--font-ui);
          font-size: var(--font-xs);

          &:hover {
            color: var(--text-1);
            background: var(--item-hover);
          }
        }
      }
    }
  }

  > .git-diff-map {
    position: relative;
    flex: none;
    width: 18px;
    border-left: 1px solid var(--border-color);
    background: var(--background-1);

    > button {
      position: absolute;
      left: 2px;
      right: 2px;
      min-height: 3px;
      padding: 0;
      border: 0;
      border-radius: 1px;
      opacity: .6;

      &.added {
        background: var(--success-color);
      }

      &.deleted {
        background: var(--danger-color);
      }

      &:hover,
      &:focus-visible {
        opacity: 1;
        outline: 1px solid var(--text-1);
      }
    }

    > .git-diff-map-thumb {
      position: absolute;
      left: 0;
      right: 0;
      pointer-events: none;
      background: color-mix(in srgb, var(--text-2) 16%, transparent);
      border-block: 1px solid color-mix(in srgb, var(--text-2) 35%, transparent);
    }
  }
}

::highlight(git-review-selection) {
  background-color: color-mix(in srgb, var(--primary-color) 30%, transparent);
}

.git-review-empty {
  min-width: 0;
  padding: 28px 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  text-align: center;
  color: var(--text-3);

  > strong {
    font-weight: 500;
    color: var(--text-2);
  }
}

.git-review-notice {
  display: flex;
  align-items: center;
  flex: none;
  gap: 7px;
  padding: 7px 10px;
  border-bottom: 1px solid var(--border-color);
  background: var(--background-2);

  > span {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  > svg {
    flex: none;
  }

  > button {
    background: transparent;
    border: 0;
    color: inherit;
    padding: 3px;
  }

  &.error {
    color: var(--danger-color);
  }
}

.git-review-menu {
  width: 235px;
  max-height: calc(100vh - 16px);
  overflow-y: auto;
}

.git-review-menu .danger,
.git-review-dialog .danger {
  color: var(--danger-color);
}

.git-review-annotation {
  position: fixed;
  z-index: 125;
  width: min(340px, calc(100vw - 16px));
  padding: 8px;
  display: grid;
  gap: 8px;
  color: --text-1;
  background: --background-1;
  border: 1px solid --border-color;
  border-radius: 14px;
  box-shadow: 0 8px 28px #0000001f;
  transform-origin: top center;
  animation: dropdown-menu-in var(--duration-fast) var(--ease-smooth-out);

  &[data-closing] {
    animation: dropdown-menu-out var(--duration-quick) var(--ease-smooth-out) forwards;
  }

  > blockquote {
    margin: 0;
    padding: 2px 0 2px 10px;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    color: --text-3;
    font-size: var(--font-sm);
    line-height: 1.45;
    border-left: 2px solid --primary-color;
  }

  > textarea {
    width: 100%;
    min-height: 72px;
    max-height: 220px;
    resize: vertical;
    padding: 8px 10px;
    font: inherit;
    line-height: 1.45;
    color: --text-1;
    background: --background-2;
    border: 1px solid --border-color;
    border-radius: 10px;
    outline: 3px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-smooth-out),
      outline-color var(--duration-fast) var(--ease-smooth-out);

    &::placeholder {
      color: --text-4;
    }

    &:focus {
      background: --background-0;
      border-color: --primary-color;
      outline-color: --primary-color-opaque;
    }
  }

  > footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;

    > small {
      margin-right: auto;
      padding-left: 2px;
      color: --text-4;
      font-size: var(--font-xs);
    }

    > button {
      padding: 4px 12px;
      font: inherit;
      color: --text-2;
      background: --background-3;
      border: 0;
      border-radius: 9999px;
      cursor: pointer;
      transition: background var(--duration-fast) var(--ease-smooth-out),
        opacity var(--duration-fast) var(--ease-smooth-out),
        transform var(--duration-fast) var(--ease-smooth-out);

      &:hover:not(:disabled) {
        background: --item-active;
      }

      &:active:not(:disabled) {
        transform: scale(var(--scale-medium));
      }

      &:focus-visible {
        outline: 2px solid --text-3;
        outline-offset: 2px;
      }

      &:disabled {
        opacity: .5;
        cursor: default;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    &,
    &[data-closing] {
      animation: none;
    }

    > textarea,
    > footer > button {
      transition: none;
    }
  }
}

.git-review-dialog {
  width: min(640px, calc(100vw - 32px));
  max-height: calc(100vh - 48px);
  padding: 0;
  color: var(--text-1);
  background: var(--background-1);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  animation: dialog-surface-in var(--duration-fast) var(--ease-smooth-out);

  &::backdrop {
    background: #0006;
    animation: dialog-backdrop-in var(--duration-fast) var(--ease-smooth-out);
  }

  &[data-closing] {
    animation: dialog-surface-out var(--duration-quick) var(--ease-smooth-out) forwards;

    &::backdrop {
      animation: dialog-backdrop-out var(--duration-quick) var(--ease-smooth-out) forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    &,
    &::backdrop,
    &[data-closing],
    &[data-closing]::backdrop {
      animation: none;
    }
  }

  > .git-review-dialog-body {
    padding: 12px 18px;
    max-height: 55vh;
    overflow: auto;
    overflow-wrap: anywhere;
    font-size: var(--font-sm);
  }

  > .dialog-footer {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 12px 18px;

    > button {
      padding: 6px 10px;
      background: var(--background-2);
      border: 1px solid var(--border-color);
      border-radius: 5px;
      font: inherit;
      color: var(--text-1);
    }

    > .danger {
      color: var(--danger-color);
    }
  }
}

.status-added,
.status-untracked {
  color: var(--success-color);
}

.status-deleted,
.status-conflict {
  color: var(--danger-color);
}

.status-modified,
.status-renamed {
  color: var(--warn-color);
}

@container (max-width: 480px) {
  .git-review-panel > .git-review-workspace {
    grid-template-columns: minmax(120px, 40%) minmax(0, 1fr);
  }

  .git-review-branch {
    display: none;
  }

  .git-diff-viewer > .git-diff-scroll > .git-diff-lines > .git-diff-line > .git-diff-number {
    width: 34px;
  }
}