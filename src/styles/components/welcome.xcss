.welcome-dialog {
  width: min(560px, 100%);
  max-height: 100%;
  display: grid;
  grid-template-rows: auto minmax(0, 1fr) auto;
  overflow: hidden;
  color: --text-1;
  background: --background-2;
  border: 1px solid --border-color;
  border-radius: 14px;
  box-shadow: 0 28px 90px rgb(0 0 0 / 30%);

  > .welcome-dialog-image {
    width: 100%;
    height: 260px;
    object-fit: cover;
    animation: welcome-dialog-image-in var(--duration-medium) var(--ease-smooth-out);

    @media (max-height: 620px) {
      height: 160px;
    }
  }

  > .welcome-dialog-body {
    min-height: 148px;
    padding: 20px 24px 8px;
    overflow-y: auto;

    > h2 {
      margin: 0;
      font-size: var(--font-xxl);
      font-weight: 500;
      line-height: 1.25;
    }

    > p {
      margin: 8px 0 0;
      color: --text-3;
      line-height: 1.5;
      text-wrap: pretty;
    }

    > .welcome-dialog-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 16px;

      > .welcome-dialog-connected {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: --text-2;
      }

      > .welcome-dialog-error {
        flex-basis: 100%;
        margin: 0;
        color: --danger-color;
        font-size: var(--font-sm);
      }
    }
  }

  > .welcome-dialog-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 0;
    padding: 12px 24px 20px;

    > .welcome-dialog-progress {
      margin-right: auto;
      color: --text-4;
      font-size: var(--font-sm);
    }
  }

  @media (max-width: 700px) {
    border: none;
    border-radius: 0;
  }
}

@keyframes welcome-dialog-image-in {
  from {
    opacity: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .welcome-dialog > .welcome-dialog-image {
    animation: none;
  }
}
