.messages-column {
  width: 100%;
  max-width: 820px;
  min-width: 0;
  margin: 0 auto;
  display: grid;
  gap: 22px;
  padding-bottom: 8px;
}

.message-row {
  min-width: 0;
  display: flex;
}

.user-row {
  position: relative;
  justify-content: flex-end;
  align-items: start;
  gap: 8px;
  padding-right: 30px;
}

.user-bubble {
  max-width: min(620px, 78%);
  color: var(--color-text-strong);
  background: var(--surface-user-bubble);
  border: 1px solid var(--border-bubble);
  border-radius: 16px 16px 3px 16px;
  padding: 8px 16px;

  .attachment-list {
    margin: 5px 0 0 0;
  }
}

.plain-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 14px;
  line-height: 1.55;
}

.assistant-row {
  justify-content: flex-start;

  + .assistant-row {
    border-top: 2px solid var(--color-divider-subtle);
    padding-top: 1em;
  }
}

.context-compression-row {
  align-items: center;
  gap: 8px;
}

.context-compression-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--color-muted-strong);
  font-size: 12px;

  &::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--color-divider-subtle);
  }
}

.assistant-message {
  width: min(760px, 100%);
  min-width: 0;
  color: var(--color-text);
}

.assistant-timeline {
  min-width: 0;
  display: grid;
  gap: 8px;
}

.assistant-placeholder {
  width: fit-content;
  color: transparent;
  -webkit-text-fill-color: transparent;
  background: var(--color-text-strong) -webkit-gradient(linear,
      100% 0,
      0 0,
      from(var(--color-text-strong)),
      color-stop(0.5, var(--color-muted-light)),
      to(var(--color-text-strong)));
  background-repeat: no-repeat;
  background-size: 50% 200%;
  background-clip: text;
  -webkit-background-clip: text;
  animation: thinking-gradient 2s linear infinite;
  font-size: 14px;
  font-weight: 400;
}

.assistant-timeline + .assistant-placeholder {
  margin-top: 8px;
}

@keyframes thinking-gradient {
  0% {
    background-position: -100% 0;
  }

  100% {
    background-position: 250% 0;
  }
}

.message-actions {
  display: flex;
  gap: 4px;
}

.message-footer {
  min-height: 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 6px;
}

.message-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--color-icon);
  background: transparent;
}

.assistant-actions {
  opacity: 0;
  transition: opacity .2s var(--base-transition);

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  &.has-try-again {
    opacity: 1;
  }

  button {
    width: 28px;
    height: 28px;
    padding: 4px;
    opacity: .4;
    transition: color .2s var(--base-transition),
      background .2s var(--base-transition),
      opacity .2s var(--base-transition),
      transform .2s var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }
}

.assistant-message:hover .assistant-actions,
.assistant-message:focus-within .assistant-actions,
.assistant-actions button:hover,
.assistant-actions button:focus-visible {
  opacity: 1;
}

.assistant-actions button:active {
  transform: scale(.94);
}

.assistant-actions .try-again-action {
  width: auto;
  padding: 4px 9px;
  gap: 5px;
  border: 1px solid var(--border-control);
  opacity: .72;
  font-size: 12px;

  &:hover,
  &:focus-visible {
    opacity: 1;
  }

  &:disabled {
    opacity: .45;
    cursor: wait;
  }
}

.assistant-actions button:focus-visible {
  outline: 2px solid var(--border-accent);
  outline-offset: 2px;
}

.message-info {
  position: relative;
}

.message-usage-popover {
  position: absolute;
  z-index: 30;
  left: 0;
  bottom: calc(100% + 7px);
  width: 230px;
  padding: 8px 10px;
  color: var(--color-text);
  background: var(--surface-popover);
  border: 1px solid var(--color-divider);
  border-radius: 10px;
  box-shadow: 0 10px 28px var(--shadow-popover);
  backdrop-filter: blur(18px);

  dl {
    display: grid;
    gap: 2px;
    margin: 0;

    > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      padding: 4px 0;
    }
  }

  dt {
    color: var(--color-muted-strong);
  }

  dd {
    margin: 0;
    color: var(--color-text-strong);
    font-variant-numeric: tabular-nums;
  }
}

.message-meta {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
  overflow: hidden;
  color: var(--color-muted);
  font-size: 11px;
  opacity: 0;
  pointer-events: none;
  transform: translateY(2px);
  transition: opacity .2s var(--base-transition),
    transform .2s var(--base-transition);

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

.assistant-message:hover .message-meta,
.assistant-message:focus-within .message-meta {
  opacity: 1;
  transform: translateY(0);
}

.user-copy-float {
  position: absolute;
  right: 2px;
  top: 18px;
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  padding: 0;
  color: var(--color-muted-strong);
  background: transparent;
  border: 0;
  opacity: 0;
  pointer-events: none;
  transform: translateX(-2px);
}

.user-row:hover .user-copy-float,
.user-row:focus-within .user-copy-float,
.user-copy-float:hover {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(0);
}

.continuations {
  margin-top: 10px;
  display: grid;
  justify-items: start;
  gap: 5px;
  opacity: .6;
  transition: .3s var(--base-transition);

  &:hover {
    opacity: 1;
  }

  button {
    padding: 4px 12px;
    color: var(--color-text-continuation);
    background: transparent;
    border: 1px solid var(--border-subtle-button);
    border-radius: 16px;
    font-size: 12px;
    text-align: left;
    transition: .3s var(--base-transition);

    &:hover {
      background: var(--surface-subtle-hover);
    }
  }
}