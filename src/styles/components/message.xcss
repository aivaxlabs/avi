.messages-column {
  width: 100%;
  max-width: 820px;
  min-width: 0;
  margin: 0 auto;
  display: grid;
  gap: 22px;
  padding-bottom: 8px;
}

.message-row {
  min-width: 0;
  display: flex;
}

.user-row {
  position: relative;
  justify-content: flex-end;
  align-items: start;
  gap: 8px;
  padding-right: 0;
  transition: .3s --base-transition;

  & :hover {
    padding-right: 30px;
  }
}

.user-message-content {
  max-width: min(620px, 78%);
  min-width: 0;
  display: grid;
  justify-items: end;
  gap: 8px;
}

.user-bubble {
  max-width: 100%;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 16px 16px 3px 16px;
  padding: 8px 16px;
}

.user-attachment-list {
  justify-content: flex-end;
  max-width: 100%;
  margin: 0;
}

.user-attachment-image {
  width: 72px;
  height: 72px;
  overflow: hidden;
  padding: 0;
  background: var(--background-2);
  border-radius: 10px;
  cursor: pointer;
  transition: border-color 160ms var(--base-transition),
    transform 160ms var(--base-transition);

  img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  &:hover,
  &:focus-visible {
    border-color: var(--text-3);
  }

  &:active {
    transform: scale(.96);
  }

  &:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: 2px;
  }
}

.attachment-lightbox {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 48px;
  background: rgb(0 0 0 / 82%);
  backdrop-filter: blur(8px);

  > img {
    width: auto;
    height: auto;
    max-width: calc(100vw - 96px);
    max-height: calc(100vh - 96px);
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 70px rgb(0 0 0 / 45%);
  }

  > button {
    position: absolute;
    top: 18px;
    right: 66px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    padding: 0 0 2px;
    color: #fff;
    background: rgb(255 255 255 / 12%);
    border: 1px solid rgb(255 255 255 / 20%);
    border-radius: 999px;
    font-size: 26px;
    line-height: 1;

    &:hover,
    &:focus-visible {
      background: rgb(255 255 255 / 20%);
    }

    &:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 2px;
    }
  }
}

@media (max-width: 560px) {
  .user-message-content {
    max-width: 90%;
  }

  .attachment-lightbox {
    padding: 56px 16px 16px;

    > img {
      max-width: calc(100vw - 32px);
      max-height: calc(100vh - 72px);
    }
  }
}

@media (prefers-reduced-motion: reduce) {
  .user-attachment-image {
    transition: none;
  }
}

.plain-text {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  font-size: 14px;
  line-height: 1.55;
}

.subagent-report-row {
  justify-content: flex-start;
}

.subagent-report-card {
  width: min(760px, 100%);
  min-width: 0;
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 14px;
}

.cross-thread-message-card .subagent-report-icon {
  background: var(--background-3);
}

.subagent-report-header {
  min-width: 0;
  display: grid;
  grid-template-columns: 28px minmax(0, 1fr) auto 28px;
  align-items: center;
  gap: 9px;
  padding: 8px 10px;
  background: var(--background-3);
  border-bottom: 1px solid var(--border-color);

  > code {
    max-width: 96px;
    overflow: hidden;
    color: var(--text-3);
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
  }

  > button {
    width: 28px;
    height: 28px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--text-3);
    background: transparent;
    border-radius: 7px;
    transition: color 180ms var(--base-transition),
      background 180ms var(--base-transition),
      transform 180ms var(--base-transition);

    &:hover,
    &:focus-visible {
      color: var(--text-1);
      background: var(--item-hover);
    }

    &:active {
      transform: scale(.94);
    }

    &:focus-visible {
      outline: 2px solid var(--text-3);
      outline-offset: -2px;
    }
  }
}

.subagent-report-icon {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  color: var(--text-2);
  background: var(--background-3);
  border-radius: 8px;
}

.subagent-report-heading {
  min-width: 0;
  display: grid;
  gap: 1px;

  small,
  strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  small {
    color: var(--text-3);
    font-size: 10px;
  }

  strong {
    color: var(--text-1);
    font-size: 12px;
    font-weight: 500;
  }
}

.subagent-report-body {
  min-width: 0;
  max-height: 400px;
  overflow-y: auto;
  padding: 14px 16px 16px;

  .markdown-body table {
    max-width: 100%;
    display: block;
    overflow-x: auto;
  }
}

.assistant-row {
  justify-content: flex-start;

  + .assistant-row {
    border-top: 2px solid var(--border-color);
    padding-top: 1em;
  }
}

.context-compression-row {
  align-items: center;
  gap: 8px;
}

.context-compression-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--text-3);
  font-size: 12px;

  &::before {
    content: '';
    width: 18px;
    height: 1px;
    background: var(--background-3);
  }
}

.assistant-message {
  width: min(760px, 100%);
  min-width: 0;
  color: var(--text-1);

  .user-attachment-list {
    justify-content: flex-start;
    max-width: 100%;
    margin: 0;
    margin-block: 1em .5em;

    .user-attachment-image {
      width: 128px;
      height: 128px;
    }
  }
}

.question-inline-row {
  width: 100%;
}

.question-card {
  width: min(760px, 100%);
  min-width: 0;
  overflow: hidden;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 14px;
}

.question-card-header {
  display: grid;
  gap: 8px;
  padding: 16px 18px 14px;
  border-bottom: 1px solid var(--border-color);
}

.question-card-progress {
  color: var(--text-3);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.question-card-prompt {
  min-width: 0;
  color: var(--text-1);
  font-size: 14px;
  font-weight: 500;
  line-height: 1.55;
  overflow-wrap: anywhere;

  > :first-child {
    margin-top: 0;
  }

  > :last-child {
    margin-bottom: 0;
  }

  p {
    margin: 0 0 8px;
  }

  ol,
  ul {
    display: grid;
    gap: 5px;
    margin: 7px 0 0;
    padding-left: 20px;
    color: var(--text-1);
    font-size: 13px;
    font-weight: 400;
  }

  ol {
    list-style: decimal;
  }

  ul {
    list-style: disc;
  }

  code {
    padding: 1px 4px;
    background: var(--background-3);
    border-radius: 4px;
    font-size: .9em;
  }
}

.question-card-field {
  min-width: 0;
  margin: 0;
  padding: 14px 18px 16px;
  border: 0;
}

.question-card-field legend {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.question-card-field textarea {
  width: 100%;
  min-height: 94px;
  resize: vertical;
  padding: 10px 11px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 9px;
  font: inherit;
  font-size: 13px;
  line-height: 1.5;
  transition: border-color 160ms var(--base-transition),
    box-shadow 160ms var(--base-transition);

  &::placeholder {
    color: var(--text-3);
  }

  &:focus-visible {
    border-color: var(--text-3);
    outline: 0;
    box-shadow: 0 0 0 3px var(--background-3);
  }

  &:disabled {
    opacity: .55;
    cursor: wait;
  }
}

.question-card-options {
  display: grid;
  gap: 7px;
}

.question-card-option {
  min-width: 0;
  display: grid;
  grid-template-columns: 16px minmax(0, 1fr);
  align-items: start;
  gap: 9px;
  padding: 9px 11px;
  color: var(--text-1);
  background: var(--background-3);
  border: 1px solid var(--border-color);
  border-radius: 9px;
  cursor: pointer;
  transition: background 160ms var(--base-transition),
    border-color 160ms var(--base-transition),
    transform 160ms var(--base-transition);

  &:hover {
    background: var(--item-hover);
    border-color: var(--border-color);
  }

  &:active {
    transform: scale(.995);
  }

  &:focus-within {
    border-color: var(--text-3);
    outline: 0;
    box-shadow: 0 0 0 3px var(--background-3);
  }

  &:has(input:checked) {
    background: var(--background-3);
    border-color: var(--text-3);
  }

  input {
    width: 14px;
    height: 14px;
    margin: 2px 0 0;
    accent-color: var(--background-5);
  }
}

.question-card-option-copy {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: 12px;
  line-height: 1.45;

  > :first-child {
    margin-top: 0;
  }

  > :last-child {
    margin-bottom: 0;
  }

  p {
    margin: 0;
  }

  code {
    font-size: .92em;
  }
}

.question-card-footer {
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(64px, 1fr) auto minmax(190px, 1fr);
  align-items: center;
  gap: 10px;
  padding: 11px 14px;
  background: var(--background-3);
  border-top: 1px solid var(--border-color);
}

.question-card-footer button {
  min-height: 30px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 5px 9px;
  color: var(--text-2);
  background: transparent;
  border: 1px solid transparent;
  border-radius: 7px;
  font-size: 12px;
  transition: color 160ms var(--base-transition),
    background 160ms var(--base-transition),
    border-color 160ms var(--base-transition),
    transform 160ms var(--base-transition);

  &:hover:not(:disabled) {
    color: var(--text-1);
    background: var(--item-hover);
  }

  &:active:not(:disabled) {
    transform: scale(.97);
  }

  &:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: 2px;
  }

  &:disabled {
    opacity: .4;
    cursor: not-allowed;
  }
}

.question-card-cancel {
  justify-self: start;
}

.question-card-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.question-card-pagination button {
  position: relative;
  width: 28px;
  min-height: 28px;
  padding: 0;
  color: var(--text-3);
  border-color: var(--border-color);
  font-variant-numeric: tabular-nums;

  &.answered::after {
    content: '';
    position: absolute;
    right: 3px;
    bottom: 3px;
    width: 4px;
    height: 4px;
    background: var(--background-5);
    border-radius: 50%;
  }

  &.active {
    color: var(--text-5);
    background: var(--background-5);
    border-color: var(--background-5);
  }

  &.active.answered::after {
    background: currentcolor;
  }
}

.question-card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 6px;
}

.question-card-footer .primary-mini {
  color: var(--text-5);
  background: var(--background-5);
  border-color: var(--background-5);

  &:hover:not(:disabled) {
    color: var(--text-5);
    background: var(--background-5);
    border-color: var(--background-5);
  }
}

@media (max-width: 620px) {

  .question-card-header,
  .question-card-field {
    padding-inline: 14px;
  }

  .question-card-footer {
    grid-template-columns: auto 1fr;
  }

  .question-card-pagination {
    grid-row: 1;
    grid-column: 2;
    justify-content: flex-end;
  }

  .question-card-actions {
    grid-row: 2;
    grid-column: 1 / -1;
  }
}

@media (prefers-reduced-motion: reduce) {

  .question-card-field textarea,
  .question-card-option,
  .question-card-footer button {
    transition: none;
  }
}

.assistant-timeline {
  min-width: 0;
  display: grid;
  gap: 8px;
}

.execution-plan {
  min-width: 0;
  margin: 4px 0;
  overflow: hidden;
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 12px;
}

.execution-plan-label {
  min-height: 33px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 8px 6px 12px;
  color: var(--text-3);
  background: var(--background-3);
  border-bottom: 1px solid var(--border-color);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;

  button {
    width: 24px;
    height: 20px;
    display: grid;
    place-items: center;
    color: var(--text-3);
    border-radius: 5px;
    opacity: .58;
    transition: background 140ms var(--base-transition),
      color 140ms var(--base-transition),
      opacity 140ms var(--base-transition);

    &:hover,
    &:focus-visible {
      color: var(--text-1);
      background: var(--background-4);
      opacity: 1;
    }
  }
}

.execution-plan-content {
  max-height: min(560px, 60vh);
  padding: 14px 16px 4px;
  overflow-y: auto;

  table {
    max-width: 100%;
    display: block;
    overflow-x: auto;
  }
}

.implement-plan-button {
  min-height: 34px;
  margin: 8px 16px 14px;
  padding: 7px 12px;
  color: var(--text-5);
  background: var(--background-5);
  border-radius: 8px;
  font-size: 12px;
  font-weight: 500;
  transition: background 180ms var(--base-transition),
    opacity 180ms var(--base-transition),
    transform 180ms var(--base-transition);

  &:hover {
    background: var(--background-5);
  }

  &:active {
    transform: scale(.98);
  }

  &:focus-visible {
    outline: 2px solid var(--text-3);
    outline-offset: 2px;
  }

  &:disabled {
    opacity: .5;
    cursor: wait;
  }
}

.assistant-placeholder {
  width: fit-content;
  color: transparent;
  -webkit-text-fill-color: transparent;
  background: var(--text-1) -webkit-gradient(linear,
      100% 0,
      0 0,
      from(var(--text-1)),
      color-stop(0.5, var(--text-4)),
      to(var(--text-1)));
  background-repeat: no-repeat;
  background-size: 50% 200%;
  background-clip: text;
  -webkit-background-clip: text;
  animation: thinking-gradient 2s linear infinite;
  font-size: 14px;
  font-weight: 400;
}


.assistant-timeline + .assistant-placeholder {
  margin-top: 8px;
}

.edit-summary {
  margin-top: 12px;
  overflow: hidden;
  color: var(--text-3);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 12px;
}

.edit-summary-header {
  min-height: 48px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;

  strong {
    color: var(--text-4);
    font-size: 13px;
    font-weight: 600;
  }
}

.edit-summary-icon {
  width: 32px;
  height: 32px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  background: var(--background-3);
  border-radius: 8px;
}

.edit-summary-undo {
  min-height: 30px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-left: auto;
  padding: 5px 8px;
  color: var(--text-4);
  background: transparent;
  border-radius: 7px;

  &:hover,
  &:focus-visible {
    background: var(--background-3);
  }
}

.edit-summary-files {
  border-top: 1px solid var(--border-color);

  > button {
    width: 100%;
    min-height: 38px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px;
    color: var(--text-3);
    background: transparent;
    border-radius: 0;
    border-bottom: 1px solid var(--border-color);
    text-align: left;

    &:last-child {
      border-bottom: 0;
    }

    &:hover,
    &:focus-visible {
      color: var(--text-4);
      background: var(--background-3);
    }

    > span:first-child {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
}

.edit-summary-stats {
  flex: 0 0 auto;
  margin-left: auto;
  font-family: var(--font-mono);
  font-size: 11px;

  ins {
    color: var(--success-color);
    text-decoration: none;
  }

  del {
    color: var(--danger-color);
    text-decoration: none;
  }
}

.edit-summary-more {
  width: 100%;
  min-height: 34px;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 7px 12px;
  color: var(--text-3);
  background: transparent;
  font-size: 12px;

  &:hover,
  &:focus-visible {
    color: var(--text-4);
    background: var(--background-3);
  }

  svg {
    transition: transform .18s var(--base-transition);

    &.is-open {
      transform: rotate(180deg);
    }
  }
}

@keyframes thinking-gradient {
  0% {
    background-position: -100% 0;
  }

  100% {
    background-position: 250% 0;
  }
}

.message-actions {
  display: flex;
  gap: 4px;
}

.message-footer {
  min-height: 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 6px;
}

.message-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--text-2);
  background: transparent;
}

.assistant-actions {
  opacity: .6;
  transition: opacity .2s var(--base-transition);

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  &.has-try-again {
    opacity: 1;
  }

  button {
    width: 28px;
    height: 28px;
    padding: 4px;
    opacity: .4;
    transition: color .2s var(--base-transition),
      background .2s var(--base-transition),
      opacity .2s var(--base-transition),
      transform .2s var(--base-transition);

    @media (prefers-reduced-motion: reduce) {
      transition: none;
    }
  }
}

.assistant-message:hover .assistant-actions,
.assistant-message:focus-within .assistant-actions,
.assistant-actions button:hover,
.assistant-actions button:focus-visible {
  opacity: 1;
}

.assistant-actions button:active {
  transform: scale(.94);
}

.assistant-actions .try-again-action {
  width: auto;
  padding: 4px 9px;
  gap: 5px;
  border: 1px solid var(--border-color);
  opacity: .72;
  font-size: 12px;

  &:hover,
  &:focus-visible {
    opacity: 1;
  }

  &:disabled {
    opacity: .45;
    cursor: wait;
  }
}

.assistant-actions button:focus-visible {
  outline: 2px solid var(--text-3);
  outline-offset: 2px;
}

.message-info {
  position: relative;
}

.message-usage-popover {
  position: absolute;
  z-index: 30;
  left: 0;
  bottom: calc(100% + 7px);
  width: 230px;
  padding: 8px 10px;
  color: var(--text-1);
  background: var(--background-2);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: 0 6px 18px #00000011;
  backdrop-filter: blur(18px);

  dl {
    display: grid;
    gap: 2px;
    font-size: .9rem;
    margin: 0;

    > div {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 14px;
      padding: 4px 0;
    }
  }

  dt {
    color: var(--text-3);
  }

  dd {
    margin: 0;
    color: var(--text-1);
    font-variant-numeric: tabular-nums;
  }
}

.message-meta {
  flex: 0 1 240px;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  overflow: hidden;
  color: var(--text-3);
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  opacity: 0;
  pointer-events: none;
  transform: translateY(2px);
  transition: opacity .2s var(--base-transition),
    transform .2s var(--base-transition);

  @media (prefers-reduced-motion: reduce) {
    transition: none;
  }

  > span:first-child {
    flex: 0 0 auto;
  }

  .message-meta-model {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

.assistant-message:hover .message-meta,
.assistant-message:focus-within .message-meta {
  opacity: 1;
  pointer-events: auto;
  transform: translateY(0);
}

.user-copy-float {
  position: absolute;
  right: 2px;
  top: 18px;
  width: 22px;
  height: 22px;
  display: grid;
  place-items: center;
  padding: 0;
  color: var(--text-3);
  background: transparent;
  border: 0;
  opacity: 0;
  pointer-events: none;
  transition: .3s --base-transition;
  transform: translateX(-2px);
}

@media (prefers-reduced-motion: reduce) {
  .subagent-report-header > button {
    transition: none;
  }
}

.user-row:hover .user-copy-float,
.user-row:focus-within .user-copy-float,
.user-copy-float:hover {
  opacity: 1;
  pointer-events: auto;
  transform: translateX(0);
}

.continuations {
  margin-top: 10px;
  display: grid;
  justify-items: start;
  gap: 5px;
  opacity: .6;
  transition: .3s var(--base-transition);

  &:hover {
    opacity: 1;
  }

  button {
    padding: 4px 12px;
    color: var(--text-2);
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    font-size: 12px;
    text-align: left;
    transition: .3s var(--base-transition);

    &:hover {
      background: var(--background-2);
    }
  }
}