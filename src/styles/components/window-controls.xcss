.window-controls {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 34px;
  display: flex;
  justify-content: flex-end;
  z-index: 50;
  pointer-events: none;
  -webkit-app-region: no-drag;
  background: linear-gradient(to bottom, var(--surface-titlebar), var(--surface-clear));

  button {
    width: 42px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0;
    color: var(--color-control);
    background: transparent;
    border-radius: 0;
    pointer-events: auto;
    -webkit-app-region: no-drag;
    cursor: default;

    &:hover {
      background: var(--surface-code-inline);
    }
  }

  .danger:hover {
    color: var(--color-on-accent);
    background: var(--color-danger-hover);
  }
}

.window-drag {
  flex: 1;
  pointer-events: auto;
  -webkit-app-region: drag;

  .button {
    cursor: default;
  }

  @media (max-width: 860px) {
    margin-left: 200px;
  }
}

.mac-drag {
  position: fixed;
  inset: 0 0 auto 0;
  height: 34px;
  z-index: 50;
}
