{
  "manifest_version": 3,
  "minimum_chrome_version": "125",
  "name": "Avi Chrome Integration",
  "version": "0.3.0",
  "description": "Connect real Chrome tabs to the Chrome Integration built-in plugin in Avi.",
  "permissions": [
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "contentSettings",
    "debugger",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}
